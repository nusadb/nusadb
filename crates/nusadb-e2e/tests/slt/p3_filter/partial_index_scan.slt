# a WHERE that repeats only some of the predicate's conditions keeps rows the index does not hold,
# so the ordered read through it is not taken

statement ok
CREATE TABLE cqs (id INT NOT NULL, status TEXT, prio INT, due INT NOT NULL)

statement ok
INSERT INTO cqs SELECT g, 'pending', g % 10, g FROM generate_series(1, 40) g

statement ok
CREATE INDEX cqs_due ON cqs (due) WHERE status = 'pending' AND prio > 5

query I
SELECT id FROM cqs WHERE status = 'pending' ORDER BY due LIMIT 3
----
1
2
3

query I
SELECT id FROM cqs WHERE status = 'pending' ORDER BY due DESC LIMIT 3
----
40
39
38

query I
SELECT id FROM cqs WHERE status = 'pending' AND prio > 5 ORDER BY due LIMIT 3
----
6
7
8

query T
EXPLAIN SELECT id FROM cqs WHERE status = 'pending' ORDER BY due LIMIT 3
----
Limit 3
  Project (1 column(s))
    Sort (1 key(s)) top-3
      Filter
        SeqScan: cqs (project 3/4 cols)

query T
EXPLAIN SELECT id FROM cqs WHERE status = 'pending' AND prio > 5 ORDER BY due LIMIT 3
----
Limit 3
  Project (1 column(s))
    Filter
      IndexScan: cqs using cqs_due

# a WHERE implying the predicate with a narrower condition: read in index order, not capped
# (ascending), or sorted (descending, where the read could not stop at the LIMIT)

query I
SELECT id FROM cqs WHERE status = 'pending' AND prio > 7 ORDER BY due LIMIT 3
----
8
9
18

query T
EXPLAIN SELECT id FROM cqs WHERE status = 'pending' AND prio > 7 ORDER BY due LIMIT 3
----
Limit 3
  Project (1 column(s))
    Filter
      IndexScan: cqs using cqs_due

