statement ok
CREATE TABLE cq (id INT NOT NULL, status TEXT NOT NULL, due INT, worker TEXT)

statement ok
INSERT INTO cq SELECT g, CASE WHEN g % 10 = 0 THEN 'pending' ELSE 'done' END, CASE WHEN g % 30 = 0 THEN NULL ELSE 300 - g END, NULL FROM generate_series(1, 300) g

statement ok
CREATE TABLE cq_plain AS SELECT * FROM cq

statement ok
CREATE INDEX cq_due_pending ON cq (due) WHERE status = 'pending'

# the claim queue: the predicate plus a range on the ordering column, read in index order

query T
EXPLAIN SELECT id FROM cq WHERE status = 'pending' AND due <= 150 ORDER BY due LIMIT 3
----
Limit 3
  Project (1 column(s))
    Filter
      IndexScan: cq using cq_due_pending

query I
SELECT id FROM cq WHERE status = 'pending' AND due <= 150 ORDER BY due LIMIT 3
----
290
280
260

query I
SELECT id FROM cq_plain WHERE status = 'pending' AND due <= 150 ORDER BY due LIMIT 3
----
290
280
260

# a bound that is not a constant: the ordered scan is not capped, the LIMIT stops it

query T
EXPLAIN SELECT id FROM cq WHERE status = 'pending' AND due <= abs(-150) ORDER BY due LIMIT 3
----
Limit 3
  Project (1 column(s))
    Filter
      IndexScan: cq using cq_due_pending

query I
SELECT id FROM cq WHERE status = 'pending' AND due <= abs(-150) ORDER BY due LIMIT 3
----
290
280
260

query I
SELECT id FROM cq_plain WHERE status = 'pending' AND due <= abs(-150) ORDER BY due LIMIT 3
----
290
280
260

