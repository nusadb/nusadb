# A partial index holds only the rows its predicate accepts. The planner scans it only when the
# query's WHERE implies that predicate; every query below also runs against a copy of the table
# with no index (`*_plain`), and the two must return the same rows, NULL rows included.

statement ok
CREATE TABLE pi (id INT NOT NULL, k INT, status TEXT, email TEXT, flag BOOL, n INT)

statement ok
INSERT INTO pi SELECT g, g % 13, CASE WHEN g % 5 = 0 THEN 'active' WHEN g % 7 = 0 THEN NULL ELSE 'idle' END, CASE WHEN g % 3 = 0 THEN NULL ELSE 'u' || g END, CASE WHEN g % 11 = 0 THEN NULL ELSE g % 2 = 0 END, g FROM generate_series(1, 200) g

statement ok
CREATE TABLE pi_plain AS SELECT * FROM pi

statement ok
CREATE INDEX pi_k_active ON pi (k) WHERE status = 'active'

statement ok
CREATE UNIQUE INDEX pi_email ON pi (email) WHERE email IS NOT NULL

statement ok
CREATE INDEX pi_k_flag ON pi (k) WHERE flag

statement ok
CREATE INDEX pi_k_not_flag ON pi (k) WHERE NOT flag

statement ok
CREATE INDEX pi_k_no_status ON pi (k) WHERE status IS NULL

statement ok
CREATE INDEX pi_n_in ON pi (n) WHERE status IN ('active', 'idle')

statement ok
CREATE INDEX pi_k_big ON pi (k) WHERE n > 100

# the WHERE repeats the predicate: the partial index answers

query T
EXPLAIN SELECT id FROM pi WHERE k = 5 AND status = 'active'
----
Project (1 column(s))
  Filter
    IndexScan: pi using pi_k_active

query I rowsort
SELECT id FROM pi WHERE k = 5 AND status = 'active'
----
135
200
5
70

query I rowsort
SELECT id FROM pi_plain WHERE k = 5 AND status = 'active'
----
135
200
5
70

# the constant may stand on either side

query T
EXPLAIN SELECT id FROM pi WHERE 5 = k AND 'active' = status
----
Project (1 column(s))
  Filter
    IndexScan: pi using pi_k_active

query I rowsort
SELECT id FROM pi WHERE 5 = k AND 'active' = status
----
135
200
5
70

query I rowsort
SELECT id FROM pi_plain WHERE 5 = k AND 'active' = status
----
135
200
5
70

