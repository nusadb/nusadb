# A prepared statement binds its parameters before planning, so each execution is planned with the
# value it was given.

statement ok
PREPARE by_email AS SELECT id FROM pi WHERE email = $1

query I
EXECUTE by_email('u7')
----
7

query I
EXECUTE by_email(NULL)
----

statement ok
PREPARE by_status AS SELECT id FROM pi WHERE k = 6 AND status = $1

query I rowsort
EXECUTE by_status('active')
----
110
175
