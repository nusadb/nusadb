statement ok
CREATE TABLE cqn (id INT NOT NULL, status TEXT NOT NULL, due INT NOT NULL)

statement ok
INSERT INTO cqn SELECT g, CASE WHEN g % 10 = 0 THEN 'pending' ELSE 'done' END, 300 - g FROM generate_series(1, 300) g

statement ok
CREATE TABLE cqn_plain AS SELECT * FROM cqn

statement ok
CREATE INDEX cqn_due_pending ON cqn (due) WHERE status = 'pending'

