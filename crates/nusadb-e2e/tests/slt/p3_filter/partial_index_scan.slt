# UPDATE and DELETE find their row through a partial unique index whose predicate the WHERE implies.

statement ok
UPDATE pi SET n = n + 1000 WHERE email = 'u8'

statement ok
UPDATE pi_plain SET n = n + 1000 WHERE email = 'u8'

statement ok
DELETE FROM pi WHERE email = 'u10' AND k = 10

statement ok
DELETE FROM pi_plain WHERE email = 'u10' AND k = 10

query I
SELECT count(*) FROM (SELECT * FROM pi EXCEPT ALL SELECT * FROM pi_plain) d
----
0

query I
SELECT count(*) FROM (SELECT * FROM pi_plain EXCEPT ALL SELECT * FROM pi) d
----
0

query II rowsort
SELECT id, n FROM pi WHERE email IN ('u8', 'u10')
----
8 1008

# A row leaving the predicate leaves the index, and one entering it joins it.

statement ok
UPDATE pi SET status = 'idle' WHERE id = 5

statement ok
UPDATE pi SET status = 'active' WHERE id = 6

statement ok
UPDATE pi_plain SET status = 'idle' WHERE id = 5

statement ok
