statement ok
CREATE TABLE pj (jid INT NOT NULL, k INT)

statement ok
INSERT INTO pj SELECT g, g % 13 FROM generate_series(1, 6) g

# the inner side of a join: a WHERE conjunct pushed onto it implies the predicate

query T
EXPLAIN SELECT j.jid, u.id FROM pj j JOIN pi u ON u.k = j.k WHERE u.status = 'active' AND u.k = 5
----
Project (2 column(s))
  HashJoin (Inner, 1 key(s))
    SeqScan: pj
    Filter
      IndexScan: pi using pi_k_active

query II rowsort
SELECT j.jid, u.id FROM pj j JOIN pi u ON u.k = j.k WHERE u.status = 'active' AND u.k = 5
----
5 135
5 200
5 5
5 70

query II rowsort
SELECT j.jid, u.id FROM pj j JOIN pi_plain u ON u.k = j.k WHERE u.status = 'active' AND u.k = 5
----
5 135
5 200
5 5
5 70

