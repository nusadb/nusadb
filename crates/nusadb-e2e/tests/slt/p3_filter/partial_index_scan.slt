query T
EXPLAIN SELECT id FROM pi WHERE email = 'u8' AND k = 8
----
Project (1 column(s))
  Filter
    IndexScan: pi using pi_email

query I rowsort
SELECT id FROM pi WHERE email = 'u8' AND k = 8
----
8

query I rowsort
SELECT id FROM pi_plain WHERE email = 'u8' AND k = 8
----
8

statement ok
CREATE TABLE ex (id INT NOT NULL, name TEXT, status TEXT, a INT, b INT)

statement ok
INSERT INTO ex SELECT g, 'N' || g, CASE WHEN g % 4 = 0 THEN 'active' WHEN g % 9 = 0 THEN NULL ELSE 'x' END, g % 6, g FROM generate_series(1, 120) g

statement ok
CREATE TABLE ex_plain AS SELECT * FROM ex

statement ok
CREATE INDEX ex_lower_active ON ex (lower(name)) WHERE status = 'active'

statement ok
CREATE INDEX ex_ab ON ex (a, b) WHERE status = 'active' AND b > 10

# an expression index with a predicate: the same expression plus the predicate

query T
EXPLAIN SELECT id FROM ex WHERE lower(name) = 'n8' AND status = 'active'
