CREATE TABLE pp (id INT NOT NULL, k INT, status TEXT) PARTITION BY RANGE (id)

statement ok
CREATE TABLE pp1 PARTITION OF pp FOR VALUES FROM (0) TO (100)

statement ok
CREATE TABLE pp2 PARTITION OF pp FOR VALUES FROM (100) TO (200)

statement ok
INSERT INTO pp SELECT g, g % 10, CASE WHEN g % 4 = 0 THEN 'active' WHEN g % 7 = 0 THEN NULL ELSE 'idle' END FROM generate_series(0, 199) g

statement ok
CREATE TABLE pp_plain AS SELECT * FROM pp

statement ok
CREATE INDEX pp1_k_active ON pp1 (k) WHERE status = 'active'

# a partial index on one partition serves that partition's branch

query T
EXPLAIN SELECT id FROM pp WHERE k = 4 AND status = 'active'
----
Project (1 column(s))
  Filter
    Project (3 column(s))
      SetOperation
        Union ALL
          Union ALL
            Project (3 column(s))
              Filter
                SeqScan: pp
            Project (3 column(s))
              Filter
                IndexScan: pp1 using pp1_k_active
          Project (3 column(s))
            Filter
              SeqScan: pp2

query I rowsort
SELECT id FROM pp WHERE k = 4 AND status = 'active'
