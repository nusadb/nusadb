# p3_filter/where_orderby_limit — predicates, sorting, and row caps.

statement ok
CREATE TABLE nums (id INT NOT NULL, v INT, kind TEXT)

statement ok
INSERT INTO nums VALUES
  (1, 10, 'a'),
  (2, 20, 'b'),
  (3, 30, 'a'),
  (4, 40, 'b'),
  (5, 50, 'a')

# WHERE with =
query I rowsort
SELECT id FROM nums WHERE v = 30
----
3

# WHERE with comparison
query I rowsort
SELECT id FROM nums WHERE v > 25
----
3
4
5

# WHERE with AND
query I rowsort
SELECT id FROM nums WHERE v > 15 AND kind = 'a'
----
3
5

# WHERE with OR
query I rowsort
SELECT id FROM nums WHERE v < 15 OR v > 45
----
1
5

# IN list
query I rowsort
SELECT id FROM nums WHERE id IN (1, 3, 99)
----
1
3

# NOT IN
query I rowsort
SELECT id FROM nums WHERE id NOT IN (1, 3, 5)
----
2
4

# BETWEEN (inclusive)
query I rowsort
SELECT id FROM nums WHERE v BETWEEN 20 AND 40
----
2
3
4

# LIKE pattern
query I rowsort
SELECT id FROM nums WHERE kind LIKE 'a'
----
1
3
5

# ORDER BY ASC (default)
query II nosort
SELECT id, v FROM nums ORDER BY v
----
1  10
2  20
3  30
4  40
5  50

# ORDER BY DESC
query II nosort
SELECT id, v FROM nums ORDER BY v DESC
----
5  50
4  40
3  30
2  20
1  10

# LIMIT after ORDER BY
query I nosort
SELECT id FROM nums ORDER BY v DESC LIMIT 3
----
5
4
3

# LIMIT 0 returns no rows
query I
SELECT id FROM nums LIMIT 0
----

# Multi-key ORDER BY
query TI nosort
SELECT kind, id FROM nums ORDER BY kind ASC, id DESC
----
a  5
a  3
a  1
b  4
b  2

# --- ordered index scan + LIMIT (sort-elimination on an indexed NOT NULL column) ---
statement ok
CREATE TABLE t6 (id INT NOT NULL, payload TEXT)

# 300 rows inserted in DESCENDING id order. The clustered key is the engine row-id (insert order),
# not `id`, so a plain scan yields descending id — a correct ascending ORDER BY result therefore
# proves the ordered index scan works, not merely insertion order.
statement ok
INSERT INTO t6 SELECT generate_series(299, 0, -1), 'p'

statement ok
CREATE INDEX t6_id ON t6 (id)

# ORDER BY id ASC LIMIT 5 → the five smallest ids, in order (plan is a forward, capped IndexScan).
query I nosort
SELECT id FROM t6 ORDER BY id ASC LIMIT 5
----
0
1
2
3
4

# LIMIT + OFFSET over the ordered scan.
query I nosort
SELECT id FROM t6 ORDER BY id ASC LIMIT 3 OFFSET 2
----
2
3
4

# A LIMIT larger than the table returns every row in order (cap never reached).
query I nosort
SELECT id FROM t6 WHERE id < 4 ORDER BY id ASC
----
0
1
2
3

# DESC serves from a backward ordered scan of the same index (Sort also eliminated); order correct.
query I nosort
SELECT id FROM t6 ORDER BY id DESC LIMIT 4
----
299
298
297
296

# DESC with OFFSET over the backward ordered scan.
query I nosort
SELECT id FROM t6 ORDER BY id DESC LIMIT 3 OFFSET 2
----
297
296
295
