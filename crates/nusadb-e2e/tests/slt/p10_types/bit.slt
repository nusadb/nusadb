# p10_types/bit — BIT(n) and BIT VARYING(n) bit strings.
# Covers: catalog types, implicit string coercion, canonical display, exact-length BIT(n) vs
# at-most-length BIT VARYING(n) enforcement, the ::bit(n) cast (which pads/truncates), ordering
# (left to right, then shorter first), equality, and loud rejection of a wrong-length assignment.

statement ok
CREATE TABLE b (id INT NOT NULL, f BIT(4), v BIT VARYING(8))

statement ok
INSERT INTO b VALUES (1, '1011', '101')

statement ok
INSERT INTO b VALUES (2, '0000', '11110000')

statement ok
INSERT INTO b VALUES (3, '1111', '1')

# An empty bit-varying value is allowed (checked as a statement, not compared as a row value).
statement ok
INSERT INTO b VALUES (4, '0101', '')

query ITT rowsort
SELECT id, f, v FROM b WHERE id <= 3
----
1  1011  101
2  0000  11110000
3  1111  1

# The ::bit(n) cast right-pads with zeros when shorter and truncates when longer.
query T
SELECT CAST('101' AS BIT(5))
----
10100

query T
SELECT CAST('10100' AS BIT(3))
----
101

# BIT VARYING keeps its own length.
query T
SELECT CAST('1011' AS BIT VARYING(8))
----
1011

# Ordering: left to right, then a shorter string first on a common prefix.
statement ok
CREATE TABLE ord (x BIT VARYING(8))

statement ok
INSERT INTO ord VALUES ('10'), ('11'), ('100'), ('1'), ('0')

query T
SELECT x FROM ord ORDER BY x
----
0
1
10
100
11

# Equality against a text literal (coerced to the column's bit type).
query I
SELECT id FROM b WHERE f = '1011'
----
1

# A wrong-length value for a fixed BIT(4) is rejected (not silently padded).
statement error
INSERT INTO b VALUES (9, '101', '1')

# A non-binary character is rejected.
statement error
INSERT INTO b VALUES (10, '10x1', '1')

# A BIT VARYING value longer than its declared maximum is rejected.
statement error
INSERT INTO b VALUES (11, '1111', '111100001')

# --- bitwise operators (& | #), shifts (<< >>), and concatenation (||) ---

query T
SELECT '1100'::BIT(4) & '1010'::BIT(4)
----
1000

query T
SELECT '1100'::BIT(4) | '1010'::BIT(4)
----
1110

query T
SELECT '1100'::BIT(4) # '1010'::BIT(4)
----
0110

# Bitwise ops require equal lengths.
statement error
SELECT '110'::BIT(3) & '1010'::BIT(4)

# Shifts keep the length (bits fall off one end, zeros fill the other).
query T
SELECT '10010'::BIT(5) << 2
----
01000

query T
SELECT '10010'::BIT(5) >> 2
----
00100

# Concatenation joins two bit strings.
query T
SELECT '101'::BIT(3) || '11'::BIT(2)
----
10111

# --- functions ---

query I
SELECT LENGTH('10110'::BIT(5))
----
5

query I
SELECT GET_BIT('10110'::BIT(5), 0)
----
1

query I
SELECT GET_BIT('10110'::BIT(5), 1)
----
0

query T
SELECT SET_BIT('10110'::BIT(5), 0, 0)
----
00110

# An out-of-range bit index is rejected.
statement error
SELECT GET_BIT('101'::BIT(3), 5)

# The ~ operator complements every bit, keeping the string's length.
query TT
SELECT ~CAST('10110' AS BIT(5)), ~CAST('0000' AS BIT(4))
----
01001 1111

# ~ preserves length and round-trips through a double complement.
query TT
SELECT ~CAST('1100' AS BIT(4)), ~(~CAST('101' AS BIT(3)))
----
0011 101

# --- INTEGER → BIT(n) cast: the low n bits of the 32-bit two's-complement value, MSB first. ---
query T
SELECT CAST(11 AS BIT(8))
----
00001011

# Only the low 8 bits survive (259 = 0x103).
query T
SELECT CAST(259 AS BIT(8))
----
00000011

# A negative value fills with its sign: -1 is all ones.
query T
SELECT CAST(-1 AS BIT(8))
----
11111111

# A wider target left-pads with zeros for a positive value.
query T
SELECT CAST(5 AS BIT(16))
----
0000000000000101

# Beyond 32 bits the sign bit extends: positive zero-fills, negative one-fills.
query TT
SELECT CAST(5 AS BIT(40)), CAST(-2 AS BIT(35))
----
0000000000000000000000000000000000000101 11111111111111111111111111111111110

# --- BIT → INTEGER cast: right-align in a 32-bit field, read as signed two's-complement. ---
query I
SELECT CAST(CAST('1011' AS BIT(4)) AS INT)
----
11

# A short string is always non-negative.
query I
SELECT CAST(CAST('101' AS BIT(3)) AS INT)
----
5

# 32 ones read as -1; a 32-bit value with the top bit set is i32::MIN.
query II
SELECT CAST(CAST('11111111111111111111111111111111' AS BIT(32)) AS INT), CAST(CAST('10000000000000000000000000000000' AS BIT(32)) AS INT)
----
-1 -2147483648

# The postfix `::` cast form composes the same way.
query I
SELECT CAST('1011' AS BIT(4))::INT
----
11

# A bit string wider than 32 bits overflows the signed 32-bit integer.
statement error
SELECT CAST(CAST('101010101010101010101010101010101' AS BIT(33)) AS INT)
