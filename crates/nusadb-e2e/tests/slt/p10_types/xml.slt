# p10_types/xml — the XML type.
# Covers: the native XML column type, well-formedness validation on cast/store (CONTENT semantics),
# and verbatim text preservation (unlike JSONB, XML is not canonicalized).

statement ok
CREATE TABLE xdoc (id INT NOT NULL, body XML)

# A text literal assigned to an XML column is validated and stored verbatim.
statement ok
INSERT INTO xdoc VALUES (1, '<a x="1">t</a>'), (2, '<r><c/></r>')

query IT
SELECT id, body FROM xdoc ORDER BY id
----
1  <a x="1">t</a>
2  <r><c/></r>

# The cast preserves the input text exactly — whitespace, attributes, and self-closing tags.
query T
SELECT '<a>  spaced  </a>'::XML
----
<a>  spaced  </a>

query T
SELECT '<a/>'::XML
----
<a/>

# Bare text is valid XML content (the cast uses CONTENT semantics, which allows fragments).
query T
SELECT 'notxml'::XML
----
notxml

query T
SELECT 'a<b/>c'::XML
----
a<b/>c

# Round-trip through TEXT returns the stored text unchanged.
query T
SELECT CAST('<k>v</k>'::XML AS TEXT)
----
<k>v</k>

# Malformed markup is rejected — an unclosed tag and a mismatched end tag.
statement error
SELECT '<a>'::XML

statement error
SELECT '<a></b>'::XML

# ... and rejected on store into an XML column.
statement error
INSERT INTO xdoc VALUES (9, '<oops>')

# --- xml_is_well_formed* : test well-formedness without raising an error ---

# _document requires a single root; a fragment or malformed markup is not a document.
query III
SELECT XML_IS_WELL_FORMED_DOCUMENT('<a>1</a>'), XML_IS_WELL_FORMED_DOCUMENT('a<b/>c'), XML_IS_WELL_FORMED_DOCUMENT('<a>')
----
1 0 0

# _content allows fragments and bare text, but still rejects malformed markup.
query III
SELECT XML_IS_WELL_FORMED_CONTENT('a<b/>c'), XML_IS_WELL_FORMED_CONTENT('notxml'), XML_IS_WELL_FORMED_CONTENT('<a></b>')
----
1 1 0

# The unsuffixed form uses content semantics (the session default).
query II
SELECT XML_IS_WELL_FORMED('a<b/>c'), XML_IS_WELL_FORMED('<a>')
----
1 0

# NULL propagates.
query I
SELECT CAST(XML_IS_WELL_FORMED(NULL) AS INT)
----
NULL

# --- xmlcomment: build an XML comment node ---
query T
SELECT CAST(XMLCOMMENT('hello') AS TEXT)
----
<!--hello-->

# Content that would break the comment syntax (contains -- or ends with -) is a loud error.
statement error
SELECT XMLCOMMENT('a--b')

statement error
SELECT XMLCOMMENT('trailing-')
