statement ok
CREATE TABLE aw2 (id BIGINT PRIMARY KEY, k NUMERIC(10,2) NOT NULL, ar NUMERIC(10,2)[] NOT NULL)

statement ok
INSERT INTO aw2 VALUES (1, 2.5, ARRAY[1.5::NUMERIC(10,2)]), (2, 1.5, ARRAY[1.5::NUMERIC(10,2), 2.5::NUMERIC(10,2)])

query TTTT
SELECT (ar || k)::TEXT, (k || ar)::TEXT, array_append(ar, k)::TEXT, array_prepend(k, ar)::TEXT FROM aw2 ORDER BY id
----
{1.50,2.50} {2.50,1.50} {1.50,2.50} {2.50,1.50}
{1.50,2.50,1.50} {1.50,1.50,2.50} {1.50,2.50,1.50} {1.50,1.50,2.50}

query TTT
SELECT array_cat(ar, ARRAY[k])::TEXT, array_remove(ar, k)::TEXT, array_replace(ar, ar[1], k)::TEXT FROM aw2 ORDER BY id
----
{1.50,2.50} {1.50} {2.50}
{1.50,2.50,1.50} {2.50} {1.50,2.50}

query TTTTTT
SELECT (k = ANY(ar))::TEXT, (k = ALL(ar))::TEXT, (k <> ALL(ar))::TEXT, (ar @> ARRAY[k])::TEXT, (ARRAY[k] <@ ar)::TEXT, (ar && ARRAY[k])::TEXT FROM aw2 ORDER BY id
----
false false true false false false
true false false true true true

query TTT
SELECT ar[1]::TEXT, (ar[1] = k)::TEXT, array_position(ar, k)::TEXT FROM aw2 ORDER BY id
----
1.50 false NULL
1.50 true 1

query TT
SELECT x::TEXT, (x = k)::TEXT FROM aw2, unnest(ar) AS x ORDER BY id, x
----
1.50 false
1.50 true
2.50 false
