# p10_types/range — range types (int4range/int8range/numrange/daterange/tsrange/tstzrange).
# Covers: catalog types, implicit string coercion, canonical display, discrete canonicalization
# ([] and () normalized to half-open [) for int/date), continuous bounds kept verbatim, the empty
# range, unbounded (infinite) bounds, the ::range cast, ordering (empty first, then by lower bound
# with -infinity first, then by upper bound with +infinity last), equality, and loud rejection of a
# lower bound greater than the upper bound.

statement ok
CREATE TABLE r (id INT NOT NULL, ir int4range, nr numrange, dr daterange)

# Discrete int4range canonicalizes any inclusivity to half-open [); numrange keeps its bounds; the
# daterange is discrete too. Row 2 exercises the closed form [1,10] -> [1,11) and the empty range.
statement ok
INSERT INTO r VALUES (1, '[1,10)', '(1.5,3.5]', '[2020-01-01,2020-02-01)')

statement ok
INSERT INTO r VALUES (2, '[1,10]', '[0,5)', 'empty')

query ITTT rowsort
SELECT id, ir, nr, dr FROM r
----
1  [1,10)  (1.5,3.5]  [2020-01-01,2020-02-01)
2  [1,11)  [0,5)  empty

# The ::int4range cast canonicalizes a closed bound to half-open.
query T
SELECT CAST('[1,5]' AS int4range)
----
[1,6)

# numrange is continuous — its exclusive/inclusive bounds are preserved.
query T
SELECT CAST('(1.5,3.5]' AS numrange)
----
(1.5,3.5]

# Ordering: the empty range sorts first, then by lower bound (-infinity first), then by upper bound
# (+infinity last).
statement ok
CREATE TABLE ord (x int4range)

statement ok
INSERT INTO ord VALUES ('[1,10)'), ('[1,5)'), ('[5,10)'), ('empty'), ('(,3)'), ('[1,)')

query T
SELECT x FROM ord ORDER BY x
----
empty
(,3)
[1,5)
[1,10)
[1,)
[5,10)

# Equality against a text literal (coerced to the column's range type, after canonicalization).
query I
SELECT id FROM r WHERE ir = '[1,10)'
----
1

# The closed literal [1,10] canonicalizes to the same [1,11) as row 2.
query I
SELECT id FROM r WHERE ir = '[1,11)'
----
2

# A lower bound greater than the upper bound is rejected (not silently collapsed to empty).
statement error
INSERT INTO r VALUES (9, '[5,1)', NULL, NULL)

# numrange equality/grouping is scale-independent: [1.5,3.5) and [1.50,3.50) are one value even
# though their stored/displayed bounds keep the original scale.
statement ok
CREATE TABLE nrng (nr numrange)

statement ok
INSERT INTO nrng VALUES ('[1.5,3.5)'), ('[1.50,3.50)'), ('[2.0,4.0)')

# Equality (comparison path) treats the scale-equal bounds as equal.
query I
SELECT count(*) FROM nrng WHERE nr = '[1.50,3.50)'
----
2

# DISTINCT (linear not-distinct dedup) collapses the scale-equal pair to one row.
query I
SELECT count(*) FROM (SELECT DISTINCT nr FROM nrng) d
----
2

# GROUP BY (hash grouping) keys on the scale-normalized bytes: one group of 2, one of 1.
query I rowsort
SELECT count(*) FROM nrng GROUP BY nr
----
1
2

# ---------------------------------------------------------------------------
# Containment `@>` / `<@` and overlap `&&`.
# ---------------------------------------------------------------------------

# `@>` against a single element: the half-open [1,10) holds 1 and 9, not 10 or 0.
query IIII
SELECT '[1,10)'::int4range @> 1, '[1,10)'::int4range @> 9,
       '[1,10)'::int4range @> 10, '[1,10)'::int4range @> 0
----
1 1 0 0

# `<@` is the mirror, with the element on the left.
query II
SELECT 5 <@ '[1,10)'::int4range, 10 <@ '[1,10)'::int4range
----
1 0

# Range-in-range containment, including the bound-touching cases.
query IIII
SELECT '[1,10)'::int4range @> '[2,5)'::int4range, '[1,10)'::int4range @> '[1,10)'::int4range,
       '[1,10)'::int4range @> '[1,11)'::int4range, '[1,10)'::int4range @> '[0,5)'::int4range
----
1 1 0 0

# The empty range is contained by every range and contains only itself.
query III
SELECT '[1,10)'::int4range @> 'empty'::int4range, 'empty'::int4range @> '[1,10)'::int4range,
       'empty'::int4range @> 'empty'::int4range
----
1 0 1

# An unbounded side covers everything on that side.
query III
SELECT '(,)'::int4range @> '[1,10)'::int4range, '[1,)'::int4range @> '[5,)'::int4range,
       '[1,)'::int4range @> '(,5)'::int4range
----
1 1 0

# Overlap: adjacent ranges do not overlap, and the empty range overlaps nothing.
query IIII
SELECT '[1,10)'::int4range && '[5,20)'::int4range, '[1,10)'::int4range && '[10,20)'::int4range,
       '[1,10)'::int4range && 'empty'::int4range, '(,)'::int4range && '[1,10)'::int4range
----
1 0 0 1

# A continuous range keeps its inclusivity, so a shared exclusive endpoint is not an overlap.
query II
SELECT '(1.5,3.5]'::numrange && '[3.5,9.0)'::numrange,
       '(1.5,3.5)'::numrange && '[3.5,9.0)'::numrange
----
1 0

# The bound-touching containment cases a discrete range cannot express.
query II
SELECT '(1.0,3.0]'::numrange @> '(1.0,3.0)'::numrange,
       '(1.0,3.0)'::numrange @> '(1.0,3.0]'::numrange
----
1 0

# A NULL operand yields NULL, not false.
query III
SELECT NULL::int4range @> 5, '[1,10)'::int4range @> NULL::int4range,
       NULL::int4range && '[1,10)'::int4range
----
NULL NULL NULL

# Against a stored column, and as a WHERE predicate over the earlier table.
query I rowsort
SELECT id FROM r WHERE ir @> 5
----
1
2

query I
SELECT id FROM r WHERE dr && '[2020-01-15,2020-03-01)'
----
1

# A bare string literal beside `&&` is unambiguous (the operator has only a range/range form) and
# coerces to the column's range type. Only row 2 matches: its stored [1,10] canonicalized to
# [1,11), which reaches 10; row 1's [1,10) stops short of it.
query I
SELECT id FROM r WHERE ir && '[10,20)'
----
2

# The same coercion with the literal on the left.
query I
SELECT id FROM r WHERE '[10,20)' && ir
----
2

# int8range is the same integer element kind, so a BIGINT element is accepted against it.
query II
SELECT '[1,20000000000)'::int8range @> 15000000000, '[1,20000000000)'::int8range @> 0
----
1 0

# An integer element against a numeric range is compared exactly, not through a float.
query II
SELECT '[1.5,10.5)'::numrange @> 2, '[1.5,10.5)'::numrange @> 11
----
1 0

# `@>` with a bare literal could mean the range or one element, so it is rejected rather than
# guessed — the cast says which.
statement error
SELECT id FROM r WHERE ir @> '5'

# Mixing element kinds is a type error, not a silently-false answer.
statement error
SELECT '[1,10)'::int4range && '[1.5,3.5)'::numrange

# ---------------------------------------------------------------------------
# Accessors: lower/upper/isempty/lower_inc/upper_inc/lower_inf/upper_inf.
# ---------------------------------------------------------------------------

# The bounds come back as the element type, after canonicalization ([1,10] is [1,11)).
query II
SELECT lower('[1,10]'::int4range), upper('[1,10]'::int4range)
----
1  11

# A numeric range keeps its bounds verbatim, so the accessors report them unchanged.
query TT
SELECT lower('(1.5,3.5]'::numrange), upper('(1.5,3.5]'::numrange)
----
1.5  3.5

# An unbounded side has no bound value, so it reads back as NULL — on either end.
query IIII
SELECT lower('(,10)'::int4range), upper('(,10)'::int4range),
       lower('[1,)'::int4range), upper('[1,)'::int4range)
----
NULL 10 1 NULL

# The empty range has neither bound.
query II
SELECT lower('empty'::int4range), upper('empty'::int4range)
----
NULL NULL

# isempty distinguishes the empty range from one that merely has no bounds.
query II
SELECT isempty('empty'::int4range), isempty('(,)'::int4range)
----
1 0

# Inclusivity: a discrete range is always [lower,upper), a continuous one keeps what it was given.
query IIII
SELECT lower_inc('[1,10)'::int4range), upper_inc('[1,10)'::int4range),
       lower_inc('(1.5,3.5]'::numrange), upper_inc('(1.5,3.5]'::numrange)
----
1 0 0 1

# An infinite bound is never inclusive, and the empty range reports false for every flag.
query IIII
SELECT lower_inc('(,10)'::int4range), upper_inc('[1,)'::int4range),
       lower_inc('empty'::int4range), upper_inc('empty'::int4range)
----
0 0 0 0

# The `_inf` predicates say which side is unbounded — and report false for the empty range, which
# is why they are needed to read a NULL from lower()/upper().
query IIII
SELECT lower_inf('(,10)'::int4range), upper_inf('(,10)'::int4range),
       lower_inf('empty'::int4range), upper_inf('empty'::int4range)
----
1 0 0 0

# NULL in, NULL out.
query II
SELECT lower(NULL::int4range), isempty(NULL::int4range)
----
NULL NULL

# `lower`/`upper` keep their text meaning when the argument is not a range.
query TT
SELECT lower('ABC'), upper('abc')
----
abc  ABC

# The overload is decided by the argument's type, so it also works over an aggregate — and the
# aggregate is registered exactly once (a double registration would double-count the rows).
query II
SELECT lower(max(ir)), count(*) FROM r
----
1  2

query T
SELECT lower(max(name)) FROM (SELECT 'ZED' AS name UNION ALL SELECT 'ABE') s
----
zed

# The accessors over a stored column, with the date element type coming back as a DATE.
query IT
SELECT id, lower(dr) FROM r WHERE id = 1
----
1  2020-01-01

# A non-range argument to a range-only accessor is a type error.
statement error
SELECT isempty('abc')

# ---------------------------------------------------------------------------
# Constructors: int4range/int8range/numrange/daterange/tsrange/tstzrange.
# ---------------------------------------------------------------------------

# Two bounds default to the half-open [) form; the third argument picks another.
query TTTT
SELECT int4range(1,10), int4range(1,10,'[]'), int4range(1,10,'(]'), int4range(1,10,'()')
----
[1,10)  [1,11)  [2,11)  [2,10)

# A NULL bound is unbounded on that side — not a NULL result.
query TTT
SELECT int4range(NULL,10), int4range(1,NULL), int4range(NULL,NULL)
----
(,10)  [1,)  (,)

# Bounds that cross collapse or reject exactly as the literal form does.
query TT
SELECT int4range(5,5), int4range(5,5,'[]')
----
empty  [5,6)

statement error
SELECT int4range(10,1)

# A continuous kind keeps the inclusivity it was given.
query TT
SELECT numrange(1.5,3.5), numrange(1.5,3.5,'(]')
----
[1.5,3.5)  (1.5,3.5]

# An integer bound widens into a numeric range exactly.
query T
SELECT numrange(1,3,'[]')
----
[1,3]

# The other element kinds, including the int8range spelling of the integer kind. A timestamp bound
# contains a space, so the canonical form quotes it; integer and date bounds stay bare.
query TT
SELECT int8range(1,20000000000), daterange('2024-01-01','2024-03-01')
----
[1,20000000000)  [2024-01-01,2024-03-01)

query TT
SELECT tsrange('2024-01-01 00:00:00','2024-01-02 12:30:00'),
       tstzrange('2024-01-01 00:00:00+00','2024-01-02 00:00:00+00')
----
["2024-01-01 00:00:00","2024-01-02 12:30:00")  ["2024-01-01 00:00:00+00","2024-01-02 00:00:00+00")

# The quoted form is what a tsrange reads back from, too.
query I
SELECT tsrange('2024-01-01 00:00:00','2024-01-02 12:30:00') = '["2024-01-01 00:00:00","2024-01-02 12:30:00")'::tsrange
----
1

# A constructed range is the same value as its literal form, and feeds the operators.
query II
SELECT int4range(1,10) = '[1,10)'::int4range, int4range(1,10) @> 5
----
1 1

# Constructed values store and read back like any other range.
statement ok
INSERT INTO r VALUES (3, int4range(20,30), numrange(1,2), daterange(NULL,'2020-06-01'))

query TTT
SELECT ir, nr, dr FROM r WHERE id = 3
----
[20,30)  [1,2)  (,2020-06-01)

# An unrecognised bound-flags string is rejected, not silently defaulted.
statement error
SELECT int4range(1,10,'><')

# The flags argument may not be NULL — omitting it is how the default is asked for.
statement error
SELECT int4range(1,10,NULL)

# Wrong arity and a bound of the wrong element type are both type errors.
statement error
SELECT int4range(1)

statement error
SELECT int4range('2024-01-01'::date, 10)
