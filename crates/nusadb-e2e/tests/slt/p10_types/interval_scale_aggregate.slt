# INTERVAL times and divided by a number, and SUM / AVG over INTERVAL.
#
# Carry rule for a fractional result: months truncate toward zero and the fractional month spills
# into days at 30 days per month; days truncate toward zero and every fractional day spills into the
# time at 24 hours per day; the time rounds to the nearest microsecond. Nothing carries upward, so
# `23:59:59 * 2` stays `47:59:58`. An integer factor scales each field exactly.

statement ok
CREATE TABLE iv (id INT PRIMARY KEY, d INTERVAL, g INT)

statement ok
INSERT INTO iv VALUES (1, INTERVAL '1 day 3 hours', 1), (2, INTERVAL '1 mon 2 days', 1), (3, INTERVAL '-1 day -12:00:00', 2), (4, NULL, 2), (5, INTERVAL '1 year 1 mon 00:00:00.000001', 3)

query ITTTT
SELECT id, d * 2, 2 * d, d * CAST(2 AS bigint), d * CAST(2 AS smallint) FROM iv ORDER BY id
----
1 2 days 06:00:00 2 days 06:00:00 2 days 06:00:00 2 days 06:00:00
2 2 mons 4 days 2 mons 4 days 2 mons 4 days 2 mons 4 days
3 -2 days -24:00:00 -2 days -24:00:00 -2 days -24:00:00 -2 days -24:00:00
4 NULL NULL NULL NULL
5 2 years 2 mons 00:00:00.000002 2 years 2 mons 00:00:00.000002 2 years 2 mons 00:00:00.000002 2 years 2 mons 00:00:00.000002

query ITTT
SELECT id, d * 1.5, d * CAST(0.5 AS float), 1.5 * d FROM iv ORDER BY id
----
1 1 day 16:30:00 13:30:00 1 day 16:30:00
2 1 mon 18 days 16 days 1 mon 18 days
3 -1 days -30:00:00 -18:00:00 -1 days -30:00:00
4 NULL NULL NULL
5 1 year 7 mons 15 days 00:00:00.000002 6 mons 15 days 1 year 7 mons 15 days 00:00:00.000002

query ITTT
SELECT id, d / 2, d / CAST(4 AS bigint), d / 2.5 FROM iv ORDER BY id
----
1 13:30:00 06:45:00 10:48:00
2 16 days 8 days 12 days 19:12:00
3 -18:00:00 -09:00:00 -14:24:00
4 NULL NULL NULL
5 6 mons 15 days 3 mons 7 days 12:00:00 5 mons 6 days

# The carry, case by case.
query TTTTTT
SELECT INTERVAL '1 mon' * 1.5, INTERVAL '1 mon' * 0.1, INTERVAL '-1 mon' * 1.5, INTERVAL '1 day' * 1.5, INTERVAL '1 day' / 3, INTERVAL '23:59:59' * 2
----
1 mon 15 days 3 days -1 mons -15 days 1 day 12:00:00 08:00:00 47:59:58

query TTTT
SELECT INTERVAL '1 mon' / 7, INTERVAL '1 year' / 5, INTERVAL '3 days' / 2, INTERVAL '1 hour' / 1.5
----
4 days 06:51:25.6896 2 mons 12 days 1 day 12:00:00 00:40:00

query TT
SELECT INTERVAL '1 mon 1 day' * -1, INTERVAL '00:00:00.000001' / 2
----
-1 mons -1 days 00:00:00

# NULL in, NULL out; an untyped NULL factor resolves to a number.
query TTT
SELECT d * NULL, NULL * d, d / NULL FROM iv WHERE id = 1
----
NULL NULL NULL

statement error division by zero
SELECT INTERVAL '1 day' / 0

statement error division by zero
SELECT INTERVAL '1 day' / 0.0

statement error INTERVAL arithmetic overflow
SELECT INTERVAL '2000000000 days' * 2

statement error INTERVAL arithmetic overflow
SELECT INTERVAL '2000000000 days' * 1.5

statement error INTERVAL arithmetic overflow
SELECT INTERVAL '1 day' * CAST('NaN' AS float)

# SUM adds each field separately (no carry between months, days and time); AVG divides that sum
# by the count of non-NULL values with the carry rule above. NULLs are skipped; an empty input is
# NULL.
query ITT
SELECT g, SUM(d), AVG(d) FROM iv GROUP BY g ORDER BY g
----
1 1 mon 3 days 03:00:00 16 days 13:30:00
2 -1 days -12:00:00 -1 days -12:00:00
3 1 year 1 mon 00:00:00.000001 1 year 1 mon 00:00:00.000001

query TT
SELECT SUM(d), AVG(d) FROM iv
----
1 year 2 mons 2 days -08:59:59.999999 3 mons 15 days 09:45:00

query TT
SELECT SUM(d), AVG(d) FROM iv WHERE id > 100
----
NULL NULL

query IT
SELECT id, SUM(d) OVER (ORDER BY id) FROM iv ORDER BY id
----
1 1 day 03:00:00
2 1 mon 3 days 03:00:00
3 1 mon 2 days -09:00:00
4 1 mon 2 days -09:00:00
5 1 year 2 mons 2 days -08:59:59.999999

query IT
SELECT id, AVG(d) OVER (ORDER BY id ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) FROM iv ORDER BY id
----
1 1 day 03:00:00
2 16 days 13:30:00
3 15 days 06:00:00
4 -1 days -12:00:00
5 1 year 1 mon 00:00:00.000001

statement ok
CREATE TABLE big_iv (d INTERVAL)

statement ok
INSERT INTO big_iv VALUES (INTERVAL '2000000000 days'), (INTERVAL '2000000000 days')

statement error INTERVAL arithmetic overflow
SELECT SUM(d) FROM big_iv

statement error INTERVAL arithmetic overflow
SELECT AVG(d) FROM big_iv

# A non-numeric factor is still a type error.
statement error type mismatch
SELECT INTERVAL '1 day' * INTERVAL '1 day'

statement error type mismatch
SELECT 2 / INTERVAL '1 day'
