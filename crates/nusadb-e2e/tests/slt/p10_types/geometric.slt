# p10_types/geometric — native POINT and BOX geometric types.
# Covers: catalog type, implicit text coercion + CAST, canonical formatting, the point(x,y) and
# box(p1,p2) constructors, coordinate subscript (0-based), distance (<->), same-as (~=), vector
# add/sub and complex mult/div (incl. divide-by-zero), box normalization, area/center/height/width,
# containment (@>/<@) with boundary cases, overlap (&&), box distance (center-to-center), and loud
# rejection of malformed input.

statement ok
CREATE TABLE geo (id INT NOT NULL, p POINT, b BOX)

# Point: implicit text coercion — paren form, spaces allowed, and the bare no-paren form.
statement ok
INSERT INTO geo VALUES (1, '(1,2)', '(1,1),(3,3)')

statement ok
INSERT INTO geo VALUES (2, '( 1.5 , -2.5 )', '(3,3),(1,1)')

statement ok
INSERT INTO geo VALUES (3, '3,4', '(1,3),(3,1)')

# Canonical output: a point as (x,y); a box normalized to (upper-right),(lower-left) regardless of
# the input corner order.
query ITT rowsort
SELECT id, p, b FROM geo
----
1  (1,2)  (3,3),(1,1)
2  (1.5,-2.5)  (3,3),(1,1)
3  (3,4)  (3,3),(1,1)

# point(x,y) constructor and an explicit CAST from text.
query T
SELECT point(1.5,-2.5)
----
(1.5,-2.5)

query T
SELECT CAST('(1,2)' AS POINT)
----
(1,2)

# Coordinate subscript is 0-based: p[0] = x, p[1] = y; an out-of-range index is NULL.
query RRR
SELECT (point(3,4))[0], (point(3,4))[1], (point(3,4))[2]
----
3.000  4.000  NULL

# Euclidean distance between two points.
query R
SELECT point(0,0) <-> point(3,4)
----
5.000

# Same-as equality (~=): coordinate-wise.
query II
SELECT point(1,2) ~= point(1,2), point(1,2) ~= point(1,3)
----
1  0

# Vector add/sub, complex multiply/divide. (1,2)*(3,4) = (1*3-2*4, 1*4+2*3) = (-5,10).
query TTTT
SELECT point(1,2)+point(3,4), point(1,2)-point(3,4), point(1,2)*point(3,4), point(1,2)/point(3,4)
----
(4,6)  (-2,-2)  (-5,10)  (0.44,0.08)

# Complex division by the zero point is a division-by-zero error.
statement error
SELECT point(1,2) / point(0,0)

# Malformed point input is rejected loudly, not silently stored.
statement error
SELECT CAST('abc' AS POINT)

statement error
SELECT CAST('(1,2,3)' AS POINT)

statement error
SELECT CAST('(1)' AS POINT)

# box(p1,p2) constructor normalizes its corners.
query T
SELECT box(point(0,0), point(2,3))
----
(2,3),(0,0)

# area = width * height; center = midpoint; height/width of a box.
query R
SELECT area(CAST('(0,0),(2,3)' AS BOX))
----
6.000

query T
SELECT center(CAST('(0,0),(2,4)' AS BOX))
----
(1,2)

query RR
SELECT height(CAST('(0,0),(2,3)' AS BOX)), width(CAST('(0,0),(2,3)' AS BOX))
----
3.000  2.000

# Containment box @> point, inclusive of the boundary: (2,2) inside, (0,0) corner, (4,2) edge are
# all contained; (5,2) outside is not.
query IIII
SELECT
  CAST('(0,0),(4,4)' AS BOX) @> point(2,2),
  CAST('(0,0),(4,4)' AS BOX) @> point(0,0),
  CAST('(0,0),(4,4)' AS BOX) @> point(4,2),
  CAST('(0,0),(4,4)' AS BOX) @> point(5,2)
----
1  1  1  0

# point <@ box is the mirror of box @> point.
query I
SELECT point(2,2) <@ CAST('(0,0),(4,4)' AS BOX)
----
1

# Overlap box && box, inclusive of a shared edge/corner; disjoint boxes do not overlap.
query II
SELECT
  CAST('(0,0),(2,2)' AS BOX) && CAST('(1,1),(3,3)' AS BOX),
  CAST('(0,0),(2,2)' AS BOX) && CAST('(3,3),(4,4)' AS BOX)
----
1  0

# Box distance (<->) is the Euclidean distance between the two box centers: centers (1,1) and
# (11,1) are 10 apart.
query R
SELECT CAST('(0,0),(2,2)' AS BOX) <-> CAST('(10,0),(12,2)' AS BOX)
----
10.000

# ── circle ──────────────────────────────────────────────────────────────────────────────────
# A circle is a center (cx,cy) and a non-negative radius r, canonical form <(cx,cy),r>.

statement ok
CREATE TABLE circ (id INT NOT NULL, c CIRCLE)

# Implicit text coercion: canonical <(x,y),r>, the paren form ((x,y),r), and the bare x,y,r form.
statement ok
INSERT INTO circ VALUES (1, '<(1.5,2.5),3.25>')

statement ok
INSERT INTO circ VALUES (2, '((1,2),3)')

statement ok
INSERT INTO circ VALUES (3, '4,5,6')

# A zero radius is a valid (degenerate) circle.
statement ok
INSERT INTO circ VALUES (4, '<(0,0),0>')

# A negative radius is rejected loudly, not stored.
statement error
INSERT INTO circ VALUES (9, '<(0,0),-1>')

# Canonical output: <(cx,cy),r>, regardless of the accepted input form.
query IT rowsort
SELECT id, c FROM circ
----
1  <(1.5,2.5),3.25>
2  <(1,2),3>
3  <(4,5),6>
4  <(0,0),0>

# An explicit CAST from text parses the same way; a malformed or negative-radius string is a loud
# error.
query T
SELECT CAST('<(1,2),3>' AS CIRCLE)
----
<(1,2),3>

statement error
SELECT CAST('abc' AS CIRCLE)

statement error
SELECT CAST('<(0,0),-1>' AS CIRCLE)

statement error
SELECT CAST('<(1,2),3,4>' AS CIRCLE)

# area = pi*r^2, radius = r, diameter = 2*r.
query R
SELECT area(CAST('<(0,0),2>' AS CIRCLE))
----
12.566

query RR
SELECT radius(CAST('<(0,0),2>' AS CIRCLE)), diameter(CAST('<(0,0),2>' AS CIRCLE))
----
2.000  4.000

# center is the circle's center point.
query T
SELECT center(CAST('<(3,4),5>' AS CIRCLE))
----
(3,4)

# circle <-> point: gap from the point to the circle's boundary; a point inside the circle is 0.
query RR
SELECT
  CAST('<(0,0),1>' AS CIRCLE) <-> CAST('(5,0)' AS POINT),
  CAST('<(0,0),5>' AS CIRCLE) <-> CAST('(1,1)' AS POINT)
----
4.000  0.000

# circle <-> circle: gap between the two boundaries; overlapping circles are 0.
query RR
SELECT
  CAST('<(0,0),1>' AS CIRCLE) <-> CAST('<(5,0),1>' AS CIRCLE),
  CAST('<(0,0),3>' AS CIRCLE) <-> CAST('<(4,0),3>' AS CIRCLE)
----
3.000  0.000

# Overlap circle && circle: true when the centers are within the summed radii; disjoint is false.
query II
SELECT
  CAST('<(0,0),2>' AS CIRCLE) && CAST('<(3,0),2>' AS CIRCLE),
  CAST('<(0,0),2>' AS CIRCLE) && CAST('<(5,0),2>' AS CIRCLE)
----
1  0

# Containment circle @> point (inclusive of the boundary): (3,4) is on the radius-5 circle → in;
# (3,5) is outside.
query II
SELECT
  CAST('<(0,0),5>' AS CIRCLE) @> CAST('(3,4)' AS POINT),
  CAST('<(0,0),5>' AS CIRCLE) @> CAST('(3,5)' AS POINT)
----
1  0

# Containment circle @> circle: the outer fully covers the inner.
query I
SELECT CAST('<(0,0),5>' AS CIRCLE) @> CAST('<(0,0),2>' AS CIRCLE)
----
1

# point <@ circle and circle <@ circle are the mirror of @>.
query II
SELECT
  CAST('(3,4)' AS POINT) <@ CAST('<(0,0),5>' AS CIRCLE),
  CAST('<(0,0),2>' AS CIRCLE) <@ CAST('<(0,0),5>' AS CIRCLE)
----
1  1

# Same-as (~=): equal by center and radius.
query II
SELECT
  CAST('<(0,0),2>' AS CIRCLE) ~= CAST('<(0,0),2>' AS CIRCLE),
  CAST('<(0,0),2>' AS CIRCLE) ~= CAST('<(1,0),2>' AS CIRCLE)
----
1  0

# ── lseg ────────────────────────────────────────────────────────────────────────────────────
# An lseg is a line segment between two endpoints, canonical form [(x1,y1),(x2,y2)]. Unlike a box,
# the endpoint order is PRESERVED (no normalization).

statement ok
CREATE TABLE seg (id INT NOT NULL, s LSEG)

# Implicit text coercion: canonical [(..),(..)], the paren form ((..),(..)), and the bare x1,y1,x2,y2.
statement ok
INSERT INTO seg VALUES (1, '[(1.5,2.5),(3.5,4.5)]')

statement ok
INSERT INTO seg VALUES (2, '((1,2),(3,4))')

statement ok
INSERT INTO seg VALUES (3, '5,6,7,8')

# Endpoint order is preserved verbatim — a reversed segment stays reversed (a box would normalize).
statement ok
INSERT INTO seg VALUES (4, '[(3,4),(1,2)]')

# Canonical output: [(x1,y1),(x2,y2)], regardless of the accepted input form, order intact.
query IT rowsort
SELECT id, s FROM seg
----
1  [(1.5,2.5),(3.5,4.5)]
2  [(1,2),(3,4)]
3  [(5,6),(7,8)]
4  [(3,4),(1,2)]

# An explicit CAST from text parses the same way; a malformed string is a loud error.
query T
SELECT CAST('[(3,4),(1,2)]' AS LSEG)
----
[(3,4),(1,2)]

statement error
SELECT CAST('abc' AS LSEG)

statement error
SELECT CAST('[(1,2)]' AS LSEG)

statement error
SELECT CAST('[(1,2),(3,4),(5,6)]' AS LSEG)

# length(lseg) = the Euclidean distance between the two endpoints.
query RR
SELECT length(CAST('[(0,0),(3,4)]' AS LSEG)), length(CAST('[(0,0),(0,7)]' AS LSEG))
----
5.000  7.000

# lseg <-> point: distance to the nearest point on the segment. When the projected foot lies beyond
# an endpoint, the nearer endpoint is used; otherwise the perpendicular distance.
query RRRR
SELECT
  CAST('[(0,0),(4,0)]' AS LSEG) <-> CAST('(6,0)' AS POINT),
  CAST('[(0,0),(4,0)]' AS LSEG) <-> CAST('(2,3)' AS POINT),
  CAST('[(0,0),(4,4)]' AS LSEG) <-> CAST('(4,0)' AS POINT),
  CAST('[(0,0),(0,4)]' AS LSEG) <-> CAST('(3,0)' AS POINT)
----
2.000  3.000  2.828  3.000

# lseg <-> lseg: 0 when the segments intersect, else the minimum endpoint-to-segment gap. Cases:
# crossing (0), parallel (3), skew (sqrt 5), and collinear-apart (endpoint gap 4).
query RRRR
SELECT
  CAST('[(0,0),(2,2)]' AS LSEG) <-> CAST('[(0,2),(2,0)]' AS LSEG),
  CAST('[(0,0),(4,0)]' AS LSEG) <-> CAST('[(0,3),(4,3)]' AS LSEG),
  CAST('[(0,0),(1,0)]' AS LSEG) <-> CAST('[(3,1),(3,5)]' AS LSEG),
  CAST('[(0,0),(1,0)]' AS LSEG) <-> CAST('[(5,0),(6,0)]' AS LSEG)
----
0.000  3.000  2.236  4.000

# lseg # lseg: the intersection point when the segments cross or touch at a single point.
query T
SELECT CAST('[(0,0),(2,2)]' AS LSEG) # CAST('[(0,2),(2,0)]' AS LSEG)
----
(1,1)

query T
SELECT CAST('[(0,0),(4,2)]' AS LSEG) # CAST('[(0,2),(4,0)]' AS LSEG)
----
(2,1)

# Touch at a shared endpoint is a single-point intersection.
query T
SELECT CAST('[(0,0),(2,0)]' AS LSEG) # CAST('[(2,0),(2,2)]' AS LSEG)
----
(2,0)

# Collinear overlap returns NULL (the reference engine does not report a point for a collinear pair).
query T
SELECT CAST('[(0,0),(2,0)]' AS LSEG) # CAST('[(1,0),(3,0)]' AS LSEG)
----
NULL

# Disjoint parallel segments do not intersect.
query T
SELECT CAST('[(0,0),(1,0)]' AS LSEG) # CAST('[(0,2),(1,2)]' AS LSEG)
----
NULL

# Guard: with no geometry operand, `#` remains the integer bitwise XOR (5 ^ 3 = 6), unaffected by the
# lseg-intersection routing above.
query I
SELECT 5 # 3
----
6

# ── line ────────────────────────────────────────────────────────────────────────────────────
# A line is an INFINITE line A·x + B·y + C = 0, canonical form {A,B,C}. The three-coefficient input
# {A,B,C} is stored VERBATIM (no normalization); a two-point input is converted to coefficients.

statement ok
CREATE TABLE lin (id INT NOT NULL, l LINE)

# Coefficient form {A,B,C}, stored verbatim — including a non-reduced {2,-2,0} that stays {2,-2,0}.
statement ok
INSERT INTO lin VALUES (1, '{1,-1,0}')

statement ok
INSERT INTO lin VALUES (2, '{2,-2,0}')

# Two-point forms convert to coefficients via line_construct: slanted, vertical, and horizontal.
statement ok
INSERT INTO lin VALUES (3, '[(1,2),(3,4)]')

statement ok
INSERT INTO lin VALUES (4, '[(0,0),(1,1)]')

statement ok
INSERT INTO lin VALUES (5, '[(2,0),(2,5)]')

statement ok
INSERT INTO lin VALUES (6, '[(0,3),(5,3)]')

# Canonical output {A,B,C}: verbatim coefficients preserved, two-point rows rendered as coefficients.
query IT rowsort
SELECT id, l FROM lin
----
1  {1,-1,0}
2  {2,-2,0}
3  {1,-1,1}
4  {1,-1,0}
5  {-1,0,2}
6  {0,-1,3}

# An explicit CAST from text parses the same way; a malformed or wrong-arity string is a loud error.
query T
SELECT CAST('{2,-2,0}' AS LINE)
----
{2,-2,0}

statement error
SELECT CAST('abc' AS LINE)

statement error
SELECT CAST('{1,2}' AS LINE)

statement error
SELECT CAST('{1,2,3,4,5}' AS LINE)

# A degenerate line is rejected: {A,B,C} with A and B both zero is not a line.
statement error
SELECT CAST('{0,0,5}' AS LINE)

# A two-point line whose points coincide has no unique line through it.
statement error
SELECT CAST('[(2,2),(2,2)]' AS LINE)

# line <-> point: perpendicular distance |A·px + B·py + C| / sqrt(A² + B²). A point on the line is 0.
query RRR
SELECT
  CAST('{1,-1,0}' AS LINE) <-> CAST('(0,2)' AS POINT),
  CAST('{1,-1,0}' AS LINE) <-> CAST('(3,3)' AS POINT),
  CAST('{-1,0,2}' AS LINE) <-> CAST('(5,7)' AS POINT)
----
1.414  0.000  3.000

# line <-> line: 0 when they cross, else the constant perpendicular gap (scale-invariant, so the
# differently scaled {2,-2,4} still reports the same gap as {1,-1,2}).
query RRR
SELECT
  CAST('{1,-1,0}' AS LINE) <-> CAST('{1,1,0}' AS LINE),
  CAST('{1,-1,0}' AS LINE) <-> CAST('{1,-1,2}' AS LINE),
  CAST('{1,-1,0}' AS LINE) <-> CAST('{2,-2,4}' AS LINE)
----
0.000  1.414  1.414

# line # line: the crossing point of two infinite lines.
query T
SELECT CAST('{1,-1,0}' AS LINE) # CAST('{1,1,0}' AS LINE)
----
(0,0)

# Two-point-constructed lines cross at their common point.
query T
SELECT CAST('[(0,0),(4,4)]' AS LINE) # CAST('[(0,4),(4,0)]' AS LINE)
----
(2,2)

# Parallel lines never meet — the intersection is NULL.
query T
SELECT CAST('{1,-1,0}' AS LINE) # CAST('{1,-1,5}' AS LINE)
----
NULL

# ── path ────────────────────────────────────────────────────────────────────────────────────
# A path is an ordered list of vertices, either an OPEN polyline `[(x1,y1),…]` or a CLOSED loop
# `((x1,y1),…)`. The open/closed flag comes from the input's first delimiter: `[` opens, a `(` or a
# bare coordinate closes.

statement ok
CREATE TABLE pth (id INT NOT NULL, p PATH)

# Open (bracketed), closed (parenthesized), bare (→ closed), and single-vertex forms.
statement ok
INSERT INTO pth VALUES (1, '[(0,0),(1,1),(2,0)]')

statement ok
INSERT INTO pth VALUES (2, '((0,0),(1,1),(2,0))')

statement ok
INSERT INTO pth VALUES (3, '(0,0),(1,1),(2,0)')

statement ok
INSERT INTO pth VALUES (4, '[(5,5)]')

statement ok
INSERT INTO pth VALUES (5, '[(0,0),(3,0),(3,4)]')

statement ok
INSERT INTO pth VALUES (6, '((0,0),(3,0),(3,4))')

statement ok
INSERT INTO pth VALUES (7, '((0,0),(1,1),(2,0),(3,3))')

# Canonical output: open keeps its brackets, closed and bare render with parentheses.
query IT
SELECT id, p FROM pth ORDER BY id
----
1  [(0,0),(1,1),(2,0)]
2  ((0,0),(1,1),(2,0))
3  ((0,0),(1,1),(2,0))
4  [(5,5)]
5  [(0,0),(3,0),(3,4)]
6  ((0,0),(3,0),(3,4))
7  ((0,0),(1,1),(2,0),(3,3))

# An explicit CAST from text parses the same way; a bare coordinate list becomes a closed path.
query T
SELECT CAST('(0,0),(1,1),(2,0)' AS PATH)
----
((0,0),(1,1),(2,0))

# npoints() counts the vertices.
query I
SELECT npoints(p) FROM pth WHERE id = 1
----
3

query I
SELECT npoints(p) FROM pth WHERE id = 7
----
4

# length() sums the inter-vertex segments; a CLOSED path also adds the closing segment back to the
# first vertex (id 5 open = 7, id 6 same vertices closed = 12), and a single-vertex path is 0.
query R
SELECT length(p) FROM pth WHERE id = 5
----
7.000

query R
SELECT length(p) FROM pth WHERE id = 6
----
12.000

query R
SELECT length(p) FROM pth WHERE id = 4
----
0.000

# isopen()/isclosed() report the flag (rendered 1/0). An open path is open; a closed path is closed.
query TT
SELECT isopen(p), isclosed(p) FROM pth WHERE id = 1
----
1  0

query TT
SELECT isopen(p), isclosed(p) FROM pth WHERE id = 2
----
0  1

# path + path: two OPEN paths concatenate into one OPEN path (the second's vertices appended).
query T
SELECT CAST('[(0,0),(1,1)]' AS PATH) + CAST('[(2,2),(3,3)]' AS PATH)
----
[(0,0),(1,1),(2,2),(3,3)]

query T
SELECT CAST('[(0,0),(1,1)]' AS PATH) + CAST('[(2,2)]' AS PATH)
----
[(0,0),(1,1),(2,2)]

# If EITHER operand is CLOSED, the concatenation is NULL.
query T
SELECT (CAST('((0,0),(1,1))' AS PATH) + CAST('[(2,2)]' AS PATH)) IS NULL
----
1

# A malformed path — an empty string or an odd coordinate count (a dangling half-vertex) — is a loud
# error, not a silently truncated value.
statement error
SELECT CAST('' AS PATH)

statement error
SELECT CAST('[(0,0),(1)]' AS PATH)

statement error
SELECT CAST('abc' AS PATH)

# ── polygon ─────────────────────────────────────────────────────────────────────────────────
# A polygon is an ordered vertex list forming a closed loop, written `((x1,y1),…)`. Unlike a path
# there is no open form — the bracketed `[(…)]` spelling is rejected.

statement ok
CREATE TABLE pgn (id INT NOT NULL, g POLYGON)

# Canonical (parenthesized), bare (→ parens added), and single-vertex forms.
statement ok
INSERT INTO pgn VALUES (1, '((0,0),(4,0),(4,4),(0,4))')

statement ok
INSERT INTO pgn VALUES (2, '(0,0),(4,0),(4,4),(0,4)')

statement ok
INSERT INTO pgn VALUES (3, '((5,5))')

statement ok
INSERT INTO pgn VALUES (4, '((0,0),(4,0),(4,4))')

# Canonical output: the bare form gains parentheses; the parenthesized form is unchanged.
query IT
SELECT id, g FROM pgn ORDER BY id
----
1  ((0,0),(4,0),(4,4),(0,4))
2  ((0,0),(4,0),(4,4),(0,4))
3  ((5,5))
4  ((0,0),(4,0),(4,4))

# An explicit CAST from a bare coordinate list also gains parentheses.
query T
SELECT CAST('(0,0),(4,0),(4,4),(0,4)' AS POLYGON)
----
((0,0),(4,0),(4,4),(0,4))

# npoints() counts the vertices.
query I
SELECT npoints(g) FROM pgn WHERE id = 4
----
3

query I
SELECT npoints(g) FROM pgn WHERE id = 1
----
4

# polygon ~= polygon (poly_same): true for identical, a cyclic rotation, or a reversal of the same
# closed cycle; false for a different vertex count, a same-bounding-box different shape, or a
# translation.
# Identical.
query I
SELECT CAST('((0,0),(4,0),(4,4))' AS POLYGON) ~= CAST('((0,0),(4,0),(4,4))' AS POLYGON)
----
1

# Cyclic rotation.
query I
SELECT CAST('((0,0),(4,0),(4,4))' AS POLYGON) ~= CAST('((4,0),(4,4),(0,0))' AS POLYGON)
----
1

# Reversal.
query I
SELECT CAST('((0,0),(4,0),(4,4))' AS POLYGON) ~= CAST('((4,4),(4,0),(0,0))' AS POLYGON)
----
1

# Different vertex count.
query I
SELECT CAST('((0,0),(4,0),(4,4),(0,4))' AS POLYGON) ~= CAST('((0,0),(4,4),(0,4))' AS POLYGON)
----
0

# Same bounding box, different shape (same four vertices in a non-cyclic order).
query I
SELECT CAST('((0,0),(4,0),(4,4),(0,4))' AS POLYGON) ~= CAST('((0,0),(4,4),(4,0),(0,4))' AS POLYGON)
----
0

# Translation.
query I
SELECT CAST('((0,0),(4,0),(4,4))' AS POLYGON) ~= CAST('((1,1),(5,1),(5,5))' AS POLYGON)
----
0

# A malformed polygon is a loud error: the path OPEN form `[…]`, an empty string, or an odd
# coordinate count (a dangling half-vertex).
statement error
SELECT CAST('[(0,0),(1,1),(2,0)]' AS POLYGON)

statement error
SELECT CAST('' AS POLYGON)

statement error
SELECT CAST('((0,0),(1))' AS POLYGON)
