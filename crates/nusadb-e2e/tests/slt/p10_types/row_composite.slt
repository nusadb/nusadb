# ROW(...) constructor and composite (row) types.
#
# A bare ROW(a, b, ...) builds an anonymous composite carried in the canonical `(v1,v2)` text form
# (field types inferred; a NULL field formats as empty; a field needing quotes gets them). A declared
# composite type (CREATE TYPE ... AS (...)) supports ROW(...)::T construction, the '(a,b)'::T text
# cast, storage in a table column, `(col).field` access — including in an UPDATE/DELETE WHERE — and
# composite comparison.

# Bare ROW: canonical text form, NULL field, quoting, nesting.
query T
SELECT ROW(1, 'a')
----
(1,a)

query T
SELECT ROW(1, NULL)
----
(1,)

query T
SELECT ROW(1, 'a b')
----
(1,"a b")

query T
SELECT ROW(1, ROW(2, 3))
----
(1,"(2,3)")

# ROW over table columns, and ROW = ROW comparison in a WHERE.
statement ok
CREATE TABLE rt (a INT, b TEXT)

statement ok
INSERT INTO rt VALUES (1, 'x'), (2, 'y')

query T
SELECT ROW(a, b) FROM rt ORDER BY a
----
(1,x)
(2,y)

query I
SELECT count(*) FROM rt WHERE ROW(a, b) = ROW(1, 'x')
----
1

# A declared composite type: construction, text cast, storage, field access.
statement ok
CREATE TYPE pair AS (x INT, y TEXT)

statement ok
CREATE TABLE ct (id INT, p pair)

statement ok
INSERT INTO ct VALUES (1, ROW(7, 'seven')::pair), (2, '(8,eight)'::pair)

query T
SELECT p FROM ct ORDER BY id
----
(7,seven)
(8,eight)

query I
SELECT (p).x FROM ct ORDER BY id
----
7
8

query T
SELECT (ROW(9, 'nine')::pair).y
----
nine

# Field access works in an UPDATE / DELETE WHERE exactly as in a SELECT.
statement ok
UPDATE ct SET p = ROW(70, 'seventy')::pair WHERE (p).x = 7

query T
SELECT (p).y FROM ct ORDER BY id
----
seventy
eight

statement ok
DELETE FROM ct WHERE (p).x = 8

query I
SELECT count(*) FROM ct
----
1

# An anonymous record's fields are named f1..fN; an out-of-range ordinal is refused.
query I
SELECT (ROW(1, 'a')).f1
----
1

query T
SELECT (ROW(1, 'a')).f2
----
a

statement error could not identify column
SELECT (ROW(1, 'a')).f3

statement error could not identify column
SELECT (ROW(1, 'a')).x

statement ok
DROP TABLE rt

statement ok
DROP TABLE ct

# `(x).*` expands a composite value into one column per field, named after the field.
statement ok
CREATE TYPE pt AS (x INT, y TEXT)

statement ok
CREATE TABLE cs (id INT, p pt)

statement ok
INSERT INTO cs VALUES (1, ROW(3, 'three')::pt), (2, ROW(4, 'four')::pt)

query IIT rowsort
SELECT id, (p).* FROM cs
----
1 3 three
2 4 four

query IT
SELECT (CAST('(5,five)' AS pt)).*
----
5 five

query IT
SELECT (ROW(6, 'six')).*
----
6 six

statement error SELECT-list item
SELECT id FROM cs WHERE (p).* IS NULL

statement error cannot take an alias
SELECT (p).* AS z FROM cs

statement error known composite type
SELECT (id).* FROM cs

# Composite type definitions are listed in information_schema, fields numbered in declared order.
query TTITT
SELECT udt_schema, attribute_name, ordinal_position, data_type, is_nullable FROM information_schema.attributes WHERE udt_name = 'pt' ORDER BY ordinal_position
----
public x 1 integer YES
public y 2 text YES

query TTT
SELECT user_defined_type_schema, user_defined_type_name, user_defined_type_category FROM information_schema.user_defined_types WHERE user_defined_type_name = 'pt'
----
public pt STRUCTURED

statement ok
DROP TABLE cs

statement ok
DROP TYPE pt

query I
SELECT count(*) FROM information_schema.attributes WHERE udt_name = 'pt'
----
0

# A field literally named `*` is reached with the quoted `(v)."*"`, an ordinary field access in a
# SELECT list and anywhere else; only the unquoted `(v).*` expands.
statement ok
CREATE TYPE star AS ("*" INT, b INT)

statement ok
CREATE TABLE st (id INT, v star)

statement ok
INSERT INTO st VALUES (1, ROW(7, 8)::star), (2, ROW(9, 10)::star)

query I
SELECT (v)."*" FROM st ORDER BY id
----
7
9

query I
SELECT id FROM st WHERE (v)."*" = 9
----
2

query II
SELECT (v).* FROM st WHERE id = 1
----
7 8

statement ok
DROP TABLE st

statement ok
DROP TYPE star

# A positional ORDER BY counts output columns, after `(p).*` has expanded. A positional GROUP BY
# counts SELECT-list items as written, so it reaches the unexpanded `(p).*` and is refused.
statement ok
CREATE TYPE gq AS (x INT, y INT)

statement ok
CREATE TABLE gt (k INT, p gq)

statement ok
INSERT INTO gt VALUES (1, ROW(1,2)::gq), (2, ROW(3,4)::gq)

statement error SELECT-list item
SELECT (p).*, count(*) FROM gt GROUP BY 1

query III
SELECT gt.k, (p).* FROM gt ORDER BY 2 DESC
----
2 3 4
1 1 2

query III
SELECT (p).*, gt.k FROM gt ORDER BY 2 DESC
----
3 4 2
1 2 1

statement ok
DROP TABLE gt

statement ok
DROP TYPE gq
