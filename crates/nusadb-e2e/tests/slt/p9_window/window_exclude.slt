# p9_window/window_exclude — the window-frame EXCLUDE clause: EXCLUDE {NO OTHERS | CURRENT ROW |
# GROUP | TIES}. The frame bounds first select the frame rows; EXCLUDE then drops rows from that
# selection. Peers are rows sharing the current row's ORDER BY value (with no ORDER BY, every row in
# the partition is a peer of every other). An empty frame after exclusion yields the aggregate of an
# empty input (SUM → NULL, COUNT → 0). Every expected value was cross-checked against a reference
# engine.

statement ok
CREATE TABLE t (id INT NOT NULL, g INT, v INT)

# Rows 2 and 3 are peers (both v = 20) within partition g = 1.
statement ok
INSERT INTO t VALUES (1, 1, 10), (2, 1, 20), (3, 1, 20), (4, 1, 40), (5, 2, 5)

# =====================================================================================
# Truth table over PARTITION BY g ORDER BY v ROWS BETWEEN UNBOUNDED PRECEDING AND
# UNBOUNDED FOLLOWING (the whole partition), for SUM(v):
#   id v | NO OTHERS | CURRENT ROW | GROUP | TIES
#   1 10 |    90     |     80      |  80   |  90
#   2 20 |    90     |     70      |  50   |  70
#   3 20 |    90     |     70      |  50   |  70
#   4 40 |    90     |     50      |  50   |  90
#   5  5 |     5     |    NULL     | NULL  |   5
# =====================================================================================

# --- No EXCLUDE clause: the baseline whole-partition sum (default = NO OTHERS). ---
query II
SELECT id, SUM(v) OVER (PARTITION BY g ORDER BY v ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) FROM t ORDER BY id
----
1 90
2 90
3 90
4 90
5 5

# --- EXCLUDE NO OTHERS is exactly the default: identical to the query above. ---
query II
SELECT id, SUM(v) OVER (PARTITION BY g ORDER BY v ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING EXCLUDE NO OTHERS) FROM t ORDER BY id
----
1 90
2 90
3 90
4 90
5 5

# --- EXCLUDE CURRENT ROW: drop the current row; the single-row partition (id 5) empties to NULL. ---
query II
SELECT id, SUM(v) OVER (PARTITION BY g ORDER BY v ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING EXCLUDE CURRENT ROW) FROM t ORDER BY id
----
1 80
2 70
3 70
4 50
5 NULL

# --- EXCLUDE GROUP: drop the current row and its peers; rows 2 and 3 lose both v=20 rows. ---
query II
SELECT id, SUM(v) OVER (PARTITION BY g ORDER BY v ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING EXCLUDE GROUP) FROM t ORDER BY id
----
1 80
2 50
3 50
4 50
5 NULL

# --- EXCLUDE TIES: drop the peers but keep the current row; rows 2 and 3 keep their own v=20. ---
query II
SELECT id, SUM(v) OVER (PARTITION BY g ORDER BY v ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING EXCLUDE TIES) FROM t ORDER BY id
----
1 90
2 70
3 70
4 90
5 5

# --- COUNT over the excluded frame: an empty frame counts 0 (not NULL). id 5's group empties. ---
query II
SELECT id, COUNT(v) OVER (PARTITION BY g ORDER BY v ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING EXCLUDE GROUP) FROM t ORDER BY id
----
1 3
2 2
3 2
4 3
5 0

# =====================================================================================
# Association correctness: two window functions in ONE statement, each with a DIFFERENT
# EXCLUDE mode. Column a = EXCLUDE GROUP, column b = EXCLUDE TIES. They diverge at ids 1
# and 4 (unique v values), which a swapped association would get wrong.
# =====================================================================================
query III
SELECT id,
       SUM(v) OVER (PARTITION BY g ORDER BY v ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING EXCLUDE GROUP) AS a,
       SUM(v) OVER (PARTITION BY g ORDER BY v ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING EXCLUDE TIES) AS b
FROM t ORDER BY id
----
1 80 90
2 50 70
3 50 70
4 50 90
5 NULL 5

# =====================================================================================
# No ORDER BY: every row in the partition is a peer of every other, so GROUP excludes the
# whole partition and TIES excludes everything but the current row.
# =====================================================================================

# --- EXCLUDE GROUP with no ORDER BY: whole partition is one peer group ⇒ every frame empties. ---
query II
SELECT id, SUM(v) OVER (PARTITION BY g ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING EXCLUDE GROUP) FROM t ORDER BY id
----
1 NULL
2 NULL
3 NULL
4 NULL
5 NULL

# --- EXCLUDE TIES with no ORDER BY: peers are the whole partition, so each frame keeps only self. ---
query II
SELECT id, SUM(v) OVER (PARTITION BY g ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING EXCLUDE TIES) FROM t ORDER BY id
----
1 10
2 20
3 20
4 40
5 5

# --- EXCLUDE CURRENT ROW with no ORDER BY: only the current row leaves (peers untouched). ---
query II
SELECT id, SUM(v) OVER (PARTITION BY g ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING EXCLUDE CURRENT ROW) FROM t ORDER BY id
----
1 80
2 70
3 70
4 50
5 NULL

# =====================================================================================
# A bounded moving frame combined with EXCLUDE: ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING,
# EXCLUDE CURRENT ROW over the whole (single-partition) table ordered by id. Each row sums
# its immediate neighbours only. Ends have one neighbour; interior rows have two.
#   id v : neighbours summed
#    1 10 : v(2)=20                 -> 20
#    2 20 : v(1)+v(3)=10+20         -> 30
#    3 20 : v(2)+v(4)=20+40         -> 60
#    4 40 : v(3)+v(5)=20+5          -> 25
#    5  5 : v(4)=40                 -> 40
# =====================================================================================
query II
SELECT id, SUM(v) OVER (ORDER BY id ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING EXCLUDE CURRENT ROW) FROM t ORDER BY id
----
1 20
2 30
3 60
4 25
5 40

# =====================================================================================
# Rejections (loud, never silent-wrong).
# =====================================================================================

# --- EXCLUDE with no frame clause is rejected (a frame is required). ---
statement error
SELECT id, SUM(v) OVER (PARTITION BY g EXCLUDE TIES) FROM t

# --- EXCLUDE on a non-aggregate window function is rejected rather than silently ignored. ---
statement error
SELECT id, ROW_NUMBER() OVER (ORDER BY v ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW EXCLUDE TIES) FROM t
