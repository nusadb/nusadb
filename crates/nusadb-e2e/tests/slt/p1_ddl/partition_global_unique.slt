statement ok
CREATE TABLE sp_1_a PARTITION OF sp_1 FOR VALUES IN ('a')

statement ok
CREATE TABLE sp_1_b PARTITION OF sp_1 FOR VALUES IN ('b')

statement ok
CREATE TABLE sp_2 PARTITION OF sp FOR VALUES FROM (100) TO (200)

statement ok
