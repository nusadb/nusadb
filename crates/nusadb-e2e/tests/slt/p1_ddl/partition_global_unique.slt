# A detached table keeps its own key; its rows no longer count for the parent's.
statement ok
ALTER TABLE ad DETACH PARTITION ad_3

statement ok
INSERT INTO ad VALUES (3, 20)

statement error duplicate key
INSERT INTO ad_3 VALUES (3, 999)

# --- Refused key types --------------------------------------------------------------------------

statement error not supported for the floating-point or NUMERIC column
