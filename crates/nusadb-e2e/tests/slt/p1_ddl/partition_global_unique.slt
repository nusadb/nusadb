# --- ON UPDATE CASCADE / ON DELETE SET NULL rewrite a unique key -------------------------------

# A composite key with a NULL part references nothing, so another row may hold a value the
# cascade then copies into the unique column.
statement ok
CREATE TABLE cpar (a INT, b INT, PRIMARY KEY (a, b))

statement ok
INSERT INTO cpar VALUES (1, 1)

# A key across partitions.
statement ok
CREATE TABLE cch (a INT, b INT, d INT NOT NULL, UNIQUE (a), FOREIGN KEY (a, b) REFERENCES cpar (a, b) ON UPDATE CASCADE) PARTITION BY LIST (d)

statement ok
CREATE TABLE cch_1 PARTITION OF cch FOR VALUES IN (1)

statement ok
CREATE TABLE cch_2 PARTITION OF cch FOR VALUES IN (2)

statement ok
INSERT INTO cch VALUES (1, 1, 1), (2, NULL, 2)

statement error duplicate key violates unique constraint
UPDATE cpar SET a = 2 WHERE a = 1

statement ok
UPDATE cpar SET a = 10 WHERE a = 1

query III rowsort
SELECT a, b, d FROM cch
----
10 1 1
2 NULL 2

# The same on a plain table.
statement ok
CREATE TABLE lch (a INT, b INT, UNIQUE (a), FOREIGN KEY (a, b) REFERENCES cpar (a, b) ON UPDATE CASCADE)

statement ok
INSERT INTO lch VALUES (10, 1), (3, NULL)

statement error duplicate key violates unique constraint
UPDATE cpar SET a = 3 WHERE a = 10

query II rowsort
SELECT a, b FROM lch
----
10 1
3 NULL

