# --- Deferrable ------------------------------------------------------------------------------------

statement ok
CREATE TABLE dk (k INT NOT NULL, d INT NOT NULL, CONSTRAINT dk_k UNIQUE (k) DEFERRABLE INITIALLY DEFERRED) PARTITION BY RANGE (d)

statement ok
CREATE TABLE dk_1 PARTITION OF dk FOR VALUES FROM (0) TO (100)

statement ok
CREATE TABLE dk_2 PARTITION OF dk FOR VALUES FROM (100) TO (200)

statement ok
INSERT INTO dk VALUES (1, 10), (2, 110)

# A swap across partitions in two statements, valid at COMMIT.
statement ok
BEGIN

statement ok
UPDATE dk SET k = 2 WHERE d = 10

statement ok
UPDATE dk SET k = 1 WHERE d = 110

statement ok
COMMIT

query II rowsort
SELECT k, d FROM dk
----
1 110
2 10

# A duplicate still there at COMMIT fails it.
statement ok
BEGIN

statement ok
INSERT INTO dk VALUES (1, 20)

statement error duplicate key violates unique constraint "dk_k"
COMMIT

query I
SELECT count(*) FROM dk
----
2

# SET CONSTRAINTS ... IMMEDIATE checks what is queued.
statement ok
BEGIN

statement ok
INSERT INTO dk VALUES (1, 30)

statement error duplicate key violates unique constraint "dk_k"
SET CONSTRAINTS dk_k IMMEDIATE

statement ok
ROLLBACK
