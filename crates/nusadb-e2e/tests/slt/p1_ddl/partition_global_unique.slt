statement error not supported with NULLS NOT DISTINCT
CREATE TABLE bnd (k INT, d INT NOT NULL, UNIQUE NULLS NOT DISTINCT (k)) PARTITION BY RANGE (d)

# A covering key with those types stays allowed.
statement ok
CREATE TABLE bok (k NUMERIC NOT NULL, d INT NOT NULL, UNIQUE (k, d)) PARTITION BY RANGE (d)

# NULL keys never conflict.
statement ok
CREATE TABLE nk (k INT, d INT NOT NULL, UNIQUE (k)) PARTITION BY RANGE (d)

statement ok
