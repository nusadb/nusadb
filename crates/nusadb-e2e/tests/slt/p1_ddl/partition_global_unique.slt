# A PRIMARY KEY / UNIQUE on a partitioned table that leaves out a partitioning column is enforced
# across every partition below the table: no two rows of any partitions may share a key.

# --- The fact table: a uuid key over a table partitioned by time -----------------------------

statement ok
CREATE TABLE ev (id UUID PRIMARY KEY, created_at TIMESTAMP NOT NULL, v TEXT) PARTITION BY RANGE (created_at)

statement ok
CREATE TABLE ev_01 PARTITION OF ev FOR VALUES FROM ('2026-01-01') TO ('2026-02-01')

statement ok
CREATE TABLE ev_02 PARTITION OF ev FOR VALUES FROM ('2026-02-01') TO ('2026-03-01')

statement ok
CREATE TABLE ev_def PARTITION OF ev DEFAULT

statement ok
INSERT INTO ev VALUES ('00000000-0000-0000-0000-000000000001', '2026-01-05', 'a')

# The same key in another partition, through the parent or directly.
statement error duplicate key violates primary key constraint "ev_pkey"
INSERT INTO ev VALUES ('00000000-0000-0000-0000-000000000001', '2026-02-05', 'b')

statement error duplicate key violates primary key constraint "ev_pkey"
INSERT INTO ev_02 VALUES ('00000000-0000-0000-0000-000000000001', '2026-02-05', 'b')

statement error duplicate key violates primary key constraint "ev_pkey"
INSERT INTO ev_def VALUES ('00000000-0000-0000-0000-000000000001', '2027-01-01', 'b')

# Two rows of one statement routed to different partitions.
statement error duplicate key violates primary key constraint "ev_pkey"
INSERT INTO ev VALUES ('00000000-0000-0000-0000-000000000002', '2026-01-05', 'x'), ('00000000-0000-0000-0000-000000000002', '2026-02-05', 'y')

query I
SELECT count(*) FROM ev
----
1

statement ok
INSERT INTO ev VALUES ('00000000-0000-0000-0000-000000000002', '2026-02-05', 'b'), ('00000000-0000-0000-0000-000000000003', '2026-03-05', 'c')

# --- UPDATE ---------------------------------------------------------------------------------------

# Onto a key held in another partition.
statement error duplicate key violates primary key constraint "ev_pkey"
UPDATE ev SET id = '00000000-0000-0000-0000-000000000001' WHERE v = 'b'

# A row moved to another partition keeps its key.
statement ok
UPDATE ev SET created_at = '2026-02-10' WHERE v = 'a'

query T
SELECT v FROM ev_02 ORDER BY v
----
a
b

statement ok
UPDATE ev SET created_at = '2026-01-10' WHERE v = 'a'

# Two keys swapped across partitions in one statement: the final state is valid.
statement ok
UPDATE ev SET id = CASE id WHEN '00000000-0000-0000-0000-000000000001'::uuid THEN '00000000-0000-0000-0000-000000000003'::uuid WHEN '00000000-0000-0000-0000-000000000003'::uuid THEN '00000000-0000-0000-0000-000000000001'::uuid END WHERE v IN ('a', 'c')

query TT rowsort
SELECT id, v FROM ev
----
00000000-0000-0000-0000-000000000001 c
00000000-0000-0000-0000-000000000002 b
00000000-0000-0000-0000-000000000003 a

# --- ON CONFLICT ----------------------------------------------------------------------------------

# DO NOTHING skips a key held in another partition.
statement ok
INSERT INTO ev VALUES ('00000000-0000-0000-0000-000000000001', '2026-01-20', 'skip') ON CONFLICT DO NOTHING

statement ok
INSERT INTO ev VALUES ('00000000-0000-0000-0000-000000000009', '2026-01-20', 'n1'), ('00000000-0000-0000-0000-000000000009', '2026-02-20', 'n2') ON CONFLICT DO NOTHING

query TT rowsort
SELECT id, v FROM ev WHERE v IN ('skip', 'n1', 'n2')
----
00000000-0000-0000-0000-000000000009 n1

# DO UPDATE updates the conflicting row in the partition that holds it.
statement ok
INSERT INTO ev VALUES ('00000000-0000-0000-0000-000000000001', '2026-01-20', 'up') ON CONFLICT (id) DO UPDATE SET v = EXCLUDED.v || '-' || ev.v

query TT
SELECT created_at, v FROM ev WHERE id = '00000000-0000-0000-0000-000000000001'
----
2026-03-05 00:00:00 up-c

query I
SELECT count(*) FROM ev
----
4

# Directly into a partition, the conflict is found in a sibling too.
statement ok
INSERT INTO ev_01 VALUES ('00000000-0000-0000-0000-000000000002', '2026-01-21', 'up2') ON CONFLICT (id) DO UPDATE SET v = EXCLUDED.v

query TT
SELECT created_at, v FROM ev WHERE id = '00000000-0000-0000-0000-000000000002'
----
2026-02-05 00:00:00 up2

statement error cannot affect one row a second time
INSERT INTO ev VALUES ('00000000-0000-0000-0000-000000000002', '2026-01-21', 'p'), ('00000000-0000-0000-0000-000000000002', '2026-02-21', 'q') ON CONFLICT (id) DO UPDATE SET v = EXCLUDED.v

# --- MERGE and INSERT ... SELECT ------------------------------------------------------------------

statement ok
CREATE TABLE src (id UUID, created_at TIMESTAMP, v TEXT)

statement ok
INSERT INTO src VALUES ('00000000-0000-0000-0000-000000000003', '2026-02-25', 'dup')

statement error duplicate key violates primary key constraint "ev_pkey"
INSERT INTO ev SELECT * FROM src

# MERGE targets a partition (a partitioned table itself is refused): the key is checked across
# the siblings.
statement error duplicate key violates primary key constraint "ev_pkey"
MERGE INTO ev_02 USING src ON ev_02.id = src.id WHEN NOT MATCHED THEN INSERT VALUES (src.id, src.created_at, src.v)

statement error MERGE into the partitioned table "ev" is not supported
MERGE INTO ev USING src ON ev.id = src.id WHEN NOT MATCHED THEN INSERT VALUES (src.id, src.created_at, src.v)

# --- A function body: the check runs at its own statement, so EXCEPTION catches it ---------------

statement ok
CREATE TABLE log (msg TEXT)

statement ok
CREATE PROCEDURE try_dup() AS $$
BEGIN
  INSERT INTO ev VALUES ('00000000-0000-0000-0000-000000000003', '2026-02-26', 'f');
  INSERT INTO log VALUES ('inserted');
EXCEPTION WHEN OTHERS THEN
  INSERT INTO log VALUES ('caught');
END
$$

statement ok
CALL try_dup()

query T
SELECT msg FROM log
----
caught

# --- Sub-partitions ----------------------------------------------------------------------------

