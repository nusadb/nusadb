statement error duplicate key violates unique constraint "sp_k"
INSERT INTO sp VALUES (1, 150, 'z')

statement ok
INSERT INTO sp VALUES (2, 150, 'z')

# A key covering the top level but not a sub-partitioned level is enforced across that level.
statement ok
