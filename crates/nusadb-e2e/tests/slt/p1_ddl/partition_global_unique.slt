# CHECK constraints see the stored value on INSERT and on UPDATE alike.
statement ok
CREATE TABLE u3 (k CHAR(4), CHECK (k || '|' = 'x|'))

statement ok
INSERT INTO u3 VALUES ('x  ')

statement ok
UPDATE u3 SET k = 'x '

statement error check
UPDATE u3 SET k = 'y'

# Generated columns are computed from the stored value too, on INSERT and on UPDATE.
statement ok
CREATE TABLE u4 (id INT, k CHAR(4), g TEXT GENERATED ALWAYS AS (k || '|') STORED)

statement ok
INSERT INTO u4 (id, k) VALUES (1, 'ab  '), (2, 'ab')

statement ok
UPDATE u4 SET k = 'cd  ' WHERE id = 2

query ITT rowsort
SELECT id, k || '|', g FROM u4
----
1 ab| ab|
2 cd| cd|

