# DROP SCHEMA ... CASCADE drops every object in the schema the way its own DROP ... CASCADE does:
# foreign keys in both directions across the schema boundary, views, standalone and owned
# sequences, partitions in either direction, triggers, comments, deferral
# and ON DELETE SET column lists. RESTRICT (the default) refuses a schema that holds anything.

# --- a foreign key from a member table into a table outside the schema ---
statement ok
CREATE TABLE par (id INT PRIMARY KEY)

statement ok
INSERT INTO par VALUES (1), (2), (3)

statement ok
CREATE SCHEMA s

statement ok
CREATE TABLE s.ch (id INT PRIMARY KEY, pid INT REFERENCES par ON DELETE CASCADE)

statement ok
INSERT INTO s.ch VALUES (1, 1)

statement error cannot drop schema "s": it holds 1 table\(s\)
DROP SCHEMA s

statement error cannot drop schema "s"
DROP SCHEMA s RESTRICT

statement ok
DROP SCHEMA s CASCADE

# The parent no longer carries the dropped table's foreign key.
statement ok
DELETE FROM par WHERE id = 1

query I
SELECT id FROM par ORDER BY id
----
2
3

# The names the dropped table held (its table, index and constraint names) are free again.
statement ok
CREATE SCHEMA s

statement ok
CREATE TABLE s.ch (id INT PRIMARY KEY, pid INT REFERENCES par ON DELETE CASCADE)

statement ok
INSERT INTO s.ch VALUES (2, 2)

statement ok
DELETE FROM par WHERE id = 2

query I
SELECT COUNT(*) FROM s.ch
----
0

statement ok
DROP SCHEMA s CASCADE

# --- a foreign key from a table outside the schema into a member table ---
statement ok
CREATE SCHEMA s

statement ok
CREATE TABLE s.p (id INT PRIMARY KEY)

statement ok
INSERT INTO s.p VALUES (1)

statement ok
CREATE TABLE oc (id INT, pid INT REFERENCES s.p)

statement ok
INSERT INTO oc VALUES (1, 1)

statement error cannot drop schema "s"
DROP SCHEMA s

# CASCADE drops the outside table's foreign key, never the table or its rows.
statement ok
DROP SCHEMA s CASCADE

statement ok
INSERT INTO oc VALUES (2, 99)

query II
SELECT id, pid FROM oc ORDER BY id
----
1 1
2 99

statement ok
DROP TABLE oc

# --- RESTRICT counts views and sequences too ---
statement ok
CREATE SCHEMA sv

statement ok
CREATE VIEW sv.v AS SELECT 1 AS x

statement error cannot drop schema "sv": it holds 1 view\(s\)
DROP SCHEMA sv

statement ok
CREATE SCHEMA sq

statement ok
CREATE SEQUENCE sq.q

statement error cannot drop schema "sq": it holds 1 sequence\(s\)
DROP SCHEMA sq

statement ok
DROP SCHEMA sv CASCADE

statement ok
DROP SCHEMA sq CASCADE

# Both names can be created again: nothing of the old schema stayed behind.
statement ok
CREATE SCHEMA sv

statement ok
CREATE VIEW sv.v AS SELECT 2 AS x

query I
SELECT x FROM sv.v
----
2

statement ok
CREATE SCHEMA sq

statement ok
CREATE SEQUENCE sq.q

query I
SELECT nextval('sq.q')
----
1

statement ok
DROP SCHEMA sv CASCADE

statement ok
DROP SCHEMA sq CASCADE

# --- a default-schema view or sequence whose name holds a dot is not a member of the schema the
# part before the dot names ---
statement ok
CREATE SCHEMA z

statement ok
CREATE VIEW public."z.v" AS SELECT 1 AS x

statement ok
CREATE SEQUENCE public."z.q"

# It does not hold z up under RESTRICT ...
statement ok
DROP SCHEMA z

statement ok
CREATE SCHEMA z

statement ok
CREATE VIEW z.w AS SELECT 2 AS y

statement ok
CREATE SEQUENCE z.r

# ... and only z's own view and sequence are counted ...
statement error cannot drop schema "z": it holds 1 view\(s\), 1 sequence\(s\)
DROP SCHEMA z

# ... and dropped.
statement ok
DROP SCHEMA z CASCADE

query I
SELECT x FROM "z.v"
----
1

query I
SELECT COUNT(*) FROM information_schema.sequences WHERE sequence_name = 'z.q'
----
1

statement ok
CREATE SCHEMA z

statement ok
CREATE VIEW z.w AS SELECT 3 AS y

statement ok
CREATE SEQUENCE z.r

statement ok
DROP SCHEMA z CASCADE

statement ok
DROP VIEW "z.v"

statement ok
DROP SEQUENCE "z.q"

# An empty schema drops under RESTRICT.
statement ok
CREATE SCHEMA e

statement ok
DROP SCHEMA e

# --- the sequences of SERIAL and identity columns go with their table ---
statement ok
CREATE SCHEMA s

statement ok
CREATE TABLE s.t (id SERIAL PRIMARY KEY, g INT GENERATED ALWAYS AS IDENTITY, v TEXT)

statement ok
INSERT INTO s.t (v) VALUES ('a'), ('b')

statement ok
DROP SCHEMA s CASCADE

statement ok
CREATE SCHEMA s

statement ok
CREATE TABLE s.t (id SERIAL PRIMARY KEY, g INT GENERATED ALWAYS AS IDENTITY, v TEXT)

statement ok
INSERT INTO s.t (v) VALUES ('c')

query II
SELECT id, g FROM s.t
----
1 1

statement ok
DROP SCHEMA s CASCADE

# --- a partition in the schema whose parent is outside it ---
statement ok
CREATE TABLE pp (k INT, v TEXT) PARTITION BY RANGE (k)

statement ok
CREATE SCHEMA s

statement ok
CREATE TABLE s.pp1 PARTITION OF pp FOR VALUES FROM (0) TO (10)

statement ok
CREATE TABLE pp2 PARTITION OF pp FOR VALUES FROM (10) TO (20)

statement ok
INSERT INTO pp VALUES (1, 'a'), (11, 'b')

statement ok
DROP SCHEMA s CASCADE

query I
SELECT k FROM pp ORDER BY k
----
11

statement error no partition
INSERT INTO pp VALUES (2, 'c')

statement ok
CREATE SCHEMA s

statement ok
CREATE TABLE s.pp1 PARTITION OF pp FOR VALUES FROM (0) TO (10)

statement ok
INSERT INTO pp VALUES (3, 'd')

query I
SELECT k FROM pp ORDER BY k
----
3
11

statement ok
DROP SCHEMA s CASCADE

statement ok
DROP TABLE pp

# --- a partitioned parent in the schema takes its partition outside the schema with it ---
statement ok
CREATE SCHEMA r

statement ok
CREATE TABLE r.qp (k INT) PARTITION BY RANGE (k)

statement ok
CREATE TABLE qp1 PARTITION OF r.qp FOR VALUES FROM (0) TO (10)

statement ok
INSERT INTO r.qp VALUES (1)

statement ok
DROP SCHEMA r CASCADE

statement error
SELECT * FROM qp1

statement ok
CREATE TABLE qp1 (k INT)

statement ok
DROP TABLE qp1

# --- triggers, comments, deferral and ON DELETE SET column lists of member tables ---
statement ok
CREATE TABLE log (what TEXT)

statement ok
CREATE TABLE par2 (id INT PRIMARY KEY, id2 INT, UNIQUE (id, id2))

statement ok
INSERT INTO par2 VALUES (1, 1), (2, 2), (3, 3)

statement ok
CREATE SCHEMA s

statement ok
CREATE TABLE s.ch (id INT PRIMARY KEY, pid INT, pid2 INT, CONSTRAINT chfk FOREIGN KEY (pid, pid2) REFERENCES par2 (id, id2) ON DELETE SET NULL (pid) DEFERRABLE INITIALLY DEFERRED)

statement ok
SET search_path = s, public

statement ok
CREATE TRIGGER ch_audit AFTER INSERT ON ch FOR EACH ROW INSERT INTO public.log (what) VALUES ('ins')

statement ok
SET search_path = public

statement ok
COMMENT ON TABLE s.ch IS 'children'

statement ok
COMMENT ON CONSTRAINT chfk ON s.ch IS 'to the parent'

statement ok
COMMENT ON SCHEMA s IS 'scratch'

statement ok
INSERT INTO s.ch VALUES (1, 1, 1)

query I
SELECT COUNT(*) FROM log
----
1

statement ok
DROP SCHEMA s CASCADE

query I
SELECT COUNT(*) FROM information_schema.nusadb_comments
----
0

statement ok
DELETE FROM par2 WHERE id = 1

statement ok
CREATE SCHEMA s

# Same table and constraint names, no column list, not deferrable, no trigger.
statement ok
CREATE TABLE s.ch (id INT PRIMARY KEY, pid INT, pid2 INT, CONSTRAINT chfk FOREIGN KEY (pid, pid2) REFERENCES par2 (id, id2) ON DELETE SET NULL)

statement ok
INSERT INTO s.ch VALUES (2, 2, 2)

query I
SELECT COUNT(*) FROM log
----
1

statement ok
DELETE FROM par2 WHERE id = 2

query ITT
SELECT id, pid, pid2 FROM s.ch
----
2 NULL NULL

statement ok
BEGIN

statement error foreign key
INSERT INTO s.ch VALUES (3, 9, 9)

statement ok
ROLLBACK

statement ok
DROP SCHEMA s CASCADE

# --- the whole DROP SCHEMA rolls back as one ---
statement ok
CREATE SCHEMA s

statement ok
CREATE TABLE s.ch (id INT PRIMARY KEY, pid INT REFERENCES par ON DELETE CASCADE)

statement ok
INSERT INTO s.ch VALUES (1, 3)

statement ok
CREATE VIEW s.v AS SELECT id FROM s.ch

statement ok
CREATE SEQUENCE s.q

statement ok
BEGIN

statement ok
DROP SCHEMA s CASCADE

statement ok
ROLLBACK

query I
SELECT id FROM s.v
----
1

query I
SELECT nextval('s.q')
----
1

# The restored foreign key still cascades.
statement ok
DELETE FROM par WHERE id = 3

query I
SELECT COUNT(*) FROM s.ch
----
0

statement ok
DROP SCHEMA s CASCADE

statement ok
DROP TABLE par2

statement ok
DROP TABLE par

statement ok
DROP TABLE log
