SELECT id, d, x, m FROM app.q ORDER BY id
----
1 1 q sad
2 1 q happy

# --- ATTACH and generated columns -----------------------------------------------------------------
# A table attached as a partition must compute the same columns as its parent: generated in one and
# not in the other is refused. It may compute one from an expression of its own, which its rows use
# however they are written.

statement ok
CREATE TABLE ag (a INT, d INT NOT NULL, g INT) PARTITION BY LIST (d)

statement ok
CREATE TABLE ag_g (a INT, d INT NOT NULL, g INT GENERATED ALWAYS AS (a * 2) STORED)

statement error must not be a generated column
ALTER TABLE ag ATTACH PARTITION ag_g FOR VALUES IN (1)

statement ok
CREATE TABLE bg (a INT, d INT NOT NULL, g INT GENERATED ALWAYS AS (a * 2) STORED) PARTITION BY LIST (d)

statement ok
CREATE TABLE bg1 PARTITION OF bg FOR VALUES IN (1)

statement ok
CREATE TABLE bg_n (a INT, d INT NOT NULL, g INT)

statement error must be a generated column
ALTER TABLE bg ATTACH PARTITION bg_n FOR VALUES IN (2)

statement ok
CREATE TABLE bg_x (a INT, d INT NOT NULL, g INT GENERATED ALWAYS AS (a * 3) STORED)

statement ok
ALTER TABLE bg ATTACH PARTITION bg_x FOR VALUES IN (2)

statement ok
INSERT INTO bg (a, d) VALUES (4, 2), (4, 1)

statement ok
INSERT INTO bg_x (a, d) VALUES (5, 2)

statement error generated column
INSERT INTO bg (a, d, g) VALUES (4, 2, 1)

# A row moved into bg_x takes bg_x's expression.
statement ok
UPDATE bg SET d = 2 WHERE d = 1

query III
SELECT a, d, g FROM bg ORDER BY a, g
----
4 2 12
4 2 12
5 2 15
