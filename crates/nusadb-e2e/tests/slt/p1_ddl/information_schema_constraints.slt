# p1_ddl/information_schema_constraints — table_constraints / key_column_usage / statistics
#. These views surface PK/UNIQUE/FK/CHECK constraints and indexes from the catalog so
# JDBC getPrimaryKeys / getIndexInfo (and DataGrip's schema tree) can introspect them.

statement ok
CREATE TABLE dept (id INT NOT NULL PRIMARY KEY, name TEXT)

statement ok
CREATE TABLE emp (id INT NOT NULL PRIMARY KEY, dept_id INT, email TEXT UNIQUE, age INT, FOREIGN KEY (dept_id) REFERENCES dept (id), CHECK (age >= 0))

statement ok
CREATE INDEX idx_emp_age ON emp (age)

# table_constraints: one row per declared constraint, by type.
query T
SELECT constraint_type FROM information_schema.table_constraints WHERE table_name = 'emp' ORDER BY constraint_type
----
CHECK
FOREIGN KEY
PRIMARY KEY
UNIQUE

# key_column_usage: one row per key column (CHECK has none). PK=id, UNIQUE=email, FK=dept_id.
query T
SELECT column_name FROM information_schema.key_column_usage WHERE table_name = 'emp' ORDER BY column_name
----
dept_id
email
id

# The exact pattern JDBC getPrimaryKeys uses: key columns of the PRIMARY KEY constraint.
query T
SELECT column_name FROM information_schema.key_column_usage
WHERE table_name = 'emp'
  AND constraint_name IN (
    SELECT constraint_name FROM information_schema.table_constraints
    WHERE table_name = 'emp' AND constraint_type = 'PRIMARY KEY'
  )
----
id

# statistics: the named secondary index over a non-unique column.
query IIT
SELECT non_unique, seq_in_index, column_name FROM information_schema.statistics
WHERE table_name = 'emp' AND index_name = 'idx_emp_age'
----
1 1 age

# Constraints of a table outside `public` are listed under the table's own schema, and a foreign
# key names the schema of the key it references. A column constraint keeps the name it was given.
statement ok
CREATE SCHEMA sales

statement ok
CREATE TABLE sales.region (id INT PRIMARY KEY, name TEXT CONSTRAINT region_name_ck CHECK (name <> ''))

statement ok
CREATE TABLE sales.store (id INT PRIMARY KEY, region INT CONSTRAINT store_region_fk REFERENCES sales.region (id))

# A same-named table in `public` with no constraints does not stand in for the one in `sales`.
statement ok
CREATE TABLE region (id INT)

query TTTT rowsort
SELECT constraint_schema, table_schema, table_name, constraint_type FROM information_schema.table_constraints WHERE table_schema = 'sales'
----
sales sales region CHECK
sales sales region PRIMARY KEY
sales sales store FOREIGN KEY
sales sales store PRIMARY KEY

query TT rowsort
SELECT table_name, column_name FROM information_schema.key_column_usage WHERE table_schema = 'sales'
----
region id
store id
store region

query TT
SELECT constraint_schema, unique_constraint_schema FROM information_schema.referential_constraints WHERE constraint_name = 'store_region_fk'
----
sales sales

query T
SELECT constraint_schema FROM information_schema.check_constraints WHERE constraint_name = 'region_name_ck'
----
sales

statement error violates check constraint "region_name_ck"
INSERT INTO sales.region VALUES (1, '')

statement ok
ALTER TABLE sales.region DROP CONSTRAINT region_name_ck

statement ok
INSERT INTO sales.region VALUES (1, '')

# A named column-level PRIMARY KEY or UNIQUE keeps its name too.
statement ok
CREATE TABLE nk (id INT CONSTRAINT nk_id PRIMARY KEY, e TEXT CONSTRAINT nk_e UNIQUE)

query TT rowsort
SELECT constraint_name, constraint_type FROM information_schema.table_constraints WHERE table_name = 'nk'
----
nk_e UNIQUE
nk_id PRIMARY KEY

statement ok
INSERT INTO nk VALUES (1, 'a')

statement error nk_id
INSERT INTO nk VALUES (1, 'b')

statement error nk_e
INSERT INTO nk VALUES (2, 'a')

statement error NULL assigned to NOT NULL
INSERT INTO nk VALUES (NULL, 'c')

statement ok
ALTER TABLE nk DROP CONSTRAINT nk_e

statement ok
INSERT INTO nk VALUES (2, 'a')

statement error PRIMARY KEY is not supported
ALTER TABLE nk ADD COLUMN k2 INT CONSTRAINT nk_k2 PRIMARY KEY

statement ok
ALTER TABLE nk ADD COLUMN code TEXT CONSTRAINT nk_code UNIQUE

statement error nk_code
INSERT INTO nk VALUES (3, 'x', 'c1'), (4, 'y', 'c1')
