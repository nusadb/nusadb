# UPDATE through a partitioned parent MOVES a row whose new key leaves its partition's bound
# (delete-from-source + routed insert, like the reference engine); a direct UPDATE on the
# partition itself refuses the move (23514) — the named target must keep the row. TABLESAMPLE
# keeps each row with probability n%, deterministic under REPEATABLE; 0/100 are exact; bad
# percent = 2202H, unknown method = 42704.

statement ok
CREATE TABLE gp (id INT, k INT) PARTITION BY RANGE (k)

statement ok
CREATE TABLE gp_lo PARTITION OF gp FOR VALUES FROM (0) TO (100)

statement ok
CREATE TABLE gp_hi PARTITION OF gp FOR VALUES FROM (100) TO (200)

statement ok
CREATE TABLE gp_def PARTITION OF gp DEFAULT

statement ok
INSERT INTO gp VALUES (1, 50), (2, 250)

# Via the parent: the row moves to the accepting sibling and stays findable by its key.
statement ok
UPDATE gp SET k = 150 WHERE id = 1

query II
SELECT id, k FROM gp_hi
----
1 150

query I
SELECT count(*) FROM gp WHERE k = 150
----
1

# Directly on the partition: refused loudly, the row stays put.
statement error violates partition constraint
UPDATE gp_hi SET k = 20 WHERE id = 1

# DEFAULT partition both ways: out to a claiming sibling, and in from a sibling.
statement ok
UPDATE gp SET k = 120 WHERE id = 2

query II
SELECT id, k FROM gp_hi ORDER BY id
----
1 150
2 120

statement ok
UPDATE gp SET k = 300 WHERE id = 2

query II
SELECT id, k FROM gp_def
----
2 300

# RETURNING projects the moved image exactly once; a multi-row shift crosses bounds cleanly.
query II
UPDATE gp SET k = 90 WHERE id = 1 RETURNING id, k
----
1 90

statement ok
UPDATE gp SET k = k + 100 WHERE k < 400

query II rowsort
SELECT id, k FROM gp
----
1 190
2 400

statement ok
CREATE TABLE ts6 (i INT)

statement ok
INSERT INTO ts6 VALUES (1),(2),(3),(4),(5),(6)

query I
SELECT count(*) FROM ts6 TABLESAMPLE SYSTEM (0)
----
0

query I
SELECT count(*) FROM ts6 TABLESAMPLE BERNOULLI (100)
----
6

statement error sample percentage must be between 0 and 100
SELECT count(*) FROM ts6 TABLESAMPLE BERNOULLI (101)

statement error does not exist
SELECT count(*) FROM ts6 TABLESAMPLE FOOBAR (50)

# REPEATABLE draws the same subset on every scan (self-join equality proves determinism).
query I
SELECT (SELECT count(*) FROM ts6 TABLESAMPLE BERNOULLI (50) REPEATABLE (42))
     = (SELECT count(*) FROM ts6 TABLESAMPLE BERNOULLI (50) REPEATABLE (42))
----
1

statement ok
DROP TABLE ts6

statement ok
DROP TABLE gp
