# An UPDATE may not move a row out of its partition's bound (23514, loud): the pruning layer
# trusts the bound, so a stranded row would silently vanish from key-constrained queries — the
# exact silent row loss this guards against. TABLESAMPLE keeps each row with probability n%,
# deterministic under REPEATABLE; 0/100 are exact; bad percent = 2202H, unknown method = 42704.

statement ok
CREATE TABLE gp (id INT, k INT) PARTITION BY RANGE (k)

statement ok
CREATE TABLE gp_lo PARTITION OF gp FOR VALUES FROM (0) TO (100)

statement ok
CREATE TABLE gp_hi PARTITION OF gp FOR VALUES FROM (100) TO (200)

statement ok
CREATE TABLE gp_def PARTITION OF gp DEFAULT

statement ok
INSERT INTO gp VALUES (1, 50), (2, 250)

statement error violates partition constraint
UPDATE gp SET k = 150 WHERE id = 1

statement error violates partition constraint
UPDATE gp_lo SET k = 150 WHERE id = 1

# A row in the DEFAULT partition may take any key no sibling claims; a sibling-claimed key is
# refused (it would belong in that sibling).
statement ok
UPDATE gp SET k = 300 WHERE id = 2

statement error violates partition constraint
UPDATE gp SET k = 120 WHERE id = 2

# In-bound key updates and non-key updates pass, and the row stays findable by its key.
statement ok
UPDATE gp SET k = 60 WHERE id = 1

statement ok
UPDATE gp SET id = 9 WHERE id = 1

query I
SELECT count(*) FROM gp WHERE k = 60
----
1

query II rowsort
SELECT id, k FROM gp
----
2 300
9 60

statement ok
CREATE TABLE ts6 (i INT)

statement ok
INSERT INTO ts6 VALUES (1),(2),(3),(4),(5),(6)

query I
SELECT count(*) FROM ts6 TABLESAMPLE SYSTEM (0)
----
0

query I
SELECT count(*) FROM ts6 TABLESAMPLE BERNOULLI (100)
----
6

statement error sample percentage must be between 0 and 100
SELECT count(*) FROM ts6 TABLESAMPLE BERNOULLI (101)

statement error does not exist
SELECT count(*) FROM ts6 TABLESAMPLE FOOBAR (50)

# REPEATABLE draws the same subset on every scan (self-join equality proves determinism).
query I
SELECT (SELECT count(*) FROM ts6 TABLESAMPLE BERNOULLI (50) REPEATABLE (42))
     = (SELECT count(*) FROM ts6 TABLESAMPLE BERNOULLI (50) REPEATABLE (42))
----
1

statement ok
DROP TABLE ts6

statement ok
DROP TABLE gp
