# Inside a routine, DO or trigger body a CHECK calling the name is the ordinary CHECK an older
# build stored it as: the routine is accepted, and running it type-checks the CHECK like any other
# (here no such function exists, so 42883, never 42939). It never becomes an exclusion constraint,
# since only the EXCLUDE rewrite makes one. With the function present (a data dir from an older
# build), the CHECK is created: see the e2e legacy test.
statement ok
CREATE PROCEDURE inj1() AS $$ BEGIN CREATE TABLE inj (r int4range, CHECK (__nusadb_exclude('gist', '', r, '&&'))); END $$

statement error unknown function
CALL inj1()

statement ok
CREATE PROCEDURE inj2() AS $$ BEGIN ALTER TABLE sym ADD CHECK (__nusadb_exclude('gist', '', x, '=')); END $$

statement error unknown function
