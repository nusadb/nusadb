# EXCLUDE constraints with range overlap: no two rows may have every element's operator hold
# between them. Elements mix `=` (columns or expressions) and `&&` (range overlap). A row with a
# NULL element, or an empty range, never conflicts; bound inclusivity is respected.

# The history-table shape: per key, validity intervals must not overlap.
statement ok
CREATE TABLE hist (hist_id uuid PRIMARY KEY, k int NOT NULL, valid_from timestamptz NOT NULL, valid_to timestamptz, CONSTRAINT hist_no_overlap EXCLUDE USING gist (k WITH =, tstzrange(valid_from, valid_to) WITH &&))

statement ok
INSERT INTO hist VALUES ('00000000-0000-0000-0000-000000000001', 1, '2024-01-01 00:00:00+00', '2024-02-01 00:00:00+00')

# Adjacent `[)` intervals do not overlap.
statement ok
INSERT INTO hist VALUES ('00000000-0000-0000-0000-000000000002', 1, '2024-02-01 00:00:00+00', NULL)

# An open-ended interval overlaps everything after its start.
statement error conflicting key value violates exclusion constraint "hist_no_overlap"
INSERT INTO hist VALUES ('00000000-0000-0000-0000-000000000003', 1, '2030-01-01 00:00:00+00', '2030-02-01 00:00:00+00')

# Overlapping a closed row is refused too.
statement error exclusion constraint "hist_no_overlap"
INSERT INTO hist VALUES ('00000000-0000-0000-0000-000000000004', 1, '2024-01-15 00:00:00+00', '2024-01-20 00:00:00+00')

# Another key is independent.
statement ok
INSERT INTO hist VALUES ('00000000-0000-0000-0000-000000000005', 2, '2024-01-15 00:00:00+00', '2024-01-20 00:00:00+00')

# Closing the open row then opening the next version: the SCD-2 step.
statement ok
UPDATE hist SET valid_to = '2024-06-01 00:00:00+00' WHERE hist_id = '00000000-0000-0000-0000-000000000002'

statement ok
INSERT INTO hist VALUES ('00000000-0000-0000-0000-000000000006', 1, '2024-06-01 00:00:00+00', NULL)

# Moving an interval onto another row's is refused; the row itself is not a conflict.
statement error exclusion constraint
UPDATE hist SET valid_from = '2024-05-01 00:00:00+00' WHERE hist_id = '00000000-0000-0000-0000-000000000006'

statement ok
UPDATE hist SET valid_from = '2024-06-02 00:00:00+00' WHERE hist_id = '00000000-0000-0000-0000-000000000006'

# Two conflicting rows in one statement.
statement error exclusion constraint
INSERT INTO hist VALUES ('00000000-0000-0000-0000-000000000007', 3, '2024-01-01 00:00:00+00', '2024-03-01 00:00:00+00'), ('00000000-0000-0000-0000-000000000008', 3, '2024-02-01 00:00:00+00', '2024-04-01 00:00:00+00')

query I
SELECT count(*) FROM hist
----
4

query TT
SELECT constraint_name, constraint_type FROM information_schema.table_constraints WHERE table_name = 'hist' ORDER BY constraint_name
----
hist_no_overlap EXCLUDE
hist_pkey PRIMARY KEY

