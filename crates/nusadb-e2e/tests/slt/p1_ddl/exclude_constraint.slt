# EXCLUDE constraint (equality form): `EXCLUDE (a WITH =)` rejects two rows whose a values are equal
# — exactly a UNIQUE constraint, including that NULLs do not conflict. NusaDB reduces the equality
# form to UNIQUE. The overlap and partial forms are covered by exclude_overlap.slt; an operator other
# than `=` / `&&`, or `&&` on a non-range, is refused rather than mishandled.

statement ok
CREATE TABLE t (a INT, EXCLUDE (a WITH =))

statement ok
INSERT INTO t VALUES (1)

# A duplicate value conflicts.
statement error duplicate key
INSERT INTO t VALUES (1)

# NULLs never conflict (like UNIQUE): two NULLs are allowed.
statement ok
INSERT INTO t VALUES (NULL), (NULL)

query I
SELECT count(*) FROM t
----
3

# Multi-column, named: the whole (a, b) tuple must be distinct.
statement ok
CREATE TABLE t2 (a INT, b INT, CONSTRAINT t2u EXCLUDE (a WITH =, b WITH =))

statement ok
INSERT INTO t2 VALUES (1, 2), (1, 3)

statement error duplicate key
INSERT INTO t2 VALUES (1, 2)

query I
SELECT count(*) FROM t2
----
2

# ALTER TABLE ... ADD EXCLUDE (equality form) also reduces to a unique constraint.
statement ok
CREATE TABLE t3 (a INT)

statement ok
ALTER TABLE t3 ADD EXCLUDE (a WITH =)

statement ok
INSERT INTO t3 VALUES (5)

statement error duplicate key
INSERT INTO t3 VALUES (5)

# `&&` on a non-range and an unsupported operator are refused loudly.
statement error
CREATE TABLE g (a INT, EXCLUDE USING gist (a WITH &&))

statement error
CREATE TABLE n (a INT, EXCLUDE (a WITH <>))

# A partial equality form is a general exclusion constraint: only rows matching WHERE take part.
statement ok
CREATE TABLE w (a INT, EXCLUDE (a WITH =) WHERE (a > 0))

statement ok
INSERT INTO w VALUES (-1), (-1), (1)

statement error exclusion constraint
INSERT INTO w VALUES (1)
