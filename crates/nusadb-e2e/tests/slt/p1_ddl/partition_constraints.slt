# An attached table that is itself partitioned: its partitions hold the rows, so they are checked
# and take the constraints.
statement ok
CREATE TABLE sp (k INT NOT NULL, d DATE NOT NULL, v BIGINT NOT NULL CHECK (v >= 0)) PARTITION BY RANGE (d)

statement ok
CREATE TABLE sp_01 (k INT NOT NULL, d DATE NOT NULL, v BIGINT NOT NULL) PARTITION BY LIST (k)

statement ok
CREATE TABLE sp_01_a PARTITION OF sp_01 FOR VALUES IN (1, 2)

statement ok
