# A partition's own constraint that already enforces the parent's rule stands in for the copy, so
# it cannot be dropped either.
statement ok
CREATE TABLE own (k INT NOT NULL, v BIGINT NOT NULL, CONSTRAINT own_v CHECK (v >= 0)) PARTITION BY LIST (k)

statement ok
CREATE TABLE own_1 (k INT NOT NULL, v BIGINT NOT NULL, CONSTRAINT mine CHECK (v >= 0))

statement ok
ALTER TABLE own ATTACH PARTITION own_1 FOR VALUES IN (1)

statement error cannot drop inherited constraint
ALTER TABLE own_1 DROP CONSTRAINT mine

statement error violates check constraint
INSERT INTO own VALUES (1, -1)

