# A unique key must include the partition key, as at CREATE TABLE.
statement error must include all partitioning columns
ALTER TABLE ev ADD CONSTRAINT ev_v_uq UNIQUE (v)

# The partition's copy belongs to the parent: it cannot be dropped on the partition.
statement error cannot drop inherited constraint
