# A unique key must also include the partition key of every sub-partitioned partition below the
# table, or equal keys could sit in two leaves: refused when the key is added, when such a
# partition is created, and when one is attached.
statement ok
CREATE TABLE uq (k INT NOT NULL, d INT NOT NULL) PARTITION BY RANGE (d)

statement ok
CREATE TABLE uq_1 PARTITION OF uq FOR VALUES FROM (0) TO (100) PARTITION BY LIST (k)

statement ok
CREATE TABLE uq_1_a PARTITION OF uq_1 FOR VALUES IN (1)

statement error must include all partitioning columns
