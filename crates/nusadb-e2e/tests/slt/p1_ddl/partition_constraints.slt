statement ok
UPDATE fact_02 SET v = 3

statement ok
INSERT INTO fact_02 VALUES (7, '2026-02-06', 1)

statement error foreign key
ALTER TABLE fact ATTACH PARTITION fact_02 FOR VALUES FROM ('2026-02-01') TO ('2026-03-01')

statement ok
