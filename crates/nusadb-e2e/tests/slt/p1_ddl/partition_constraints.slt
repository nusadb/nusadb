statement ok
ALTER TABLE fact ATTACH PARTITION fact_02 FOR VALUES FROM ('2026-02-01') TO ('2026-03-01')

statement error violates check constraint
INSERT INTO fact VALUES (2, '2026-02-07', -1)

# The referenced row's delete cascades into every partition.
statement ok
DELETE FROM ws WHERE ws = 1

