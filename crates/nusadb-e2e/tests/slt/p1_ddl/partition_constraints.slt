# Constraints on a partitioned table hold for every row, and the rows live in the partitions: a
# CHECK, FOREIGN KEY, PRIMARY KEY or UNIQUE declared on the parent (at CREATE TABLE or by ALTER
# TABLE ADD CONSTRAINT) applies to every partition, existing or created or attached later.

statement ok
CREATE TABLE ws (ws INT PRIMARY KEY)

statement ok
INSERT INTO ws VALUES (1), (2)

statement ok
CREATE TABLE fact (ws INT NOT NULL REFERENCES ws (ws) ON DELETE CASCADE, d DATE NOT NULL, v BIGINT NOT NULL CHECK (v >= 0), PRIMARY KEY (ws, d)) PARTITION BY RANGE (d)

statement ok
CREATE TABLE fact_01 PARTITION OF fact FOR VALUES FROM ('2026-01-01') TO ('2026-02-01')

statement error violates check constraint
INSERT INTO fact VALUES (1, '2026-01-10', -5)

statement error violates foreign key
INSERT INTO fact VALUES (9, '2026-01-10', 5)

statement error violates check constraint
INSERT INTO fact_01 VALUES (1, '2026-01-11', -1)

statement ok
INSERT INTO fact VALUES (1, '2026-01-10', 5), (2, '2026-01-10', 6)

statement error duplicate key
INSERT INTO fact VALUES (1, '2026-01-10', 7)

# A table attached later is checked against them, and refused when a row breaks one.
statement ok
