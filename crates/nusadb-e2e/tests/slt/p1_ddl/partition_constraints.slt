# ALTER TABLE ADD CONSTRAINT on a partitioned table reaches the partitions it already has,
# including sub-partitions, and checks their rows.
statement ok
CREATE TABLE rf (k INT PRIMARY KEY)

statement ok
INSERT INTO rf VALUES (1), (2)

statement ok
CREATE TABLE ev (k INT NOT NULL, d DATE NOT NULL, v BIGINT NOT NULL) PARTITION BY RANGE (d)

statement ok
CREATE TABLE ev_01 PARTITION OF ev FOR VALUES FROM ('2026-01-01') TO ('2026-02-01')

statement ok
CREATE TABLE ev_02 PARTITION OF ev FOR VALUES FROM ('2026-02-01') TO ('2026-03-01') PARTITION BY LIST (k)

statement ok
CREATE TABLE ev_02_a PARTITION OF ev_02 FOR VALUES IN (1, 2)

statement ok
INSERT INTO ev VALUES (1, '2026-01-10', 5), (2, '2026-02-10', -5)

