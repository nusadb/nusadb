# --- A NULLS NOT DISTINCT unique key on the child is checked on the rewritten rows ---------------

statement ok
CREATE TABLE nd_p (org INT NOT NULL, d_id INT NOT NULL, PRIMARY KEY (d_id), UNIQUE (org, d_id))

statement ok
CREATE TABLE nd_c (id INT PRIMARY KEY, org INT NOT NULL, d_id INT, UNIQUE NULLS NOT DISTINCT (org, d_id), FOREIGN KEY (org, d_id) REFERENCES nd_p (org, d_id) ON DELETE SET NULL (d_id))

statement ok
INSERT INTO nd_p VALUES (1, 12), (1, 13), (2, 14)

statement ok
