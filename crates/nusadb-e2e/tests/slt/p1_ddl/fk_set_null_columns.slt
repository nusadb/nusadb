# ON DELETE SET NULL (cols): a parent delete nulls only the listed referencing columns; the other
# columns of the foreign key keep their values. The list must be a subset of the referencing
# columns, and is accepted on ON DELETE only.

# --- The composite tenant key ----------------------------------------------------------------

statement ok
CREATE TABLE d (org INT NOT NULL, d_id INT NOT NULL, name TEXT NOT NULL, CONSTRAINT d_pkey PRIMARY KEY (d_id), CONSTRAINT d_key UNIQUE (org, d_id, name))

statement ok
CREATE TABLE v (v_id INT PRIMARY KEY, org INT NOT NULL, d_id INT, name TEXT, CONSTRAINT v_d_fkey FOREIGN KEY (org, d_id, name) REFERENCES d (org, d_id, name) ON DELETE SET NULL (d_id))

statement ok
INSERT INTO d VALUES (7, 1, 'a'), (7, 2, 'b'), (8, 3, 'c')

statement ok
INSERT INTO v VALUES (10, 7, 1, 'a'), (11, 7, 2, 'b'), (12, 8, 3, 'c'), (13, 7, NULL, 'a')

statement ok
DELETE FROM d WHERE d_id = 1

query IIIT
SELECT v_id, org, d_id, name FROM v ORDER BY v_id
----
10 7 NULL a
11 7 2 b
12 8 3 c
13 7 NULL a

# A child with a NULL in its key references nothing, so it can take any values in the other
# columns.
statement ok
UPDATE v SET name = 'zz' WHERE v_id = 10

statement error foreign key
INSERT INTO v VALUES (14, 7, 9, 'a')

statement ok
DELETE FROM d WHERE org = 8

query IIIT
SELECT v_id, org, d_id, name FROM v ORDER BY v_id
----
10 7 NULL zz
11 7 2 b
12 8 NULL c
13 7 NULL a

query TTT
SELECT constraint_name, update_rule, delete_rule FROM information_schema.referential_constraints WHERE constraint_name = 'v_d_fkey'
----
v_d_fkey NO ACTION SET NULL

# --- Plain SET NULL is unchanged: every referencing column is nulled --------------------------

statement ok
CREATE TABLE w (w_id INT PRIMARY KEY, org INT, d_id INT, name TEXT, FOREIGN KEY (org, d_id, name) REFERENCES d (org, d_id, name) ON DELETE SET NULL)

statement ok
INSERT INTO w VALUES (1, 7, 2, 'b')

statement ok
DELETE FROM d WHERE d_id = 2

query IIIT
SELECT w_id, org, d_id, name FROM w
----
1 NULL NULL NULL

query IIIT
SELECT v_id, org, d_id, name FROM v WHERE v_id = 11
----
11 7 NULL b

# --- Refusals -------------------------------------------------------------------------------

statement error must be part of the foreign key
CREATE TABLE bad (id INT PRIMARY KEY, org INT, d_id INT, name TEXT, FOREIGN KEY (org, d_id, name) REFERENCES d (org, d_id, name) ON DELETE SET NULL (id))

statement error column not found
CREATE TABLE bad (id INT PRIMARY KEY, org INT, d_id INT, name TEXT, FOREIGN KEY (org, d_id, name) REFERENCES d (org, d_id, name) ON DELETE SET NULL (nope))

statement error specified more than once
CREATE TABLE bad (id INT PRIMARY KEY, org INT, d_id INT, name TEXT, FOREIGN KEY (org, d_id, name) REFERENCES d (org, d_id, name) ON DELETE SET NULL (d_id, d_id))

statement error only for ON DELETE
CREATE TABLE bad (id INT PRIMARY KEY, org INT, d_id INT, name TEXT, FOREIGN KEY (org, d_id, name) REFERENCES d (org, d_id, name) ON UPDATE SET NULL (d_id))

statement error only for ON DELETE
CREATE TABLE bad (id INT PRIMARY KEY, org INT, d_id INT, name TEXT, FOREIGN KEY (org, d_id, name) REFERENCES d (org, d_id, name) ON DELETE CASCADE ON UPDATE SET DEFAULT (d_id))

statement error SET DEFAULT with a column list is not supported
CREATE TABLE bad (id INT PRIMARY KEY, org INT, d_id INT DEFAULT 0, name TEXT, FOREIGN KEY (org, d_id, name) REFERENCES d (org, d_id, name) ON DELETE SET DEFAULT (d_id))

statement error at least one column
CREATE TABLE bad (id INT PRIMARY KEY, org INT, d_id INT, name TEXT, FOREIGN KEY (org, d_id, name) REFERENCES d (org, d_id, name) ON DELETE SET NULL ())

statement error
CREATE TABLE bad (id INT PRIMARY KEY, p INT REFERENCES d ON DELETE CASCADE (p))

statement error must be part of the foreign key
ALTER TABLE v ADD CONSTRAINT v_bad FOREIGN KEY (d_id) REFERENCES d ON DELETE SET NULL (org)

statement error relation "bad" does not exist|not found
SELECT * FROM bad

# --- NOT NULL on a listed column is respected -------------------------------------------------

statement ok
CREATE TABLE nn (id INT PRIMARY KEY, org INT NOT NULL, d_id INT NOT NULL, name TEXT, FOREIGN KEY (org, d_id, name) REFERENCES d (org, d_id, name) ON DELETE SET NULL (org))

statement ok
INSERT INTO d VALUES (9, 4, 'n')

statement ok
INSERT INTO nn VALUES (1, 9, 4, 'n')

statement error NOT NULL column `org`
DELETE FROM d WHERE d_id = 4

query IIT
SELECT org, d_id, name FROM d WHERE d_id = 4
----
9 4 n

query IIIT
SELECT id, org, d_id, name FROM nn
----
1 9 4 n

statement ok
DROP TABLE nn

# --- Column-level and ALTER TABLE forms --------------------------------------------------------

statement ok
CREATE TABLE p1 (id INT PRIMARY KEY)

statement ok
CREATE TABLE c1 (id INT PRIMARY KEY, p INT REFERENCES p1 ON DELETE SET NULL (p))

statement ok
INSERT INTO p1 VALUES (1), (2)

statement ok
INSERT INTO c1 VALUES (1, 1), (2, 2)

statement ok
DELETE FROM p1 WHERE id = 1

query II
SELECT id, p FROM c1 ORDER BY id
----
1 NULL
2 2

statement ok
CREATE TABLE c2 (id INT PRIMARY KEY, org INT NOT NULL, d_id INT, name TEXT)

statement ok
ALTER TABLE c2 ADD CONSTRAINT c2_fk FOREIGN KEY (org, d_id, name) REFERENCES d (org, d_id, name) ON DELETE SET NULL (name, d_id)

statement ok
INSERT INTO d VALUES (5, 5, 'e')

statement ok
INSERT INTO c2 VALUES (1, 5, 5, 'e')

statement ok
DELETE FROM d WHERE d_id = 5

query IIIT
SELECT id, org, d_id, name FROM c2
----
1 5 NULL NULL

statement ok
ALTER TABLE c2 ADD COLUMN p INT REFERENCES p1 ON DELETE SET NULL (p)

statement ok
UPDATE c2 SET p = 2

statement ok
DELETE FROM p1 WHERE id = 2

query IIII
SELECT id, org, p, (SELECT count(*) FROM c1 WHERE p IS NULL) FROM c2
----
1 5 NULL 2

# --- CHECK constraints on the child ------------------------------------------------------------

statement ok
CREATE TABLE ck (id INT PRIMARY KEY, org INT NOT NULL, d_id INT, name TEXT, CHECK (d_id IS NOT NULL OR name IS NULL), FOREIGN KEY (org, d_id, name) REFERENCES d (org, d_id, name) ON DELETE SET NULL (d_id))

statement ok
INSERT INTO d VALUES (6, 6, 'f')

statement ok
INSERT INTO ck VALUES (1, 6, 6, 'f')

statement error check constraint
DELETE FROM d WHERE d_id = 6

query IIIT
SELECT id, org, d_id, name FROM ck
----
1 6 6 f

statement ok
DROP TABLE ck

statement ok
DELETE FROM d WHERE d_id = 6

# A CHECK the plain SET NULL action would break is also enforced.
statement ok
CREATE TABLE ckp (id INT PRIMARY KEY, p INT REFERENCES d ON DELETE SET NULL, CHECK (p IS NOT NULL))

statement ok
INSERT INTO d VALUES (6, 6, 'f')

statement ok
INSERT INTO ckp VALUES (1, 6)

statement error check constraint
DELETE FROM d WHERE d_id = 6

statement ok
DROP TABLE ckp

# --- Triggers on the child -------------------------------------------------------------------

statement ok
CREATE TABLE tl (v_id INT, org INT, d_id INT, name TEXT, note TEXT)

statement ok
CREATE TABLE tc (v_id INT PRIMARY KEY, org INT NOT NULL, d_id INT, name TEXT, note TEXT, FOREIGN KEY (org, d_id, name) REFERENCES d (org, d_id, name) ON DELETE SET NULL (d_id))

statement ok
CREATE TRIGGER tc_log AFTER UPDATE ON tc FOR EACH ROW INSERT INTO tl VALUES (NEW.v_id, NEW.org, NEW.d_id, NEW.name, NEW.note)

statement ok
CREATE FUNCTION tc_mark() RETURNS trigger LANGUAGE nusascript AS $$ BEGIN IF NEW.d_id IS NULL THEN NEW.note := 'orphan of ' || OLD.d_id; END IF; RETURN NEW; END $$

statement ok
CREATE TRIGGER tc_before BEFORE UPDATE ON tc FOR EACH ROW EXECUTE FUNCTION tc_mark()

statement ok
INSERT INTO tc VALUES (1, 6, 6, 'f', NULL)

statement ok
DELETE FROM d WHERE d_id = 6

query IIITT
SELECT v_id, org, d_id, name, note FROM tc
----
1 6 NULL f orphan of 6

query IIITT
SELECT v_id, org, d_id, name, note FROM tl
----
1 6 NULL f orphan of 6

# A BEFORE trigger may not change a column of the key the action writes.
statement ok
CREATE FUNCTION tc_rekey() RETURNS trigger LANGUAGE nusascript AS $$ BEGIN NEW.org := 0; RETURN NEW; END $$

statement ok
INSERT INTO d VALUES (6, 6, 'f')

statement ok
UPDATE tc SET d_id = 6, note = NULL

statement ok
CREATE TRIGGER tc_rekey BEFORE UPDATE ON tc FOR EACH ROW EXECUTE FUNCTION tc_rekey()

statement error changed a key
DELETE FROM d WHERE d_id = 6

statement ok
DROP TABLE tc

statement ok
DELETE FROM d WHERE d_id = 6

# --- Unique constraints on the child -----------------------------------------------------------

statement ok
CREATE TABLE uc (id INT PRIMARY KEY, org INT NOT NULL, d_id INT, name TEXT, UNIQUE (org, d_id), FOREIGN KEY (org, d_id, name) REFERENCES d (org, d_id, name) ON DELETE SET NULL (d_id))

statement ok
INSERT INTO d VALUES (1, 21, 'u'), (1, 22, 'u')

statement ok
INSERT INTO uc VALUES (1, 1, 21, 'u'), (2, 1, 22, 'u')

# Both rows become (1, NULL): NULLs are distinct, so the unique key holds.
statement ok
DELETE FROM d WHERE d_id IN (21, 22)

query IIIT
SELECT id, org, d_id, name FROM uc ORDER BY id
----
1 1 NULL u
2 1 NULL u

# --- Deferrable key: the action still runs at the delete ----------------------------------------

statement ok
CREATE TABLE df (id INT PRIMARY KEY, org INT NOT NULL, d_id INT, name TEXT, FOREIGN KEY (org, d_id, name) REFERENCES d (org, d_id, name) ON DELETE SET NULL (d_id) DEFERRABLE INITIALLY DEFERRED)

statement ok
INSERT INTO d VALUES (2, 31, 'x')

statement ok
INSERT INTO df VALUES (1, 2, 31, 'x')

statement ok
BEGIN

statement ok
DELETE FROM d WHERE d_id = 31

query IIIT
SELECT id, org, d_id, name FROM df
----
1 2 NULL x

statement ok
COMMIT

# --- A cascade chaining into a further foreign key -----------------------------------------------

statement ok
CREATE TABLE mid (id INT PRIMARY KEY, org INT NOT NULL, d_id INT, name TEXT, UNIQUE (org, d_id), FOREIGN KEY (org, d_id, name) REFERENCES d (org, d_id, name) ON DELETE SET NULL (d_id))

statement ok
CREATE TABLE leaf (id INT PRIMARY KEY, org INT, d_id INT, FOREIGN KEY (org, d_id) REFERENCES mid (org, d_id) ON UPDATE SET NULL)

statement ok
INSERT INTO d VALUES (3, 41, 'm')

statement ok
INSERT INTO mid VALUES (1, 3, 41, 'm')

statement ok
INSERT INTO leaf VALUES (1, 3, 41)

statement ok
DELETE FROM d WHERE d_id = 41

query III
SELECT id, org, d_id FROM leaf
----
1 NULL NULL

# A NO ACTION key further down blocks the rewrite.
statement ok
CREATE TABLE mid2 (id INT PRIMARY KEY, org INT NOT NULL, d_id INT, name TEXT, UNIQUE (org, d_id), FOREIGN KEY (org, d_id, name) REFERENCES d (org, d_id, name) ON DELETE SET NULL (d_id))

statement ok
CREATE TABLE leaf2 (id INT PRIMARY KEY, org INT NOT NULL, d_id INT, FOREIGN KEY (org, d_id) REFERENCES mid2 (org, d_id))

statement ok
INSERT INTO d VALUES (3, 42, 'm')

statement ok
INSERT INTO mid2 VALUES (1, 3, 42, 'm')

statement ok
INSERT INTO leaf2 VALUES (1, 3, 42)

statement error foreign key
DELETE FROM d WHERE d_id = 42

query IIIT
SELECT id, org, d_id, name FROM mid2
----
1 3 42 m

# --- Two keys nulling one row: the union of their columns --------------------------------------

statement ok
CREATE TABLE two (id INT PRIMARY KEY, org INT NOT NULL, d_id INT, name TEXT, d2 INT, FOREIGN KEY (org, d_id, name) REFERENCES d (org, d_id, name) ON DELETE SET NULL (d_id), FOREIGN KEY (d2) REFERENCES d ON DELETE SET NULL (d2))

statement ok
INSERT INTO d VALUES (4, 51, 't')

statement ok
INSERT INTO two VALUES (1, 4, 51, 't', 51)

statement ok
DELETE FROM d WHERE d_id = 51

query IIITI
SELECT id, org, d_id, name, d2 FROM two
----
1 4 NULL t NULL

# --- A self-referencing table ------------------------------------------------------------------

statement ok
CREATE TABLE node (org INT NOT NULL, id INT NOT NULL, parent INT, PRIMARY KEY (org, id), FOREIGN KEY (org, parent) REFERENCES node (org, id) ON DELETE SET NULL (parent))

statement ok
INSERT INTO node VALUES (1, 1, NULL), (1, 2, 1), (1, 3, 2)

statement ok
DELETE FROM node WHERE id = 1

query III
SELECT org, id, parent FROM node ORDER BY id
----
1 2 NULL
1 3 2

# --- A partitioned child: every partition sets only the listed column ---------------------------

statement ok
CREATE TABLE pc (org INT NOT NULL, d_id INT, name TEXT, FOREIGN KEY (org, d_id, name) REFERENCES d (org, d_id, name) ON DELETE SET NULL (d_id)) PARTITION BY LIST (org)

statement ok
CREATE TABLE pc_1 PARTITION OF pc FOR VALUES IN (1)

statement ok
CREATE TABLE pc_2 PARTITION OF pc FOR VALUES IN (2)

statement ok
INSERT INTO d VALUES (1, 61, 'p'), (2, 62, 'q')

statement ok
INSERT INTO pc VALUES (1, 61, 'p'), (2, 62, 'q')

statement ok
DELETE FROM d WHERE d_id IN (61, 62)

query IIT
SELECT org, d_id, name FROM pc ORDER BY org
----
1 NULL p
2 NULL q

# A partition attached later gets the list too.
statement ok
CREATE TABLE pc_3 PARTITION OF pc FOR VALUES IN (3)

statement ok
INSERT INTO d VALUES (3, 63, 'r')

statement ok
INSERT INTO pc VALUES (3, 63, 'r')

statement ok
DELETE FROM d WHERE d_id = 63

query IIT
SELECT org, d_id, name FROM pc WHERE org = 3
----
3 NULL r

# --- RENAME COLUMN and DROP COLUMN of a listed column -------------------------------------------

statement ok
CREATE TABLE rn (id INT PRIMARY KEY, org INT NOT NULL, d_id INT, name TEXT, FOREIGN KEY (org, d_id, name) REFERENCES d (org, d_id, name) ON DELETE SET NULL (d_id))

statement ok
ALTER TABLE rn RENAME COLUMN d_id TO dept

statement ok
ALTER TABLE rn RENAME COLUMN org TO tenant

statement ok
