statement ok
INSERT INTO rn VALUES (1, 5, 71, 'k')

statement ok
DELETE FROM d WHERE d_id = 71

query IIIT
SELECT id, tenant, dept, name FROM rn
----
1 5 NULL k

# Dropping a column of the key drops the key, as for any foreign key column.
statement ok
ALTER TABLE rn DROP COLUMN dept

query I
SELECT count(*) FROM information_schema.referential_constraints WHERE constraint_name LIKE 'rn%'
----
0

# A key created later under the same name sets every column again.
statement ok
CREATE TABLE re (id INT PRIMARY KEY, org INT, d_id INT, name TEXT, CONSTRAINT v_d_fkey2 FOREIGN KEY (org, d_id, name) REFERENCES d (org, d_id, name) ON DELETE SET NULL (d_id))

statement ok
ALTER TABLE re DROP CONSTRAINT v_d_fkey2

statement ok
ALTER TABLE re ADD CONSTRAINT v_d_fkey2 FOREIGN KEY (org, d_id, name) REFERENCES d (org, d_id, name) ON DELETE SET NULL

statement ok
INSERT INTO d VALUES (5, 72, 'k')

statement ok
INSERT INTO re VALUES (1, 5, 72, 'k')

statement ok
DELETE FROM d WHERE d_id = 72

query IIIT
SELECT id, org, d_id, name FROM re
----
1 NULL NULL NULL

