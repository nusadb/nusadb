# Index keys, index predicates and generated columns call only immutable functions; a CHECK may
# not call a volatile one. A stable function such as now() is accepted in a CHECK.

statement ok
CREATE TABLE vt (x INT, t TIMESTAMPTZ, u UUID)

statement error functions in index expression must be immutable, but uuidv7\(\) is not
CREATE INDEX vt_u ON vt ((uuidv7()))

statement error functions in index expression must be immutable, but clock_timestamp\(\) is not
CREATE INDEX vt_c ON vt ((clock_timestamp()))

statement error functions in index expression must be immutable, but random\(\) is not
CREATE INDEX vt_r ON vt ((random()))

statement error functions in index expression must be immutable, but now\(\) is not
CREATE INDEX vt_n ON vt ((now()))

statement error functions in index predicate must be immutable, but now\(\) is not
CREATE INDEX vt_p ON vt (x) WHERE t < now()

statement ok
CREATE INDEX vt_ok ON vt ((abs(x))) WHERE x > 0

statement error functions in generation expression must be immutable, but random\(\) is not
CREATE TABLE vg (a INT, b FLOAT GENERATED ALWAYS AS (random()) STORED)

statement error functions in generation expression must be immutable, but now\(\) is not
CREATE TABLE vg (a INT, b TIMESTAMPTZ GENERATED ALWAYS AS (now()) STORED)

statement error a CHECK constraint may not call the volatile function clock_timestamp\(\)
CREATE TABLE vc (t TIMESTAMPTZ CHECK (t <= clock_timestamp()))

statement error a CHECK constraint may not call the volatile function uuidv7\(\)
CREATE TABLE vc (u UUID CHECK (u < uuidv7()))

statement error a CHECK constraint may not call the volatile function random\(\)
ALTER TABLE vt ADD CONSTRAINT vt_rand CHECK (x < random() * 10)

statement ok
CREATE TABLE vc (t TIMESTAMPTZ CHECK (t <= now()))

statement ok
INSERT INTO vc VALUES (now() - INTERVAL '1 hour')

statement error violates check constraint
INSERT INTO vc VALUES (now() + INTERVAL '1 hour')

# A function SQL spells as a keyword is named without parentheses.
statement error functions in index expression must be immutable, but current_user is not
CREATE INDEX vt_cu ON vt ((x::text || current_user))

statement error functions in index expression must be immutable, but current_date is not
CREATE INDEX vt_cd ON vt ((current_date))

statement error functions in index expression must be immutable, but localtime is not
CREATE INDEX vt_lt ON vt ((localtime))

statement error functions in index predicate must be immutable, but current_timestamp is not
CREATE INDEX vt_ct ON vt (x) WHERE t < current_timestamp

# A domain's CHECK follows the same rule as a table's.
statement error a CHECK constraint may not call the volatile function random\(\)
CREATE DOMAIN d_rand AS INT CHECK (VALUE > random())

statement error a CHECK constraint may not call the volatile function clock_timestamp\(\)
CREATE DOMAIN d_clock AS TIMESTAMPTZ NOT NULL CHECK (VALUE IS NOT NULL) CHECK (VALUE <= clock_timestamp())

statement ok
CREATE DOMAIN d_past AS TIMESTAMPTZ CHECK (VALUE <= now())

statement ok
CREATE TABLE vd (t d_past)

statement ok
INSERT INTO vd VALUES (now() - INTERVAL '1 hour')

statement error violates check constraint
INSERT INTO vd VALUES (now() + INTERVAL '1 hour')
