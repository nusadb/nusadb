# p1_ddl/rename_column_guard — renaming a column that something else records by name is refused,
# and the error says what is in the way.
#
# A column name is written down in more places than the table's own schema: a constraint keeps its
# key columns and its CHECK body, a foreign key keeps both sides, an index keeps its key, and a
# default is filed under the column. Renaming moved only the schema entry, so a USER-defined one of
# those would be left naming a column that no longer existed. Those are still refused. The engine's
# OWN synthetic width check, however, is rewritten for the new name and carried across.

# --- An INTEGER column carries a generated width check; RENAME now carries it to the new name. ---

statement ok
CREATE TABLE rn (a INTEGER, b INTEGER)

statement ok
INSERT INTO rn VALUES (1,2)

# The rename succeeds: the engine's synthetic width check moves with the column.
statement ok
ALTER TABLE rn RENAME COLUMN b TO c

# The column is readable and writable under its new name.
statement ok
INSERT INTO rn VALUES (3,4)

query I
SELECT count(*) FROM rn
----
2

# The INTEGER width bound moved with the column — an out-of-range value is still rejected under `c`.
statement error
INSERT INTO rn VALUES (5, 9999999999)

# --- A column nothing refers to still renames, and stays writable and readable after. ---

statement ok
CREATE TABLE plain (a TEXT, b TEXT)

statement ok
INSERT INTO plain VALUES ('x','y')

statement ok
ALTER TABLE plain RENAME COLUMN b TO c

statement ok
INSERT INTO plain VALUES ('p','q')

query T
SELECT c FROM plain WHERE a = 'x'
----
y

# --- Every kind of dependant blocks it. ---

statement ok
CREATE TABLE u (a INT, b TEXT UNIQUE)

statement error
ALTER TABLE u RENAME COLUMN b TO c

statement ok
CREATE TABLE ix (a TEXT, b TEXT)

statement ok
CREATE INDEX ix_b ON ix(b)

statement error
ALTER TABLE ix RENAME COLUMN b TO c

statement ok
CREATE TABLE df (a TEXT, b TEXT DEFAULT 'd')

statement error
ALTER TABLE df RENAME COLUMN b TO c

statement ok
CREATE TABLE par (id INT PRIMARY KEY)

statement ok
CREATE TABLE chi (id INT PRIMARY KEY, pid INT REFERENCES par(id))

# Blocked from the parent side and from the child side alike.
statement error
ALTER TABLE par RENAME COLUMN id TO k

statement error
ALTER TABLE chi RENAME COLUMN pid TO p

# --- A longer name that merely contains the column is not what blocks it. ---
# `bb` starts with `b`, so a scan that resumed one character in would match on its tail.

statement ok
CREATE TABLE lg (b TEXT, bb TEXT, CHECK (bb <> 'no'))

statement ok
INSERT INTO lg VALUES ('keep','yes')

statement ok
ALTER TABLE lg RENAME COLUMN b TO z

statement ok
INSERT INTO lg VALUES ('more','ok')

query T
SELECT z FROM lg WHERE bb = 'yes'
----
keep

# --- A predicate is stored as it was written, so its case must not decide the outcome. ---

statement ok
CREATE TABLE uc (a BIGINT, b BIGINT, CHECK (B > 0))

statement ok
INSERT INTO uc VALUES (1, 5)

statement error
ALTER TABLE uc RENAME COLUMN b TO c

# Refused, so the table is still writable — and the check still bites.
statement ok
INSERT INTO uc VALUES (2, 7)

statement error
INSERT INTO uc VALUES (3, -9)

# --- A generated column reads other columns, and its expression is evaluated on every write. ---

statement ok
CREATE TABLE g (a BIGINT, b BIGINT, s BIGINT GENERATED ALWAYS AS (a + b) STORED)

statement ok
INSERT INTO g (a, b) VALUES (1, 2)

statement error
ALTER TABLE g RENAME COLUMN a TO x

statement ok
INSERT INTO g (a, b) VALUES (3, 4)

query I
SELECT s FROM g WHERE a = 3
----
7

# --- A view re-analyzes its stored SQL on every read, so it blocks the rename too. ---
# BIGINT and TEXT columns carry no generated width check, so nothing else could be the blocker.

statement ok
CREATE TABLE vt (a BIGINT, b TEXT)

statement ok
INSERT INTO vt VALUES (1, 'x')

statement ok
CREATE VIEW vv AS SELECT b FROM vt

statement error
ALTER TABLE vt RENAME COLUMN b TO c

# Refused, so both the table and the view still work.
statement ok
INSERT INTO vt VALUES (2, 'y')

query T rowsort
SELECT b FROM vv
----
x
y

# A view that does not name this column does not block it.
statement ok
ALTER TABLE vt RENAME COLUMN a TO z

# A view over some other table does not block this one, even when the column names collide.
statement ok
CREATE TABLE elsewhere (b TEXT)

statement ok
INSERT INTO elsewhere VALUES ('other')

statement ok
CREATE VIEW ev AS SELECT b FROM elsewhere

statement ok
CREATE TABLE mine (a BIGINT, b TEXT)

statement ok
INSERT INTO mine VALUES (1, 'm')

statement ok
ALTER TABLE mine RENAME COLUMN b TO c

# A view can stand for the table without naming it: v2 reads v1 reads the table, and only v1's
# definition says so. The chain still blocks the rename.
statement ok
CREATE TABLE ct (a BIGINT, b TEXT)

statement ok
INSERT INTO ct VALUES (1, 'c')

statement ok
CREATE VIEW c1 AS SELECT * FROM ct

statement ok
CREATE VIEW c2 AS SELECT b FROM c1

statement error
ALTER TABLE ct RENAME COLUMN b TO z

# Refused, so the whole chain still reads.
query T
SELECT b FROM c2
----
c

# --- A materialized view's definition is re-run on refresh. ---

statement ok
CREATE TABLE mt (a BIGINT, b TEXT)

statement ok
INSERT INTO mt VALUES (1, 'm')

statement ok
CREATE MATERIALIZED VIEW mv AS SELECT b FROM mt

statement error
ALTER TABLE mt RENAME COLUMN b TO c

# --- A policy's predicates are re-analyzed on every read they protect. ---

statement ok
CREATE TABLE pt (a BIGINT, owner TEXT)

statement ok
INSERT INTO pt VALUES (1, 'alice')

statement ok
CREATE POLICY own ON pt FOR SELECT USING (owner = CURRENT_USER)

statement error
ALTER TABLE pt RENAME COLUMN owner TO holder

# --- A trigger's WHEN and body run against this table's rows on every firing. ---

statement ok
CREATE TABLE tt (a BIGINT, b TEXT)

statement ok
INSERT INTO tt VALUES (1, 't')

statement ok
CREATE TABLE tlog (note TEXT)

statement ok
CREATE TRIGGER tt_ins AFTER INSERT ON tt FOR EACH ROW WHEN (NEW.b <> 'skip') INSERT INTO tlog VALUES ('hit')

statement error
ALTER TABLE tt RENAME COLUMN b TO c

# --- The other side of a key: a child column of another table sharing the name is not ours. ---
# `parent.pid` is TEXT with nothing referring to it; the key's child column `pid` belongs to the
# child table, so the rename goes through.

statement ok
CREATE TABLE fpar (id INT PRIMARY KEY, pid TEXT)

statement ok
CREATE TABLE fchi (id INT PRIMARY KEY, pid INT REFERENCES fpar(id))

statement ok
INSERT INTO fpar VALUES (1, 'note')

statement ok
ALTER TABLE fpar RENAME COLUMN pid TO annotation

query T
SELECT annotation FROM fpar
----
note
