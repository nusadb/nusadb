# Inside a trigger, NEW.col and OLD.col have the column's type also when they are NULL, and also
# when an INSERT wrote the value as a string: arrays, ranges, INET, CIDR, BIT, BIT VARYING, BYTEA,
# geometric types, TSVECTOR, TSQUERY and XML. A NULL makes each expression NULL instead of an error.

statement ok
CREATE TABLE tn (id BIGINT PRIMARY KEY, ar BIGINT[], ta TEXT[], r TSTZRANGE, ir INT4RANGE, nr NUMRANGE, dr DATERANGE, ip INET, cd CIDR, b BIT(3), vb BIT VARYING(5), bt BYTEA, p POINT, tv TSVECTOR, tq TSQUERY, x XML)

statement ok
CREATE TABLE tlog (op TEXT, id BIGINT, n INT, v TEXT)

statement ok
CREATE FUNCTION tn_fn() RETURNS trigger LANGUAGE nusascript AS $$ BEGIN INSERT INTO tlog VALUES (TG_OP, NEW.id, 0, coalesce((cardinality(NEW.ar))::TEXT, 'null')); INSERT INTO tlog VALUES (TG_OP, NEW.id, 1, coalesce((NEW.ar @> ARRAY[1::bigint])::TEXT, 'null')); INSERT INTO tlog VALUES (TG_OP, NEW.id, 2, coalesce((9 = ANY(NEW.ar))::TEXT, 'null')); INSERT INTO tlog VALUES (TG_OP, NEW.id, 3, coalesce((array_length(NEW.ta, 1))::TEXT, 'null')); INSERT INTO tlog VALUES (TG_OP, NEW.id, 4, coalesce((NEW.r && OLD.r)::TEXT, 'null')); INSERT INTO tlog VALUES (TG_OP, NEW.id, 5, coalesce((NEW.r @> now())::TEXT, 'null')); INSERT INTO tlog VALUES (TG_OP, NEW.id, 6, coalesce((upper(NEW.r))::TEXT, 'null')); INSERT INTO tlog VALUES (TG_OP, NEW.id, 7, coalesce((isempty(NEW.r))::TEXT, 'null')); INSERT INTO tlog VALUES (TG_OP, NEW.id, 8, coalesce((NEW.ir @> 3)::TEXT, 'null')); INSERT INTO tlog VALUES (TG_OP, NEW.id, 9, coalesce((NEW.ir = OLD.ir)::TEXT, 'null')); INSERT INTO tlog VALUES (TG_OP, NEW.id, 10, coalesce((lower(NEW.nr))::TEXT, 'null')); INSERT INTO tlog VALUES (TG_OP, NEW.id, 11, coalesce((NEW.dr @> current_date)::TEXT, 'null')); INSERT INTO tlog VALUES (TG_OP, NEW.id, 12, coalesce((masklen(NEW.ip))::TEXT, 'null')); INSERT INTO tlog VALUES (TG_OP, NEW.id, 13, coalesce((NEW.ip << '10.0.0.0/8'::inet)::TEXT, 'null')); INSERT INTO tlog VALUES (TG_OP, NEW.id, 14, coalesce((family(NEW.ip))::TEXT, 'null')); INSERT INTO tlog VALUES (TG_OP, NEW.id, 15, coalesce((masklen(NEW.cd))::TEXT, 'null')); INSERT INTO tlog VALUES (TG_OP, NEW.id, 16, coalesce((NEW.b & B'101')::TEXT, 'null')); INSERT INTO tlog VALUES (TG_OP, NEW.id, 17, coalesce((length(NEW.b))::TEXT, 'null')); INSERT INTO tlog VALUES (TG_OP, NEW.id, 18, coalesce((length(NEW.vb))::TEXT, 'null')); INSERT INTO tlog VALUES (TG_OP, NEW.id, 19, coalesce((NEW.vb || B'1')::TEXT, 'null')); INSERT INTO tlog VALUES (TG_OP, NEW.id, 20, coalesce((length(NEW.bt))::TEXT, 'null')); INSERT INTO tlog VALUES (TG_OP, NEW.id, 21, coalesce((NEW.bt || '\x01'::bytea)::TEXT, 'null')); INSERT INTO tlog VALUES (TG_OP, NEW.id, 22, coalesce((NEW.p <-> '(0,0)'::point)::TEXT, 'null')); INSERT INTO tlog VALUES (TG_OP, NEW.id, 23, coalesce((NEW.tv @@ 'a'::tsquery)::TEXT, 'null')); INSERT INTO tlog VALUES (TG_OP, NEW.id, 24, coalesce((length(NEW.tv))::TEXT, 'null')); INSERT INTO tlog VALUES (TG_OP, NEW.id, 25, coalesce(('a b'::tsvector @@ NEW.tq)::TEXT, 'null')); INSERT INTO tlog VALUES (TG_OP, NEW.id, 26, coalesce((NEW.x::text)::TEXT, 'null')); RETURN NEW; END $$

statement ok
CREATE TRIGGER tn_trg BEFORE INSERT OR UPDATE ON tn FOR EACH ROW EXECUTE FUNCTION tn_fn()

statement ok
INSERT INTO tn (id) VALUES (1)

statement ok
UPDATE tn SET id = 1 WHERE id = 1

