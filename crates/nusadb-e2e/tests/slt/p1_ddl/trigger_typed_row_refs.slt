# Outside triggers too: a value of these types stored into a TEXT column becomes its text form, and
# a string literal compared with an array takes the array's type.
statement ok
CREATE TABLE tt (v TEXT)

statement ok
INSERT INTO tt VALUES ('10.0.0.1'::INET), ('[1,5)'::INT4RANGE), ('{a}'::TEXT[]), ('(1,2)'::POINT), ('<a/>'::XML)

query T
SELECT v FROM tt ORDER BY v
----
(1,2)
10.0.0.1/32
<a/>
[1,5)
{a}

statement ok
CREATE TABLE ca (ta TEXT[], ia INT[])

statement ok
INSERT INTO ca VALUES ('{a,b}', '{1,2}')

query TTTT
SELECT (ta = '{a,b}')::TEXT, (ia = '{1,2}')::TEXT, ('{1,2}' = ia)::TEXT, (ia <> '{1}')::TEXT FROM ca
----
true true true true

# ADD COLUMN backfills such a default, or a generated value of such a type, into a TEXT column as
# its text form.
statement ok
CREATE TABLE d6 (id INT, ar INT[])

statement ok
INSERT INTO d6 VALUES (1, ARRAY[1,2])

statement ok
ALTER TABLE d6 ADD COLUMN t2 TEXT DEFAULT '{1,2}'::INT[]

statement ok
ALTER TABLE d6 ADD COLUMN t3 TEXT DEFAULT '[1,5]'::INT4RANGE

statement ok
ALTER TABLE d6 ADD COLUMN g TEXT GENERATED ALWAYS AS (ar) STORED

statement ok
INSERT INTO d6 (id, ar) VALUES (2, ARRAY[3])

query ITTT
SELECT id, t2, t3, g FROM d6 ORDER BY id
----
1 {1,2} [1,6) {1,2}
2 {1,2} [1,6) {3}
