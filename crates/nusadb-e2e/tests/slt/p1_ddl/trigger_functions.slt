# In a function shared by several events, the row an event lacks reads as null.
statement ok
CREATE FUNCTION both_rows() RETURNS trigger LANGUAGE nusascript AS $$ BEGIN INSERT INTO tlog (op, name) VALUES (TG_OP, COALESCE(CAST(OLD.v AS TEXT), 'none') || '/' || COALESCE(CAST(NEW.v AS TEXT), 'none')); RETURN NULL; END $$

statement ok
CREATE TABLE both_t (v INT)

statement ok
CREATE TRIGGER both_rows AFTER INSERT OR DELETE ON both_t FOR EACH ROW EXECUTE FUNCTION both_rows()

statement ok
DELETE FROM tlog

statement ok
INSERT INTO both_t VALUES (4)

statement ok
DELETE FROM both_t

query TT
SELECT op, name FROM tlog ORDER BY op
----
DELETE 4/none
INSERT none/4

# A trigger that skips a row a cascade must change is refused: the row would break the key.
