# A trigger on a referencing table may change other columns of a row an ON UPDATE action writes
# (CHECK still applies), but not its keys: the action computed them.
statement ok
CREATE TABLE upar (id INT PRIMARY KEY)

statement ok
CREATE TABLE uchi (p INT REFERENCES upar (id) ON UPDATE CASCADE, touched INT CHECK (touched < 100))

statement ok
CREATE TABLE nchi (p INT REFERENCES upar (id) ON UPDATE SET NULL)

statement ok
INSERT INTO upar VALUES (1)

statement ok
INSERT INTO uchi VALUES (1, 0)

statement ok
CREATE FUNCTION touch() RETURNS trigger LANGUAGE nusascript AS $$ BEGIN NEW.touched := COALESCE(OLD.touched, 0) + 1; RETURN NEW; END $$

statement ok
CREATE TRIGGER touch BEFORE UPDATE ON uchi FOR EACH ROW EXECUTE FUNCTION touch()

statement ok
