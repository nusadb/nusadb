# A BEFORE DELETE trigger that skips a moving row keeps it where it was: not moved, not returned.
statement ok
CREATE FUNCTION pin_odd() RETURNS trigger LANGUAGE nusascript AS $$ BEGIN IF OLD.id % 2 = 1 THEN RETURN NULL; END IF; RETURN OLD; END $$

statement ok
CREATE TABLE pm (k INT NOT NULL, id INT) PARTITION BY LIST (k)

statement ok
CREATE TABLE pm_1 PARTITION OF pm FOR VALUES IN (1)

statement ok
CREATE TABLE pm_2 PARTITION OF pm FOR VALUES IN (2)

statement ok
INSERT INTO pm VALUES (1, 1), (1, 2), (1, 3)

statement ok
CREATE TRIGGER pin_odd BEFORE DELETE ON pm FOR EACH ROW EXECUTE FUNCTION pin_odd()

query I
UPDATE pm SET k = 2 RETURNING id
----
2

query II
SELECT k, id FROM pm ORDER BY id
----
1 1
2 2
1 3

statement ok
INSERT INTO pm VALUES (1, 4), (1, 5)

statement count 1
UPDATE pm SET k = 2 WHERE id >= 4

# A trigger function returns NEW, OLD or NULL only, and NEW exists only where the event has one.
statement ok
