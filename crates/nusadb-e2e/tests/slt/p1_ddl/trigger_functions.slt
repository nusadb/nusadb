# A trigger a cascade fires on a referencing row sees its parent already deleted.
statement ok
CREATE TABLE cpar (id INT PRIMARY KEY)

statement ok
CREATE TABLE cchi (p INT REFERENCES cpar (id) ON DELETE CASCADE)

statement ok
CREATE TABLE cseen (parents INT)

statement ok
INSERT INTO cpar VALUES (1), (2)

statement ok
INSERT INTO cchi VALUES (1)

statement ok
CREATE FUNCTION seen() RETURNS trigger LANGUAGE nusascript AS $$ BEGIN INSERT INTO cseen SELECT count(*) FROM cpar WHERE id = OLD.p; RETURN OLD; END $$

statement ok
CREATE TRIGGER seen BEFORE DELETE ON cchi FOR EACH ROW EXECUTE FUNCTION seen()

statement ok
DELETE FROM cpar WHERE id = 1

statement ok
INSERT INTO cchi VALUES (2)

statement ok
MERGE INTO cpar USING (VALUES (2)) AS s (id) ON cpar.id = s.id WHEN MATCHED THEN DELETE

