statement ok
CREATE TABLE gb (b BIT(3), s TEXT GENERATED ALWAYS AS (b) STORED)

# Refused: bit string length 4 does not match type bit(3)
statement error
INSERT INTO gb (b) VALUES ('1010')

statement ok
INSERT INTO gb (b) VALUES ('101')

query TT
SELECT b::TEXT, s FROM gb
----
101 101
