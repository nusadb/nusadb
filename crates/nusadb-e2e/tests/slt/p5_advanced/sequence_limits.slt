# p5_advanced/sequence_limits: a sequence that runs out, and a setval outside its bounds.
#
# A non-cycling sequence that has handed out its last value refuses the next nextval with 2200H,
# naming the sequence and the bound it reached. The SQLSTATEs are asserted in
# tests/sequence_limits.rs; this file pins the messages and the values.

statement ok
CREATE SEQUENCE up MAXVALUE 2

query I
SELECT nextval('up')
----
1

query I
SELECT nextval('up')
----
2

statement error nextval: reached maximum value of sequence "up" \(2\)
SELECT nextval('up')

# A failed call does not move the sequence: it stays exhausted.
statement error nextval: reached maximum value of sequence "up" \(2\)
SELECT nextval('up')

# A descending sequence stops at its MINVALUE.
statement ok
CREATE SEQUENCE down INCREMENT -1 MINVALUE -2 MAXVALUE 0 START 0

query III
SELECT nextval('down'), nextval('down'), nextval('down')
----
0 -1 -2

statement error nextval: reached minimum value of sequence "down" \(-2\)
SELECT nextval('down')

# CYCLE wraps to the opposite bound instead of failing, in both directions.
statement ok
CREATE SEQUENCE ring MAXVALUE 2 CYCLE

query III
SELECT nextval('ring'), nextval('ring'), nextval('ring')
----
1 2 1

statement ok
CREATE SEQUENCE ring_down INCREMENT -1 MINVALUE 1 MAXVALUE 2 START 2 CYCLE

query III
SELECT nextval('ring_down'), nextval('ring_down'), nextval('ring_down')
----
2 1 2

# A sequence at the top of the 64-bit range runs out there.
statement ok
CREATE SEQUENCE top START 9223372036854775807

query I
SELECT nextval('top')
----
9223372036854775807

statement error nextval: reached maximum value of sequence "top" \(9223372036854775807\)
SELECT nextval('top')

# setval accepts a value inside the bounds and refuses one outside them, leaving the sequence alone.
statement error setval: value 5 is out of bounds for sequence "up" \(1\.\.2\)
SELECT setval('up', 5)

statement error setval: value 0 is out of bounds for sequence "up" \(1\.\.2\)
SELECT setval('up', 0)

query I
SELECT setval('up', 1)
----
1

query I
SELECT nextval('up')
----
2

# A SERIAL column whose sequence runs out refuses the row and writes nothing.
statement ok
CREATE TABLE s (id SERIAL, v INT)

statement ok
ALTER SEQUENCE s_id_seq MAXVALUE 2

statement ok
INSERT INTO s (v) VALUES (1), (2)

statement error nextval: reached maximum value of sequence "s_id_seq" \(2\)
INSERT INTO s (v) VALUES (3)

# A multi-row INSERT that runs out part way writes none of its rows.
statement ok
ALTER SEQUENCE s_id_seq MAXVALUE 3

statement error nextval: reached maximum value of sequence "s_id_seq" \(3\)
INSERT INTO s (v) VALUES (4), (5)

query II
SELECT id, v FROM s ORDER BY id
----
1 1
2 2

# The other paths that draw from the sequence report it the same way.
statement error nextval: reached maximum value of sequence "s_id_seq" \(3\)
UPDATE s SET id = DEFAULT WHERE v = 1

statement error nextval: reached maximum value of sequence "s_id_seq" \(3\)
INSERT INTO s (v) VALUES (6) ON CONFLICT DO NOTHING

statement error nextval: reached maximum value of sequence "s_id_seq" \(3\)
MERGE INTO s USING (SELECT 7 AS k) src ON false WHEN NOT MATCHED THEN INSERT (v) VALUES (src.k)

statement ok
CREATE TABLE s_log (v INT)

statement ok
CREATE TRIGGER s_copy AFTER INSERT ON s_log FOR EACH ROW INSERT INTO s (v) VALUES (NEW.v)

statement error nextval: reached maximum value of sequence "s_id_seq" \(3\)
INSERT INTO s_log VALUES (8)

statement error nextval: reached maximum value of sequence "up" \(2\)
DO $$ BEGIN PERFORM nextval('up'); END $$

query I
SELECT count(*) FROM s_log
----
0

# An identity column of a narrower integer type stops at that type's maximum, before it produces a
# value the column cannot hold.
statement ok
CREATE TABLE small_id (id SMALLINT GENERATED BY DEFAULT AS IDENTITY, v INT)

query I
SELECT setval('small_id_id_seq', 32766)
----
32766

statement ok
INSERT INTO small_id (v) VALUES (1)

statement error nextval: reached maximum value of sequence "small_id_id_seq" \(32767\)
INSERT INTO small_id (v) VALUES (2)

query II
SELECT id, v FROM small_id
----
32767 1

statement ok
CREATE TABLE int_id (id INT GENERATED ALWAYS AS IDENTITY, v INT)

query I
SELECT setval('int_id_id_seq', 2147483647)
----
2147483647

statement error nextval: reached maximum value of sequence "int_id_id_seq" \(2147483647\)
INSERT INTO int_id (v) VALUES (1)

# A copy of the table made with LIKE ... INCLUDING IDENTITY keeps the bound.
statement ok
CREATE TABLE int_id_copy (LIKE int_id INCLUDING IDENTITY)

query I
SELECT setval('int_id_copy_id_seq', 2147483647)
----
2147483647

statement error nextval: reached maximum value of sequence "int_id_copy_id_seq" \(2147483647\)
INSERT INTO int_id_copy (v) VALUES (1)

# A BIGINT identity column has the full 64-bit range.
statement ok
CREATE TABLE big_id (id BIGINT GENERATED BY DEFAULT AS IDENTITY, v INT)

query I
SELECT setval('big_id_id_seq', 2147483647)
----
2147483647

statement ok
INSERT INTO big_id (v) VALUES (1)

query I
SELECT id FROM big_id
----
2147483648

# Widening the column's type lifts the bound with it: the next value is the one after the last.
statement ok
CREATE TABLE widen (id INT GENERATED ALWAYS AS IDENTITY, v INT)

query I
SELECT setval('widen_id_seq', 2147483646)
----
2147483646

statement ok
INSERT INTO widen (v) VALUES (1)

statement error nextval: reached maximum value of sequence "widen_id_seq" \(2147483647\)
INSERT INTO widen (v) VALUES (2)

# A rolled-back widening leaves the bound where it was.
statement ok
BEGIN

statement ok
ALTER TABLE widen ALTER COLUMN id TYPE BIGINT

statement ok
ROLLBACK

statement error nextval: reached maximum value of sequence "widen_id_seq" \(2147483647\)
INSERT INTO widen (v) VALUES (2)

statement ok
ALTER TABLE widen ALTER COLUMN id TYPE BIGINT

statement ok
INSERT INTO widen (v) VALUES (2)

query II
SELECT id, v FROM widen ORDER BY id
----
2147483647 1
2147483648 2

# From SMALLINT, a value past 32767 is accepted once the column is BIGINT.
statement ok
CREATE TABLE widen_small (id SMALLINT GENERATED BY DEFAULT AS IDENTITY, v INT)

statement ok
ALTER TABLE widen_small ALTER COLUMN id TYPE BIGINT

query I
SELECT setval('widen_small_id_seq', 40000)
----
40000

statement ok
INSERT INTO widen_small (v) VALUES (1)

query I
SELECT id FROM widen_small
----
40001

# Narrowing is refused while the sequence has already handed out a value the new type cannot hold,
# and accepted, with the new bound, when it has not.
statement ok
CREATE TABLE narrow (id BIGINT GENERATED BY DEFAULT AS IDENTITY, v INT)

query I
SELECT setval('narrow_id_seq', 3000000000)
----
3000000000

statement error sequence "narrow_id_seq" has already handed out 3000000000, more than the new type of column "id" holds \(maximum 2147483647\)
ALTER TABLE narrow ALTER COLUMN id TYPE INT

query I
SELECT setval('narrow_id_seq', 2147483646)
----
2147483646

statement ok
ALTER TABLE narrow ALTER COLUMN id TYPE INT

statement ok
INSERT INTO narrow (v) VALUES (1)

statement error nextval: reached maximum value of sequence "narrow_id_seq" \(2147483647\)
INSERT INTO narrow (v) VALUES (2)

# A sequence that cycles at a bound inside the column's type wraps there, in either direction.
statement ok
CREATE TABLE cy (id SMALLINT GENERATED BY DEFAULT AS IDENTITY, v INT)

statement ok
ALTER SEQUENCE cy_id_seq MAXVALUE 32767 CYCLE

query I
SELECT setval('cy_id_seq', 32766)
----
32766

statement ok
INSERT INTO cy (v) VALUES (1)

statement ok
INSERT INTO cy (v) VALUES (2)

query II
SELECT id, v FROM cy ORDER BY v
----
32767 1
1 2

statement ok
CREATE TABLE cy_int (id INT GENERATED BY DEFAULT AS IDENTITY, v INT)

statement ok
ALTER SEQUENCE cy_int_id_seq MAXVALUE 2147483647 CYCLE

query I
SELECT setval('cy_int_id_seq', 2147483647)
----
2147483647

statement ok
INSERT INTO cy_int (v) VALUES (1)

query I
SELECT id FROM cy_int
----
1

statement ok
CREATE TABLE cy_down (id SMALLINT GENERATED BY DEFAULT AS IDENTITY, v INT)

statement ok
ALTER SEQUENCE cy_down_id_seq INCREMENT -1 MINVALUE -32768 MAXVALUE 3 START -32767 RESTART CYCLE

statement ok
INSERT INTO cy_down (v) VALUES (1), (2), (3)

query II
SELECT id, v FROM cy_down ORDER BY v
----
-32767 1
-32768 2
3 3

# Without CYCLE, a descending sequence stops at the bottom of the type.
statement ok
CREATE TABLE down_stop (id SMALLINT GENERATED BY DEFAULT AS IDENTITY, v INT)

statement ok
ALTER SEQUENCE down_stop_id_seq INCREMENT -1 MINVALUE -40000 MAXVALUE 3 START -32767 RESTART

statement ok
INSERT INTO down_stop (v) VALUES (1), (2)

statement error nextval: reached minimum value of sequence "down_stop_id_seq" \(-32768\)
INSERT INTO down_stop (v) VALUES (3)

# An increment larger than one that jumps from inside the range past its edge is refused too, and
# so is every later draw.
statement ok
CREATE TABLE jump (id SMALLINT GENERATED BY DEFAULT AS IDENTITY, v INT)

statement ok
ALTER SEQUENCE jump_id_seq INCREMENT 10

query I
SELECT setval('jump_id_seq', 32760)
----
32760

statement error nextval: reached maximum value of sequence "jump_id_seq" \(32767\)
INSERT INTO jump (v) VALUES (1)

statement error nextval: reached maximum value of sequence "jump_id_seq" \(32767\)
INSERT INTO jump (v) VALUES (2)

query I
SELECT count(*) FROM jump
----
0

# A user constraint that carries the reserved name of a type check is not read as the column's type.
statement ok
CREATE TABLE named (id BIGINT GENERATED BY DEFAULT AS IDENTITY, v INT, CONSTRAINT nusadb_typeck_id CHECK (id BETWEEN 0 AND 5))

query I
SELECT setval('named_id_seq', 5)
----
5

statement error violates check constraint "nusadb_typeck_id"
INSERT INTO named (v) VALUES (1)

# Inside a transaction block the failed statement writes nothing and moves nothing.
statement ok
BEGIN

statement ok
INSERT INTO big_id (v) VALUES (2)

statement error nextval: reached maximum value of sequence "up" \(2\)
INSERT INTO big_id (v) VALUES (nextval('up'))

statement ok
ROLLBACK

query I
SELECT count(*) FROM big_id
----
1

query I
SELECT currval('up')
----
2
