# p12_txn/for_update — SELECT ... FOR UPDATE / FOR SHARE row locking (friend-QA R44 D2).
#
# FOR UPDATE/SHARE takes a row lock on each matched base row (the lost-update escape hatch). The
# locking is transparent to the result: the SELECT returns its rows unchanged. Within an explicit
# transaction the lock is held until COMMIT; the lock manager is no-wait, so a concurrent writer of a
# locked row aborts with a serialization conflict rather than blocking.

statement ok
CREATE TABLE acct (id INT NOT NULL, bal INT)

statement ok
INSERT INTO acct VALUES (1, 100), (2, 200), (3, 300)

# FOR UPDATE returns the selected rows (the lock is taken transparently).
query II
SELECT id, bal FROM acct WHERE id = 2 FOR UPDATE
----
2 200

# FOR SHARE likewise, over all rows.
query II
SELECT id, bal FROM acct ORDER BY id FOR SHARE
----
1 100
2 200
3 300

# The real escape-hatch usage: lock a row in an explicit transaction, then update it.
statement ok
BEGIN

query II
SELECT id, bal FROM acct WHERE id = 1 FOR UPDATE
----
1 100

statement ok
UPDATE acct SET bal = 150 WHERE id = 1

statement ok
COMMIT

query I
SELECT bal FROM acct WHERE id = 1
----
150

# --- Unsupported shapes are rejected honestly (v1: single base table only) ---

# Aggregate.
statement error
SELECT count(*) FROM acct FOR UPDATE

# Join.
statement error
SELECT a.id FROM acct a JOIN acct b ON a.id = b.id FOR UPDATE

# Subquery in the predicate.
statement error
SELECT id FROM acct WHERE id IN (SELECT id FROM acct) FOR UPDATE

# NOWAIT IS supported: with no competing lock it returns every matched row (a held row instead
# fails with lock_not_available — covered by the concurrent-session test in end_to_end.rs).
query I
SELECT id FROM acct ORDER BY id FOR UPDATE NOWAIT
----
1
2
3

# SKIP LOCKED IS supported: with no competing lock it is a no-op that returns every matched row (the
# row-skipping under contention is covered by the concurrent-session test in end_to_end.rs).
query I
SELECT id FROM acct ORDER BY id FOR UPDATE SKIP LOCKED
----
1
2
3

# FOR UPDATE OF <the base table> is accepted — it locks the same rows as a bare FOR UPDATE.
query I
SELECT id FROM acct ORDER BY id FOR UPDATE OF acct
----
1
2
3

# With an alias, OF must name the alias (as the reference engine requires).
query I
SELECT id FROM acct AS a ORDER BY id FOR UPDATE OF a
----
1
2
3

# OF a relation not in the FROM is rejected; OF the real name when an alias is in force is too.
statement error
SELECT id FROM acct FOR UPDATE OF nope

statement error
SELECT id FROM acct AS a FOR UPDATE OF acct
