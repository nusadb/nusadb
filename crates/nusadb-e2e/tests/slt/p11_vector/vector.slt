# p11_vector/vector — VECTOR(n) type + distance operator/functions.
# Covers: VECTOR(n) catalog type, `[..]` text-literal storage (vector form), canonical display,
# CAST text<->vector, dimension enforcement, the `<=>` cosine-distance operator, and the
# l2_distance / cosine_distance / inner_product functions (brute-force KNN via ORDER BY ... LIMIT).

statement ok
CREATE TABLE items (id INT NOT NULL, embedding VECTOR(3))

# A bare `[..]` text literal assigns into a VECTOR column (parsed + dimension-checked at encode).
statement ok
INSERT INTO items VALUES (1, '[1,0,0]'), (2, '[0,1,0]'), (3, '[1,1,0]')

# Canonical `[..]` vector display.
query IT
SELECT id, embedding FROM items ORDER BY id
----
1  [1,0,0]
2  [0,1,0]
3  [1,1,0]

# Wrong dimension is rejected (the column is VECTOR(3)).
statement error
INSERT INTO items VALUES (4, '[1,2,3,4]')

# Malformed literal is rejected.
statement error
INSERT INTO items VALUES (4, '[1,oops,3]')

# CAST text -> vector round-trips through the canonical form.
query T
SELECT CAST('[7,8,9]' AS VECTOR(3))
----
[7,8,9]

# CAST vector -> text yields the `[..]` form.
query T
SELECT CAST(embedding AS TEXT) FROM items WHERE id = 3
----
[1,1,0]

# `<=>` cosine distance to the query vector, with the `::` cast form.
query R
SELECT embedding <=> '[1,0,0]'::VECTOR(3) FROM items ORDER BY id
----
0.000
1.000
0.293

# Brute-force nearest-neighbour: ORDER BY cosine distance ASC, closest first.
query I
SELECT id FROM items ORDER BY embedding <=> CAST('[1,0,0]' AS VECTOR(3))
----
1
3
2

# l2_distance (Euclidean) to [1,0,0].
query R
SELECT l2_distance(embedding, '[1,0,0]'::VECTOR(3)) FROM items ORDER BY id
----
0.000
1.414
1.000

# cosine_distance matches the `<=>` operator.
query R
SELECT cosine_distance(embedding, '[1,0,0]'::VECTOR(3)) FROM items ORDER BY id
----
0.000
1.000
0.293

# inner_product() is the raw (positive) dot product a·b; query vector [2,3,0].
query R
SELECT inner_product(embedding, '[2,3,0]'::VECTOR(3)) FROM items ORDER BY id
----
2.000
3.000
5.000

# l1_distance() is the Manhattan distance Σ|aᵢ−bᵢ|.
query R
SELECT l1_distance('[1,2,3]'::VECTOR(3), '[4,6,8]'::VECTOR(3))
----
12.000

# `<->` is the Euclidean (L2) distance operator; matches l2_distance(). √(3²+4²+5²)=√50.
query R
SELECT '[1,2,3]'::VECTOR(3) <-> '[4,6,8]'::VECTOR(3)
----
7.071

# `<#>` is the negative inner product operator (smaller = nearer); −(1·2+2·3+3·0)=−8.
query R
SELECT '[1,2,3]'::VECTOR(3) <#> '[2,3,0]'::VECTOR(3)
----
-8.000

# `<+>` is the Manhattan (L1) distance operator; matches l1_distance(). |−3|+|−4|+|−5|=12.
query R
SELECT '[1,2,3]'::VECTOR(3) <+> '[4,6,8]'::VECTOR(3)
----
12.000

# The operators are usable as a KNN ordering key, like `<=>`.
query I
SELECT id FROM items ORDER BY embedding <-> '[1,0,0]'::VECTOR(3), id
----
1
3
2

# A NULL operand propagates NULL through each operator.
query T
SELECT '[1,2,3]'::VECTOR(3) <-> NULL
----
NULL

# A dimension mismatch through an operator is a type error.
statement error
SELECT '[1,2,3]'::VECTOR(3) <#> '[1,2]'::VECTOR(2)

# Regression: the new operators must not change how `<` parses. `<` immediately followed by a
# negative number — the classic `x<-5` case — stays a comparison, never a distance operator (the
# harness renders BOOL as 1/0).
query I
SELECT 3 < -5
----
0

query I
SELECT 3<-5
----
0

# A plain less-than is unaffected.
query I
SELECT 5 < 3
----
0

# `< +` is a comparison against a unary-plus operand, never the `<+>` distance operator.
query I
SELECT 3 < +5
----
1

# vector_dims() returns the dimension count as INT; vector_norm() the Euclidean magnitude.
query I
SELECT vector_dims('[1,2,3,4]'::VECTOR(4))
----
4

query R
SELECT vector_norm('[3,4]'::VECTOR(2))
----
5.000

# A dimension mismatch in l1_distance is a type error.
statement error
SELECT l1_distance('[1,2,3]'::VECTOR(3), '[1,2]'::VECTOR(2))

# A NULL operand propagates NULL through the operator.
query T
SELECT NULL <=> '[1,0,0]'::VECTOR(3)
----
NULL

# Comparing different dimensions is a type error.
statement error
SELECT embedding <=> '[1,0]'::VECTOR(2) FROM items

# --- element-wise vector arithmetic: + - * over two same-dimension vectors, yielding a vector ---
query T
SELECT '[1,2,3]'::VECTOR(3) + '[4,5,6]'::VECTOR(3)
----
[5,7,9]

query T
SELECT '[4,5,6]'::VECTOR(3) - '[1,2,3]'::VECTOR(3)
----
[3,3,3]

query T
SELECT '[1,2,3]'::VECTOR(3) * '[2,3,4]'::VECTOR(3)
----
[2,6,12]

# A NULL operand propagates NULL.
query T
SELECT NULL::VECTOR(3) + '[1,2,3]'::VECTOR(3)
----
NULL

# A dimension mismatch is a type error.
statement error
SELECT '[1,2,3]'::VECTOR(3) + '[1,2]'::VECTOR(2)

# Division / modulo are not defined on vectors.
statement error
SELECT '[1,2,3]'::VECTOR(3) / '[1,2,3]'::VECTOR(3)

# --- a USING hnsw vector index is visible in information_schema.statistics (catalog introspection) ---
statement ok
CREATE TABLE docs (id INT NOT NULL, emb VECTOR(3))

statement ok
CREATE INDEX docs_emb_hnsw ON docs USING hnsw (emb)

# The vector index appears in the statistics catalog (non_unique=1, position 1, on the emb column) —
# not only in EXPLAIN. Backs JDBC getIndexInfo, so a GUI/driver can see the index exists.
query IIT
SELECT non_unique, seq_in_index, column_name FROM information_schema.statistics
WHERE table_name = 'docs' AND index_name = 'docs_emb_hnsw'
----
1 1 emb

statement ok
DROP TABLE docs

# --- a plain CREATE INDEX on an existing vector-index name is rejected, not silently overwritten ---
statement ok
CREATE TABLE dupix (id INT NOT NULL, emb VECTOR(3))

statement ok
CREATE INDEX dupix_hnsw ON dupix USING hnsw (emb)

# Re-creating the same name without IF NOT EXISTS is an error — no silent clobber of the built graph.
statement error
CREATE INDEX dupix_hnsw ON dupix USING hnsw (emb)

# IF NOT EXISTS makes the duplicate a no-op (keeps the existing index).
statement ok
CREATE INDEX IF NOT EXISTS dupix_hnsw ON dupix USING hnsw (emb)

statement ok
DROP TABLE dupix

# --- a bare `[..]` text literal works in the distance operators, no ::VECTOR(n) cast needed ---
# The same literal form INSERT accepts into a VECTOR column also anchors to the sibling VECTOR
# operand in `<->` / `<=>` / `<#>` / `<+>`, so the rule is identical in both places.
statement ok
CREATE TABLE v5 (id INT NOT NULL, emb VECTOR(3))

statement ok
INSERT INTO v5 VALUES (1, '[1,0,0]'), (2, '[0,1,0]'), (3, '[1,1,0]')

# Bare literal on the right — cosine distance, same values as the explicit-cast form above.
query R
SELECT emb <=> '[1,0,0]' FROM v5 ORDER BY id
----
0.000
1.000
0.293

# Bare literal on the left of the operator coerces the same way.
query R
SELECT '[1,0,0]' <-> emb FROM v5 ORDER BY id
----
0.000
1.414
1.000

# Every row: the bare-literal form equals the explicit-cast form, for every operator — the invariant
# that the coercion rule must not differ between the two spellings.
query I
SELECT count(*) FROM v5
WHERE (emb <-> '[1,0,0]') = (emb <-> '[1,0,0]'::VECTOR(3))
  AND (emb <=> '[1,0,0]') = (emb <=> '[1,0,0]'::VECTOR(3))
  AND (emb <#> '[1,0,0]') = (emb <#> '[1,0,0]'::VECTOR(3))
  AND (emb <+> '[1,0,0]') = (emb <+> '[1,0,0]'::VECTOR(3))
----
3

# Bare literal is usable as a KNN ordering key without a cast.
query I
SELECT id FROM v5 ORDER BY emb <-> '[1,0,0]', id
----
1
3
2

statement ok
DROP TABLE v5
