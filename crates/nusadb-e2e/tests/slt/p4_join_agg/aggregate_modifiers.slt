# p4_join_agg/aggregate_modifiers — aggregate FILTER, DISTINCT inside aggregates,
# and ordered-set aggregates WITHIN GROUP.
# NULLs are skipped by aggregates; FILTER restricts the rows fed to one aggregate only.

statement ok
CREATE TABLE m (grp TEXT, v INT)

statement ok
INSERT INTO m VALUES
  ('a', 10),
  ('a', 10),
  ('a', 20),
  ('a', NULL),
  ('b', 30),
  ('b', 40),
  ('b', 40)

# --- FILTER (WHERE ...) ------------------------------------------------------

# COUNT(*) FILTER counts only rows passing the predicate (NULL v fails v > 15).
query I
SELECT COUNT(*) FILTER (WHERE v > 15) FROM m
----
4

# Two aggregates with different FILTERs in one query, each scoped independently.
query II
SELECT SUM(v) FILTER (WHERE v >= 30), COUNT(*) FILTER (WHERE v = 40) FROM m
----
110  2

# FILTER combined with GROUP BY: applied per group.
query TI rowsort
SELECT grp, COUNT(*) FILTER (WHERE v > 15) FROM m GROUP BY grp
----
a  1
b  3

# --- DISTINCT inside aggregates ---------------------------------------------

# COUNT(DISTINCT) / SUM(DISTINCT) ignore duplicates and NULLs.
query II
SELECT COUNT(DISTINCT v), SUM(DISTINCT v) FROM m
----
4  100

# Per group.
query TII rowsort
SELECT grp, COUNT(DISTINCT v), SUM(DISTINCT v) FROM m GROUP BY grp
----
a  2  30
b  2  70

# DISTINCT dedup is consistent with comparison (A-perf hash bucket): different NUMERIC scales of the
# same value count once (1.0 == 1.00 == 1; 2.5 == 2.50) -> 2 distinct, summing to 3.5.
statement ok
CREATE TABLE dn (x NUMERIC)

statement ok
INSERT INTO dn VALUES (1.0), (1.00), (1), (2.5), (2.50)

query I
SELECT COUNT(DISTINCT x) FROM dn
----
2

query T
SELECT CAST(SUM(DISTINCT x) AS TEXT) FROM dn
----
3.5

# High-precision regression: the same value past 2^53 with different trailing-zero scales is ONE
# distinct value (an exact decimal key, not a lossy f64, keeps them in the same bucket).
statement ok
CREATE TABLE dh (x NUMERIC)

statement ok
INSERT INTO dh VALUES (123456789012345678), (123456789012345678.00), (123456789012345679)

query I
SELECT COUNT(DISTINCT x) FROM dh
----
2

# Signed zero: -0.0 and 0.0 are the same FLOAT value -> one distinct.
statement ok
CREATE TABLE dz (f FLOAT)

statement ok
INSERT INTO dz VALUES (0.0), (-0.0), (1.5)

query I
SELECT COUNT(DISTINCT f) FROM dz
----
2

# --- Ordered-set aggregates (WITHIN GROUP) ----------------------------------
# Non-NULL values, sorted: 10, 10, 20, 30, 40, 40 (n = 6).

# PERCENTILE_DISC(0.5) returns an actual data point: the 3rd value (ceil(0.5*6)) = 20.
query I
SELECT PERCENTILE_DISC(0.5) WITHIN GROUP (ORDER BY v) FROM m
----
20

# MODE() returns the most frequent value; ties resolve to the smallest (10 and 40 both appear twice).
query I
SELECT MODE() WITHIN GROUP (ORDER BY v) FROM m
----
10

# PERCENTILE_DISC(0) is the minimum, PERCENTILE_DISC(1) is the maximum.
query II
SELECT PERCENTILE_DISC(0) WITHIN GROUP (ORDER BY v),
       PERCENTILE_DISC(1) WITHIN GROUP (ORDER BY v)
FROM m
----
10  40

# Array-of-fractions: PERCENTILE_DISC(ARRAY[...]) returns one data point per fraction, as an array.
# d0 = 10 (min), d0.5 = ceil(0.5*6) = 3rd = 20, d1 = 40 (max).
query T
SELECT PERCENTILE_DISC(ARRAY[0, 0.5, 1]) WITHIN GROUP (ORDER BY v) FROM m
----
{10,20,40}

# --- jsonb_agg: collect values into a JSON array (B) ---------------------------
# Non-NULL values in sorted order form a JSON array.
query T
SELECT jsonb_agg(v ORDER BY v) FROM m WHERE v IS NOT NULL
----
[10, 10, 20, 30, 40, 40]

# NULLs are kept as JSON null (unlike the NULL-skipping numeric aggregates).
query T
SELECT jsonb_agg(v ORDER BY v) FROM m WHERE grp = 'a'
----
[10, 10, 20, null]

# Grouped: one JSON array per group.
query TT rowsort
SELECT grp, jsonb_agg(v ORDER BY v) FROM m WHERE v IS NOT NULL GROUP BY grp
----
a  [10, 10, 20]
b  [30, 40, 40]

# --- COUNT over a row value: counts field tuples, not rows ---
# (grp, v) pairs in `m`: (a,10) (a,10) (a,20) (a,NULL) (b,30) (b,40) (b,40)
# → 5 distinct pairs, while `m` has 7 rows, 2 distinct grp and 4 distinct v.
query I
SELECT count(DISTINCT (grp, v)) FROM m
----
5

# The ROW(...) spelling is the same call.
query I
SELECT count(DISTINCT ROW(grp, v)) FROM m
----
5

# Same answer asked without the composite aggregate.
query I
SELECT count(*) FROM (SELECT DISTINCT grp, v FROM m) s
----
5

# A row constructor is never NULL, so without DISTINCT every row counts — including the row
# whose `v` is NULL and which `count(v)` skips.
query II
SELECT count((grp, v)), count(v) FROM m
----
7  6

# Per group.
query TI rowsort
SELECT grp, count(DISTINCT (grp, v)) FROM m GROUP BY grp
----
a  3
b  2

# --- Hypothetical-set aggregates (WITHIN GROUP) -----------------------------
# rank/dense_rank/percent_rank/cume_dist rank a hypothetical direct argument against the ordered
# group. Expected values verified against the reference oracle.

statement ok
CREATE TABLE hs (x INT)

statement ok
INSERT INTO hs VALUES (1), (2), (3), (4), (5), (6)

# x = 1..6 (n = 6). rank(4) = 1 + count(x < 4) = 4; dense_rank matches (no ties).
query II
SELECT rank(4) WITHIN GROUP (ORDER BY x),
       dense_rank(4) WITHIN GROUP (ORDER BY x)
FROM hs
----
4  4

# percent_rank(4) = (4 - 1) / 6 = 0.5; cume_dist(4) = (count(x <= 4) + 1) / (6 + 1) = 5/7.
query RR
SELECT percent_rank(4) WITHIN GROUP (ORDER BY x),
       cume_dist(4) WITHIN GROUP (ORDER BY x)
FROM hs
----
0.500  0.714

# DESC reverses "before": rank(4) DESC = 1 + count(x > 4) = 3; cume_dist(4) DESC = (count(x >= 4)+1)/7 = 4/7.
query IR
SELECT rank(4) WITHIN GROUP (ORDER BY x DESC),
       cume_dist(4) WITHIN GROUP (ORDER BY x DESC)
FROM hs
----
3  0.571

# Argument above the max (absent, would sort last ASC): rank = n + 1 = 7; cume_dist = 1; percent_rank = 1.
query IRR
SELECT rank(7) WITHIN GROUP (ORDER BY x),
       cume_dist(7) WITHIN GROUP (ORDER BY x),
       percent_rank(7) WITHIN GROUP (ORDER BY x)
FROM hs
----
7  1.000  1.000

# Argument below the min: rank = 1.
query I
SELECT rank(0) WITHIN GROUP (ORDER BY x) FROM hs
----
1

statement ok
CREATE TABLE ht (x INT)

statement ok
INSERT INTO ht VALUES (1), (3), (3), (5)

# Ties: x = 1,3,3,5. rank(3) = 1 + count(x < 3) = 2; dense_rank(3) = 1 + distinct(x < 3) = 2.
query II
SELECT rank(3) WITHIN GROUP (ORDER BY x),
       dense_rank(3) WITHIN GROUP (ORDER BY x)
FROM ht
----
2  2

# cume_dist(3) counts ties as <= : (count(x <= 3) + 1)/(4 + 1) = (3 + 1)/5 = 0.8.
query R
SELECT cume_dist(3) WITHIN GROUP (ORDER BY x) FROM ht
----
0.800

# DESC with ties: rank(3) DESC = 1 + count(x > 3) = 2; cume_dist(3) DESC = (count(x >= 3)+1)/5 = 4/5 = 0.8.
query IR
SELECT rank(3) WITHIN GROUP (ORDER BY x DESC),
       cume_dist(3) WITHIN GROUP (ORDER BY x DESC)
FROM ht
----
2  0.800

# dense_rank(4) over ties: distinct x < 4 = {1,3} = 2, so dense_rank = 3.
query I
SELECT dense_rank(4) WITHIN GROUP (ORDER BY x) FROM ht
----
3

statement ok
CREATE TABLE h1 (x INT)

statement ok
INSERT INTO h1 VALUES (5)

# n = 1. rank(5) = 1 (nothing before), rank(10) = 2 (one value before), percent_rank = 0, cume_dist = 1.
query IIRR
SELECT rank(5) WITHIN GROUP (ORDER BY x),
       rank(10) WITHIN GROUP (ORDER BY x),
       percent_rank(5) WITHIN GROUP (ORDER BY x),
       cume_dist(5) WITHIN GROUP (ORDER BY x)
FROM h1
----
1  2  0.000  1.000

statement ok
CREATE TABLE he (x INT)

# Empty group (n = 0): rank/dense_rank = 1, percent_rank = 0, cume_dist = (0+1)/(0+1) = 1.
query IIRR
SELECT rank(4) WITHIN GROUP (ORDER BY x),
       dense_rank(4) WITHIN GROUP (ORDER BY x),
       percent_rank(4) WITHIN GROUP (ORDER BY x),
       cume_dist(4) WITHIN GROUP (ORDER BY x)
FROM he
----
1  1  0.000  1.000

statement ok
CREATE TABLE hg (g TEXT, x INT)

statement ok
INSERT INTO hg VALUES ('a', 1), ('a', 2), ('a', 3), ('b', 10), ('b', 20)

# Grouped: group 'a' (1,2,3): rank(5) = 4, cume_dist(5) = (3+1)/(3+1) = 1.
# group 'b' (10,20): rank(5) = 1, cume_dist(5) = (0+1)/(2+1) = 1/3.
query TIR rowsort
SELECT g,
       rank(5) WITHIN GROUP (ORDER BY x),
       cume_dist(5) WITHIN GROUP (ORDER BY x)
FROM hg GROUP BY g
----
a  4  1.000
b  1  0.333

# A hypothetical-set aggregate used as a plain (non-WITHIN-GROUP) call is a loud error.
statement error
SELECT rank(4) FROM hs

statement error
SELECT cume_dist(4) FROM hs

# --- Multi-key hypothetical-set aggregates (WITHIN GROUP with N ORDER BY keys) ---
# The N direct arguments form a tuple compared lexicographically against each row's key tuple, each
# key honoring its own ASC/DESC. Expected values verified against the reference oracle.

statement ok
CREATE TABLE mk (a INT, b INT)

statement ok
INSERT INTO mk VALUES (1, 10), (1, 20), (2, 10), (2, 20), (3, 5)

# rank(2,15) ORDER BY a, b = 4 (precede: (1,10),(1,20),(2,10)); dense_rank = 4;
# percent_rank = (4-1)/5 = 0.6; cume_dist = (4+1-1)/(5+1) ... = count(<=)=4 -> (4+1)/6 = 0.667.
query IIRR
SELECT rank(2, 15) WITHIN GROUP (ORDER BY a, b),
       dense_rank(2, 15) WITHIN GROUP (ORDER BY a, b),
       percent_rank(2, 15) WITHIN GROUP (ORDER BY a, b),
       cume_dist(2, 15) WITHIN GROUP (ORDER BY a, b)
FROM mk
----
4  4  0.600  0.667

# ASC/DESC mix — b descending: for a=2 a row with b>15 now precedes. rank(2,15) = 4; cume_dist = 0.667.
query IR
SELECT rank(2, 15) WITHIN GROUP (ORDER BY a, b DESC),
       cume_dist(2, 15) WITHIN GROUP (ORDER BY a, b DESC)
FROM mk
----
4  0.667

# Leading key DESC: a descending. rank(2,15) ORDER BY a DESC, b = 3 (precede: (3,5),(2,10)).
query I
SELECT rank(2, 15) WITHIN GROUP (ORDER BY a DESC, b) FROM mk
----
3

# Both keys DESC. rank(2,15) ORDER BY a DESC, b DESC = 3.
query I
SELECT rank(2, 15) WITHIN GROUP (ORDER BY a DESC, b DESC) FROM mk
----
3

# Argument lands on an exact key tuple (2,20): rank counts only strictly-before = 4; dense_rank = 4;
# cume_dist counts the tie as <= : (5+1)/6 ... count(<=)=5 -> (5+1)/6 = 0.833.
query IIR
SELECT rank(2, 20) WITHIN GROUP (ORDER BY a, b),
       dense_rank(2, 20) WITHIN GROUP (ORDER BY a, b),
       cume_dist(2, 20) WITHIN GROUP (ORDER BY a, b)
FROM mk
----
4  4  0.833

# rank(2,10) ORDER BY a, b = 3 (precede: (1,10),(1,20)); dense_rank = 3; cume_dist = 0.667.
query IIR
SELECT rank(2, 10) WITHIN GROUP (ORDER BY a, b),
       dense_rank(2, 10) WITHIN GROUP (ORDER BY a, b),
       cume_dist(2, 10) WITHIN GROUP (ORDER BY a, b)
FROM mk
----
3  3  0.667

# Tuple below all: rank = 1. Tuple above all: rank = n + 1 = 6.
query II
SELECT rank(0, 0) WITHIN GROUP (ORDER BY a, b),
       rank(9, 9) WITHIN GROUP (ORDER BY a, b)
FROM mk
----
1  6

# --- Three ORDER BY keys ---
statement ok
CREATE TABLE mk3 (a INT, b INT, c INT)

statement ok
INSERT INTO mk3 VALUES (1, 1, 1), (1, 1, 2), (1, 2, 1), (2, 1, 1), (2, 2, 2)

# rank(1,2,1) ORDER BY a, b, c = 3 (precede: (1,1,1),(1,1,2)); dense_rank = 3;
# percent_rank = (3-1)/5 = 0.4; cume_dist = count(<=)=3 -> (3+1)... wait: count(<=)=3, (3+1)/(5+1)=0.667.
query IIRR
SELECT rank(1, 2, 1) WITHIN GROUP (ORDER BY a, b, c),
       dense_rank(1, 2, 1) WITHIN GROUP (ORDER BY a, b, c),
       percent_rank(1, 2, 1) WITHIN GROUP (ORDER BY a, b, c),
       cume_dist(1, 2, 1) WITHIN GROUP (ORDER BY a, b, c)
FROM mk3
----
3  3  0.400  0.667

# 3-key with a middle DESC key: rank(1,2,1) ORDER BY a, b DESC, c = 1 (nothing precedes).
query I
SELECT rank(1, 2, 1) WITHIN GROUP (ORDER BY a, b DESC, c) FROM mk3
----
1

# --- Grouped multi-key ---
statement ok
CREATE TABLE hg2 (g TEXT, a INT, b INT)

statement ok
INSERT INTO hg2 VALUES ('a', 1, 1), ('a', 1, 2), ('a', 2, 1), ('b', 5, 5), ('b', 5, 6)

# group 'a' (1,1),(1,2),(2,1): rank(1,2) = 2 (precede (1,1)); cume_dist = count(<=)=2 -> (2+1)/(3+1)=0.75.
# group 'b' (5,5),(5,6): rank(1,2) = 1; cume_dist = (0+1)/(2+1) = 0.333.
query TIR rowsort
SELECT g,
       rank(1, 2) WITHIN GROUP (ORDER BY a, b),
       cume_dist(1, 2) WITHIN GROUP (ORDER BY a, b)
FROM hg2 GROUP BY g
----
a  2  0.750
b  1  0.333

# --- Argument count must equal the ORDER BY key count (loud errors) ---
# Too few arguments (1 arg, 2 keys).
statement error
SELECT rank(2) WITHIN GROUP (ORDER BY a, b) FROM mk

# Too many arguments (3 args, 2 keys).
statement error
SELECT rank(2, 3, 4) WITHIN GROUP (ORDER BY a, b) FROM mk

# The single-key percentile / mode ordered-set aggregates stay single-key: a 2-key ORDER BY is a loud error.
statement error
SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY a, b) FROM mk

statement error
SELECT mode() WITHIN GROUP (ORDER BY a, b) FROM mk

# Single-key hypothetical-set aggregate still works after the multi-key generalization.
# a = 1,1,2,2,3 (n = 5): rank(2) = 1 + count(a < 2) = 3; cume_dist(2) = (count(a <= 2) + 1)/(5+1) = 5/6.
query IR
SELECT rank(2) WITHIN GROUP (ORDER BY a),
       cume_dist(2) WITHIN GROUP (ORDER BY a)
FROM mk
----
3  0.833

# Single-key percentile_cont / mode WITHIN GROUP still work.
query RI
SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY a),
       mode() WITHIN GROUP (ORDER BY a)
FROM mk
----
2.000  1

# --- NULL keys are kept in the ordered set and counted in n, placed by NULLS FIRST/LAST ---
# (matching the reference oracle, which does NOT exclude NULL-key rows from the hypothetical set).

# Single-key NULL placement. sk = 1,2,NULL,3,NULL (n = 5).
statement ok
CREATE TABLE sk (x INT)

statement ok
INSERT INTO sk VALUES (1), (2), (NULL), (3), (NULL)

# rank(2) ASC (default NULLS LAST): the 2 NULLs sort after 2 and do not precede -> 1 + count(x<2) = 2.
# ASC NULLS FIRST: both NULLs + value 1 precede -> 4.
# DESC (default NULLS FIRST): the 2 NULLs precede, plus value 3 -> 4.
# DESC NULLS LAST: NULLs sort last, only value 3 precedes -> 2.
query IIII
SELECT rank(2) WITHIN GROUP (ORDER BY x),
       rank(2) WITHIN GROUP (ORDER BY x ASC NULLS FIRST),
       rank(2) WITHIN GROUP (ORDER BY x DESC),
       rank(2) WITHIN GROUP (ORDER BY x DESC NULLS LAST)
FROM sk
----
2  4  4  2

# cume_dist(2) ASC = (count(x <= 2) = 2, + 1)/(n = 5 + 1) = 3/6 = 0.5.
# percentile_cont still EXCLUDES NULLs (n = 3 over 1,2,3): median = 2.
query RR
SELECT cume_dist(2) WITHIN GROUP (ORDER BY x),
       percentile_cont(0.5) WITHIN GROUP (ORDER BY x)
FROM sk
----
0.500  2.000

# Multi-key NULL on the second key. mkn = (1,10),(2,NULL),(2,20),(3,5), n = 4.
statement ok
CREATE TABLE mkn (a INT, b INT)

statement ok
INSERT INTO mkn VALUES (1, 10), (2, NULL), (2, 20), (3, 5)

# ORDER BY a, b (b default NULLS LAST): (2,NULL) sorts after (2,15) -> only (1,10) precedes -> rank 2;
# dense_rank = 2; cume_dist = (1+1)/(4+1) = 0.4.
query IIR
SELECT rank(2, 15) WITHIN GROUP (ORDER BY a, b),
       dense_rank(2, 15) WITHIN GROUP (ORDER BY a, b),
       cume_dist(2, 15) WITHIN GROUP (ORDER BY a, b)
FROM mkn
----
2  2  0.400

# ORDER BY a, b NULLS FIRST: (2,NULL) now precedes (2,15) -> (1,10),(2,NULL) precede -> rank 3;
# dense_rank = 3; cume_dist = (2+1)/(4+1) = 0.6.
query IIR
SELECT rank(2, 15) WITHIN GROUP (ORDER BY a, b NULLS FIRST),
       dense_rank(2, 15) WITHIN GROUP (ORDER BY a, b NULLS FIRST),
       cume_dist(2, 15) WITHIN GROUP (ORDER BY a, b NULLS FIRST)
FROM mkn
----
3  3  0.600
