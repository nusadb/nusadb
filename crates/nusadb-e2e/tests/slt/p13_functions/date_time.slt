# p13_functions/date_time — date/time built-ins (-52): EXTRACT, DATE_TRUNC,
# AGE, TO_CHAR, TO_DATE, TO_TIMESTAMP.
#
# All functions here are deterministic (no NOW/CURRENT_TIMESTAMP which
# vary per run).

statement ok
CREATE TABLE t (id INT NOT NULL, ts TIMESTAMP, d DATE, tz TIMESTAMPTZ)

statement ok
INSERT INTO t VALUES (1, '2024-06-15 14:30:45', '2024-06-15', '2024-06-15 14:30:45+00'),
                     (2, '2023-01-01 00:00:00', '2023-01-01', '2023-01-01 00:00:00+00')

# --- EXTRACT: year, month, day. EXTRACT yields an exact NUMERIC (whole fields at scale 0). ---
query IT
SELECT id, EXTRACT(YEAR FROM ts) FROM t ORDER BY id
----
1 2024
2 2023

query IT
SELECT id, EXTRACT(MONTH FROM ts) FROM t ORDER BY id
----
1 6
2 1

query IT
SELECT id, EXTRACT(DAY FROM ts) FROM t ORDER BY id
----
1 15
2 1

# --- EXTRACT: hour, minute, second. SECOND carries six fractional digits. ---
query T
SELECT EXTRACT(HOUR FROM TIMESTAMP '2024-06-15 14:30:45')
----
14

query T
SELECT EXTRACT(MINUTE FROM TIMESTAMP '2024-06-15 14:30:45')
----
30

query T
SELECT EXTRACT(SECOND FROM TIMESTAMP '2024-06-15 14:30:45')
----
45.000000

# --- EXTRACT: day of week (dow: Sunday=0..Saturday=6) ---
query T
SELECT EXTRACT(DOW FROM DATE '2024-06-15')
----
6

# --- EXTRACT: day of year (doy) ---
query T
SELECT EXTRACT(DOY FROM DATE '2024-06-15')
----
167

# --- EXTRACT: quarter ---
query T
SELECT EXTRACT(QUARTER FROM DATE '2024-06-15')
----
2

# --- EXTRACT: epoch (seconds since 1970-01-01), scale 6 ---
query T
SELECT EXTRACT(EPOCH FROM TIMESTAMP '1970-01-01 00:00:00')
----
0.000000

query T
SELECT EXTRACT(EPOCH FROM TIMESTAMP '1970-01-02 00:00:00')
----
86400.000000

# --- DATE_TRUNC: truncate to year, month, day ---
query T
SELECT DATE_TRUNC('year', TIMESTAMP '2024-06-15 14:30:45')
----
2024-01-01 00:00:00

query T
SELECT DATE_TRUNC('month', TIMESTAMP '2024-06-15 14:30:45')
----
2024-06-01 00:00:00

query T
SELECT DATE_TRUNC('day', TIMESTAMP '2024-06-15 14:30:45')
----
2024-06-15 00:00:00

# --- DATE_TRUNC: a DATE source widens to midnight in the time-zone-aware type ---
query T
SELECT DATE_TRUNC('month', DATE '2024-06-15')
----
2024-06-01 00:00:00+00

query T
SELECT DATE_TRUNC('day', DATE '2024-06-15')
----
2024-06-15 00:00:00+00

query T
SELECT DATE_TRUNC('hour', DATE '2024-06-15')
----
2024-06-15 00:00:00+00

# An explicit cast pins the naive form.
query T
SELECT DATE_TRUNC('month', CAST(DATE '2024-06-15' AS TIMESTAMP))
----
2024-06-01 00:00:00

# --- DATE_TRUNC: truncate to hour, minute ---
query T
SELECT DATE_TRUNC('hour', TIMESTAMP '2024-06-15 14:30:45')
----
2024-06-15 14:00:00

query T
SELECT DATE_TRUNC('minute', TIMESTAMP '2024-06-15 14:30:45')
----
2024-06-15 14:30:00

# --- AGE: difference between two timestamps ---
query T
SELECT AGE(TIMESTAMP '2024-06-15 00:00:00', TIMESTAMP '2023-01-01 00:00:00')
----
1 year 5 mons 14 days

# --- TO_CHAR: format a timestamp ---
query T
SELECT TO_CHAR(TIMESTAMP '2024-06-15 14:30:45', 'YYYY-MM-DD')
----
2024-06-15

query T
SELECT TO_CHAR(TIMESTAMP '2024-06-15 14:30:45', 'HH24:MI:SS')
----
14:30:45

query T
SELECT TO_CHAR(TIMESTAMP '2024-06-15 14:30:45', 'Mon DD, YYYY')
----
Jun 15, 2024

# The full month name (`Month`) is blank-padded to 9 characters (the width of "September"), like PG;
# the result below is `June` followed by five spaces. The abbreviation `Mon` is not padded.
query T
SELECT TO_CHAR(DATE '2024-06-15', 'Month') || '|'
----
June     |

# --- TO_CHAR: format a number through a digit picture (`9`/`0`/`.`/`D`, `,`/`G`, `FM`) ---
# Digits fit exactly; the fraction is rounded/padded to the picture; the sign is a leading column.
query T
SELECT TO_CHAR(1234.5, '9999.99')
----
 1234.50

# Leading `9` positions with no digit are suppressed to spaces (the sign column included).
query T
SELECT TO_CHAR(12, '9999.99')
----
   12.00

# A negative number floats the sign next to the first digit.
query T
SELECT TO_CHAR(-1234.5, '9999.99')
----
-1234.50

# A value below 1 suppresses the integer part; the sign floats to the decimal point.
query T
SELECT TO_CHAR(-0.1, '99.99')
----
  -.10

# `0` positions force a zero digit.
query T
SELECT TO_CHAR(12, '0000')
----
 0012

# A value wider than the integer positions renders as `#` fill.
query T
SELECT TO_CHAR(1234, '99')
----
 ##

# Exactly zero under a `9` picture suppresses the integer part (no printed `0`); a `0` picture shows it.
query T
SELECT TO_CHAR(0, '9999.99')
----
     .00

query T
SELECT TO_CHAR(0, '0000.00')
----
 0000.00

# `FM` (fill mode) drops the reserved padding, the sign column included when the sign is a space.
query T
SELECT TO_CHAR(5, 'FM999')
----
5

# A group separator prints only when a position to its left prints something, so a value that does
# not reach it leaves a blank rather than a stray comma.
query T
SELECT TO_CHAR(5, '9,999')
----
     5

query T
SELECT TO_CHAR(1234567.891, '9G999G999D99')
----
 1,234,567.89

# The anchored sign S prints an always-shown +/- (leading here, so before the digits).
query T
SELECT TO_CHAR(5, 'S999')
----
  +5

# An unsupported numeric format character is still rejected, not silently mis-formatted.
statement error
SELECT TO_CHAR(5, '999PR')

# --- TO_DATE: parse text to date ---
query T
SELECT TO_DATE('2024-06-15', 'YYYY-MM-DD')
----
2024-06-15

# --- TO_TIMESTAMP: parse text to timestamptz (the instant in the session zone, UTC here) ---
query T
SELECT TO_TIMESTAMP('2024-06-15 14:30:45', 'YYYY-MM-DD HH24:MI:SS')
----
2024-06-15 14:30:45+00

# --- TimestampTz variants ---
query T
SELECT DATE_TRUNC('month', TIMESTAMPTZ '2024-06-15 14:30:45+00')
----
2024-06-01 00:00:00+00

# --- DATE_PART (function-call spelling of EXTRACT) ---
query R
SELECT DATE_PART('year', DATE '2024-06-15')
----
2024.000

query R
SELECT DATE_PART('MONTH', TIMESTAMP '2024-06-15 14:30:45')
----
6.000

query R
SELECT DATE_PART('hour', TIMESTAMP '2024-06-15 14:30:45')
----
14.000

# --- MAKE_DATE ---
query T
SELECT MAKE_DATE(2024, 6, 15)
----
2024-06-15

query T
SELECT CAST(MAKE_DATE(1999, 12, 31) AS TEXT)
----
1999-12-31

# MAKE_DATE arithmetic round-trips through EXTRACT.
query T
SELECT EXTRACT(YEAR FROM MAKE_DATE(2030, 1, 1))
----
2030

# An impossible calendar day is rejected.
statement error
SELECT MAKE_DATE(2024, 2, 30)

# --- NULL propagation ---
query T
SELECT EXTRACT(YEAR FROM CAST(NULL AS TIMESTAMP))
----
NULL

query T
SELECT DATE_PART('year', CAST(NULL AS TIMESTAMP))
----
NULL

query T
SELECT MAKE_DATE(NULL, 1, 1)
----
NULL

query T
SELECT DATE_TRUNC('month', CAST(NULL AS TIMESTAMP))
----
NULL

query T
SELECT TO_CHAR(CAST(NULL AS TIMESTAMP), 'YYYY')
----
NULL

# --- MAKE_TIME / MAKE_TIMESTAMP ---
query T
SELECT MAKE_TIME(14, 30, 45)
----
14:30:45

query T
SELECT CAST(MAKE_TIME(0, 0, 0) AS TEXT)
----
00:00:00

query T
SELECT MAKE_TIMESTAMP(2024, 6, 15, 9, 5, 1)
----
2024-06-15 09:05:01

# EXTRACT round-trips a constructed timestamp.
query T
SELECT EXTRACT(HOUR FROM MAKE_TIMESTAMP(2024, 1, 1, 23, 0, 0))
----
23

# Out-of-range fields are rejected.
statement error
SELECT MAKE_TIME(25, 0, 0)

statement error
SELECT MAKE_TIMESTAMP(2024, 13, 1, 0, 0, 0)

# NULL propagation.
query T
SELECT MAKE_TIME(NULL, 0, 0)
----
NULL

# --- TIMESTAMP::DATE / ::TIME and DATE::TIMESTAMP casts (QA category-D) ---
query T
SELECT CAST(TIMESTAMP '2024-06-15 13:45:30' AS DATE)
----
2024-06-15

query T
SELECT CAST(TIMESTAMP '2024-06-15 13:45:30' AS TIME)
----
13:45:30

query T
SELECT CAST(DATE '2024-06-15' AS TIMESTAMP)
----
2024-06-15 00:00:00

# A pre-epoch timestamp floors to the correct day with a non-negative time-of-day.
query T
SELECT CAST(TIMESTAMP '1969-12-31 18:00:00' AS DATE)
----
1969-12-31

query T
SELECT CAST(TIMESTAMP '1969-12-31 18:00:00' AS TIME)
----
18:00:00

# --- timestamp - timestamp -> INTERVAL (whole days split out) ---
query T
SELECT TIMESTAMP '2024-06-15 12:00:00' - TIMESTAMP '2024-06-14 10:00:00'
----
1 day 02:00:00

# --- to_timestamp(epoch seconds) -> TIMESTAMPTZ ---
query T
SELECT TO_TIMESTAMP(0)
----
1970-01-01 00:00:00+00

query T
SELECT TO_TIMESTAMP(86400)
----
1970-01-02 00:00:00+00

# --- EXTRACT(WEEK) — ISO 8601 week number ---
query T
SELECT EXTRACT(WEEK FROM DATE '2024-06-15')
----
24

# 2021-01-01 (Friday) is ISO week 53 of the prior year.
query T
SELECT EXTRACT(WEEK FROM DATE '2021-01-01')
----
53

# --- EXTRACT(EPOCH FROM INTERVAL), scale 6 ---
query T
SELECT EXTRACT(EPOCH FROM INTERVAL '1 day 02:00:00')
----
93600.000000

query T
SELECT EXTRACT(DAY FROM INTERVAL '1 year 2 mons 10 days')
----
10

# --- TO_CHAR: extended template codes (quarter, weeks, century, Julian, ISO year, Roman month,
# seconds-past-midnight, comma year, era) — every expected value captured from the reference engine ---
query T
SELECT TO_CHAR(TIMESTAMP '2024-06-15 13:45:30', 'Q|WW|W|CC|J|IW|IYYY|IYY|IY|I')
----
2|24|3|21|2460477|24|2024|024|24|4

# Roman month is blank-padded to 4 (the width of "VIII"); the lowercase form matches case.
query T
SELECT TO_CHAR(TIMESTAMP '2024-06-15 13:45:30', 'RM') || '/' || TO_CHAR(TIMESTAMP '2024-06-15 13:45:30', 'rm')
----
VI  /vi  

# Seconds past midnight (SSSS/SSSSS, never zero-padded) and the comma year (Y,YYY).
query T
SELECT TO_CHAR(TIMESTAMP '2024-06-15 13:45:30', 'SSSS') || '|' || TO_CHAR(TIMESTAMP '2024-06-15 13:45:30', 'Y,YYY')
----
49530|2,024

# The era reflects the year (an AD date is "AD"/"A.D." regardless of the BC/AD template letters).
query T
SELECT TO_CHAR(DATE '2024-01-01', 'BC') || '|' || TO_CHAR(DATE '2024-01-01', 'A.D.')
----
AD|A.D.

# ISO year diverges from the Gregorian year at the boundary: 2023-01-01 is ISO week 52 of 2022.
query T
SELECT TO_CHAR(DATE '2023-01-01', 'IYYY-"W"IW')
----
2022-W52

# An unknown letter run still passes through verbatim, and RN/rn stay literal in a datetime template.
query T
SELECT TO_CHAR(DATE '2024-06-15', 'ZZZ') || '|' || TO_CHAR(DATE '2024-06-15', 'RN')
----
ZZZ|RN

# --- TO_CHAR: `th`/`TH` ordinal suffix on the preceding numeric field ---
query T
SELECT TO_CHAR(DATE '2024-01-21', 'DDth') || ' ' || TO_CHAR(DATE '2024-01-22', 'DDth') || ' ' || TO_CHAR(DATE '2024-01-23', 'DDth') || ' ' || TO_CHAR(DATE '2024-01-04', 'DDth')
----
21st 22nd 23rd 04th

# TH upper-cases the suffix; a th not adjacent to a number is a plain literal.
query T
SELECT TO_CHAR(DATE '2024-01-21', 'DDTH') || '|' || TO_CHAR(DATE '2024-01-21', 'DD th')
----
21ST|21 th

# EXTRACT extended calendar precisions. Reference-engine oracle for 2026-08-20 13:45:30.123456:
# century 21 (years 2001..2100), decade 202 (year/10), millennium 3, isoyear 2026, and the seconds
# field carried to microsecond (30123456) and millisecond (30123.456) resolution.
query TTTT
SELECT
  EXTRACT(CENTURY FROM TIMESTAMP '2026-08-20 13:45:30.123456'),
  EXTRACT(DECADE FROM TIMESTAMP '2026-08-20 13:45:30.123456'),
  EXTRACT(MILLENNIUM FROM TIMESTAMP '2026-08-20 13:45:30.123456'),
  EXTRACT(ISOYEAR FROM TIMESTAMP '2026-08-20 13:45:30.123456')
----
21 202 3 2026

query TT
SELECT
  EXTRACT(MICROSECONDS FROM TIMESTAMP '2026-08-20 13:45:30.123456'),
  EXTRACT(MILLISECONDS FROM TIMESTAMP '2026-08-20 13:45:30.123456')
----
30123456 30123.456

# Century numbering starts at year 1: 2000 is century 20, 2001 begins century 21.
query TT
SELECT
  EXTRACT(CENTURY FROM DATE '2000-06-01'),
  EXTRACT(CENTURY FROM DATE '2001-06-01')
----
20 21

# The Julian Date of a date is its whole Julian-day count (scale 0); a timestamp adds the day
# fraction (scale 20).
query TT
SELECT
  EXTRACT(JULIAN FROM DATE '2026-08-20'),
  EXTRACT(JULIAN FROM TIMESTAMP '2026-08-20 13:45:30.123456')
----
2461273 2461273.57326531777777777778

# ISOYEAR near a year boundary: 2027-01-01 (Friday) belongs to ISO year 2026.
query T
SELECT EXTRACT(ISOYEAR FROM DATE '2027-01-01')
----
2026

# DATE_TRUNC to the decade, century and millennium floors to the year that starts the period
# (year 2001 begins century 21 and millennium 3).
query TTT
SELECT
  DATE_TRUNC('decade', TIMESTAMP '2026-08-20 13:45:30'),
  DATE_TRUNC('century', TIMESTAMP '2026-08-20 13:45:30'),
  DATE_TRUNC('millennium', TIMESTAMP '2026-08-20 13:45:30')
----
2020-01-01 00:00:00 2001-01-01 00:00:00 2001-01-01 00:00:00

# EXTRACT of the extended precisions from an interval divides the year count down (no calendar
# origin): 25 years is decade 2, 250 years century 2.
query TTT
SELECT
  EXTRACT(DECADE FROM INTERVAL '25 years'),
  EXTRACT(CENTURY FROM INTERVAL '250 years'),
  EXTRACT(MILLENNIUM FROM INTERVAL '2500 years')
----
2 2 2

# --- EXTRACT on TIMETZ: local time-of-day fields, plus the zone fields ---
# The local time-of-day is read as entered (independent of the offset).
query TTT
SELECT
  EXTRACT(HOUR FROM TIMETZ '12:34:56.789+05:30'),
  EXTRACT(MINUTE FROM TIMETZ '12:34:56.789+05:30'),
  EXTRACT(SECOND FROM TIMETZ '12:34:56.789+05:30')
----
12 34 56.789000

# The zone fields: timezone is the offset in seconds, split into whole hours and minutes.
query TTT
SELECT
  EXTRACT(TIMEZONE FROM TIMETZ '12:34:56.789+05:30'),
  EXTRACT(TIMEZONE_HOUR FROM TIMETZ '12:34:56.789+05:30'),
  EXTRACT(TIMEZONE_MINUTE FROM TIMETZ '12:34:56.789+05:30')
----
19800 5 30

# A negative offset carries its sign into both the hour and minute fields.
query TT
SELECT
  EXTRACT(TIMEZONE_HOUR FROM TIMETZ '12:00-08:00'),
  EXTRACT(TIMEZONE_MINUTE FROM TIMETZ '12:00-05:30')
----
-8 -30

# epoch of a timetz is the UTC-equivalent seconds-of-day (local minus offset), scale 6.
query T
SELECT EXTRACT(EPOCH FROM TIMETZ '12:34:56.789+05:30')
----
25496.789000

# --- EXTRACT zone fields on TIMESTAMPTZ: the session zone is UTC, so the offset is zero ---
query TTT
SELECT
  EXTRACT(TIMEZONE FROM TIMESTAMPTZ '2024-06-15 12:00:00+00'),
  EXTRACT(TIMEZONE_HOUR FROM TIMESTAMPTZ '2024-06-15 12:00:00+00'),
  EXTRACT(TIMEZONE_MINUTE FROM TIMESTAMPTZ '2024-06-15 12:00:00+00')
----
0 0 0

# --- EXTRACT microseconds/milliseconds from TIME and TIMETZ: the sub-minute seconds carried down ---
query TT
SELECT
  EXTRACT(MICROSECONDS FROM TIME '12:34:56.789012'),
  EXTRACT(MILLISECONDS FROM TIME '12:34:56.789012')
----
56789012 56789.012

query T
SELECT EXTRACT(MICROSECONDS FROM TIMETZ '12:34:56.789012+05')
----
56789012

# --- transaction_timestamp() is a synonym for now() (both are the transaction start time) ---
query I
SELECT TRANSACTION_TIMESTAMP() = NOW()
----
1
